package pages

import (
	"fmt"

	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/internal/uploads"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/icons"
	"github.com/tuxedocurly/wledger/web/layouts"
)

// UploadMaintenance lists upload files that no database row references and lets
// an administrator remove them. Detection is read-only; deletion is explicit,
// re-validated server-side and recorded in the audit log.
templ UploadMaintenance(user auth.User, report uploads.Report, deleted int, notice string) {
	@layouts.Base(i18n.T(ctx, "UploadMaintenance"), user) {
		<div class="max-w-5xl mx-auto w-full px-4">
			@components.PageHeader(i18n.T(ctx, "UploadMaintenance"), i18n.T(ctx, "UploadMaintenanceDescription"), []components.Breadcrumb{{Label: i18n.T(ctx, "Settings"), URL: "/settings"}, {Label: i18n.T(ctx, "UploadMaintenance")}})
			if notice != "" {
				<div role="status" class="alert alert-success mb-6"><span>{ notice }</span></div>
			}
			<div class="card bg-base-200 shadow-xl border border-base-300">
				<div class="card-body">
					<div class="flex flex-wrap items-center gap-4">
						<div class="stat bg-base-100 rounded-lg border border-base-300 flex-1 min-w-40">
							<div class="stat-title">{ i18n.T(ctx, "ReferencedUploads") }</div>
							<div class="stat-value text-2xl">{ fmt.Sprintf("%d", report.Referenced) }</div>
						</div>
						<div class="stat bg-base-100 rounded-lg border border-base-300 flex-1 min-w-40">
							<div class="stat-title">{ i18n.T(ctx, "OrphanedUploads") }</div>
							<div class="stat-value text-2xl">{ fmt.Sprintf("%d", len(report.Orphans)) }</div>
						</div>
					</div>
					if len(report.Orphans) == 0 {
						<div class="alert mt-6"><span>{ i18n.T(ctx, "NoOrphanedUploads") }</span></div>
					} else {
						<div class="alert alert-warning mt-6 text-sm"><span>{ i18n.T(ctx, "OrphanedUploadsWarning") }</span></div>
						<div class="overflow-x-auto mt-4">
							<table class="table table-zebra w-full">
								<thead>
									<tr class="bg-base-100">
										<th>{ i18n.T(ctx, "File") }</th>
										<th class="text-right">{ i18n.T(ctx, "Size") }</th>
									</tr>
								</thead>
								<tbody>
									for _, orphan := range report.Orphans {
										<tr>
											<td class="font-mono text-xs break-all">{ orphan.RelPath }</td>
											<td class="text-right text-xs">{ humanSize(orphan.Size) }</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
						<form method="POST" action="/settings/uploads/delete" class="card-actions justify-end mt-6">
							@components.CSRFInput()
							<button type="submit" class="btn btn-error gap-2">
								@icons.Trash(templ.Attributes{"class": "w-5 h-5"})
								{ i18n.T(ctx, "DeleteOrphanedUploads") }
							</button>
						</form>
					}
					<div class="card-actions justify-start mt-4">
						<a href="/settings" class="btn btn-ghost">{ i18n.T(ctx, "BackToSettings") }</a>
					</div>
				</div>
			</div>
		</div>
	}
}

func humanSize(bytes int64) string {
	const unit = 1024
	if bytes < unit {
		return fmt.Sprintf("%d B", bytes)
	}
	div, exp := int64(unit), 0
	for n := bytes / unit; n >= unit; n /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %cB", float64(bytes)/float64(div), "KMGTPE"[exp])
}
