package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ PartEdit(user auth.User, part db.Part, tags []db.Tag, allTags []db.Tag, links []db.PartLink, docs []db.PartDoc) {
	@layouts.Base("Edit Part", user) {
		<div class="max-w-4xl mx-auto w-full">
			@components.PageHeader(
				part.Name,
				"",
				[]components.Breadcrumb{
					{Label: "Inventory", URL: "/parts"},
					{Label: part.Name, URL: fmt.Sprintf("/parts/%d", part.ID)},
					{Label: "Edit"},
				},
			)
			@components.PartForm(part, tags, allTags, links, docs, fmt.Sprintf("/parts/%d/update", part.ID), true)
		</div>
	}
}
