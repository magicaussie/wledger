package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ PartEdit(user auth.User, p db.Part) {
	@layouts.Base(fmt.Sprintf("Edit %s", p.Name), user) {
		<div class="max-w-4xl mx-auto w-full">
			<div class="text-sm breadcrumbs mb-4 opacity-70">
				<ul>
					<li><a href="/parts">Inventory</a></li>
					<li><a href={ templ.SafeURL(fmt.Sprintf("/parts/%d", p.ID)) }>{ p.Name }</a></li>
					<li class="font-bold">Edit</li>
				</ul>
			</div>
			<div class="card bg-base-200 shadow-xl border border-base-300">
				<div class="card-body p-6 md:p-8">
					<div class="flex items-center justify-between mb-6 pb-4 border-b border-base-content/10">
						<div>
							<h1 class="text-2xl font-bold">Edit Part</h1>
							<p class="text-sm opacity-60">Update details for { p.Name }</p>
						</div>
						<form action={ templ.SafeURL(fmt.Sprintf("/parts/%d/delete", p.ID)) } method="POST" hx-boost="false">
							<button
								class="btn btn-sm btn-outline btn-error gap-2"
								onclick="return confirm('Are you sure? This cannot be undone.')"
							>
								<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
								Delete Part
							</button>
						</form>
					</div>
					<form action={ templ.SafeURL(fmt.Sprintf("/parts/%d/edit", p.ID)) } method="POST" enctype="multipart/form-data" class="space-y-8" hx-boost="false">
						<input type="hidden" name="id" value={ fmt.Sprintf("%d", p.ID) }/>
						<div class="space-y-4">
							<h3 class="font-bold text-sm uppercase tracking-wider opacity-50 flex items-center gap-2">Core Details</h3>
							<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
								<div class="form-control w-full">
									<label class="label"><span class="label-text font-medium">Part Name</span></label>
									<input type="text" name="name" value={ p.Name } class="input input-bordered w-full" required/>
								</div>
								<div class="form-control w-full">
									<label class="label"><span class="label-text font-medium">Part Number</span></label>
									<input type="text" name="part_number" value={ p.PartNumber.String } class="input input-bordered w-full font-mono text-sm"/>
								</div>
							</div>
							<div class="form-control w-full">
								<label class="label"><span class="label-text font-medium">Description</span></label>
								<textarea name="description" class="textarea textarea-bordered h-24 w-full">{ p.Description.String }</textarea>
							</div>
						</div>
						<div class="space-y-4">
							<h3 class="font-bold text-sm uppercase tracking-wider opacity-50 flex items-center gap-2 border-t border-base-content/5 pt-6">Visuals</h3>
							<div class="flex gap-6 items-start">
								if p.ImagePath.Valid && p.ImagePath.String != "" {
									<div class="avatar">
										<div class="w-24 rounded border border-base-content/20">
											<img src={ "/uploads/" + p.ImagePath.String }/>
										</div>
									</div>
								}
								<div class="form-control w-full">
									<label class="label"><span class="label-text font-medium">Update Image</span></label>
									<input type="file" name="image" class="file-input file-input-bordered w-full" accept="image/png, image/jpeg"/>
								</div>
							</div>
						</div>
						<div class="space-y-4">
							<h3 class="font-bold text-sm uppercase tracking-wider opacity-50 flex items-center gap-2 border-t border-base-content/5 pt-6">Stock Logic</h3>
							<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
								<div class="form-control w-full">
									<label class="label"><span class="label-text font-medium">Unit Cost ($)</span></label>
									<input type="number" name="unit_cost" step="0.01" value={ fmt.Sprintf("%.2f", p.UnitCost.Float64) } class="input input-bordered w-full font-mono"/>
								</div>
								<div class="form-control w-full">
									<label class="label"><span class="label-text font-medium">Min. Stock</span></label>
									<input type="number" name="min_stock" value={ fmt.Sprintf("%d", p.MinStockThreshold.Int64) } class="input input-bordered w-full font-mono"/>
								</div>
								<div class="form-control w-full">
									<label class="label"><span class="label-text font-medium">Reorder Level</span></label>
									<input type="number" name="reorder_level" value={ fmt.Sprintf("%d", p.ReorderLevel.Int64) } class="input input-bordered w-full font-mono"/>
								</div>
							</div>
						</div>
						<div class="card-actions justify-end mt-8 pt-6 border-t border-base-content/10 gap-3">
							<a href={ templ.SafeURL(fmt.Sprintf("/parts/%d", p.ID)) } class="btn btn-ghost">Cancel</a>
							<button class="btn btn-primary px-8">Save Changes</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}
