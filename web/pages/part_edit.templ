package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ PartEdit(p db.Part) {
	@layouts.Base("Edit Part") {
		<div class="max-w-2xl mx-auto">
			<div class="mb-6">
				<a href={ templ.SafeURL(fmt.Sprintf("/parts/%d", p.ID)) } class="btn btn-sm btn-ghost gap-2 pl-0">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
					Back to Detail
				</a>
				<h1 class="text-3xl font-bold mt-2">Edit { p.Name }</h1>
			</div>

			<div class="card bg-base-200 shadow-xl">
				<div class="card-body">
					<form action={ templ.SafeURL(fmt.Sprintf("/parts/%d/edit", p.ID)) } method="POST" enctype="multipart/form-data" class="space-y-4" hx-boost="false">
						
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div class="form-control w-full">
								<label class="label"><span class="label-text">Part Name *</span></label>
								<input type="text" name="name" value={ p.Name } class="input input-bordered w-full" required />
							</div>
							<div class="form-control w-full">
								<label class="label"><span class="label-text">Part Number</span></label>
								<input type="text" name="part_number" value={ p.PartNumber.String } class="input input-bordered w-full" />
							</div>
						</div>

						<div class="form-control w-full">
							<label class="label"><span class="label-text">Description</span></label>
							<textarea name="description" class="textarea textarea-bordered h-24">{ p.Description.String }</textarea>
						</div>

						<div class="form-control w-full">
							<label class="label"><span class="label-text">Image</span></label>
							<div class="flex items-center gap-4 mb-2">
								if p.ImagePath.Valid && p.ImagePath.String != "" {
									<div class="avatar">
										<div class="w-16 rounded">
											<img src={ "/uploads/" + p.ImagePath.String } />
										</div>
									</div>
									<div class="text-xs opacity-50">Current Image</div>
								} else {
									<div class="text-xs opacity-50">No image uploaded</div>
								}
							</div>
							<input type="file" name="image" class="file-input file-input-bordered w-full" accept="image/png, image/jpeg" />
							<label class="label"><span class="label-text-alt opacity-50">Leave blank to keep current image</span></label>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-3 gap-4 border-t border-base-300 pt-4 mt-4">
							<div class="form-control w-full">
								<label class="label"><span class="label-text">Unit Cost ($)</span></label>
								<input type="number" name="unit_cost" value={ fmt.Sprintf("%.2f", p.UnitCost.Float64) } step="0.01" class="input input-bordered w-full" />
							</div>
							<div class="form-control w-full">
								<label class="label"><span class="label-text">Min. Stock</span></label>
								<input type="number" name="min_stock" value={ fmt.Sprintf("%d", p.MinStockThreshold.Int64) } class="input input-bordered w-full" />
							</div>
							<div class="form-control w-full">
								<label class="label"><span class="label-text">Reorder Level</span></label>
								<input type="number" name="reorder_level" value={ fmt.Sprintf("%d", p.ReorderLevel.Int64) } class="input input-bordered w-full" />
							</div>
						</div>

                        <div class="form-control w-full">
                            <label class="label"><span class="label-text">Barcode Data</span></label>
                            <input type="text" name="barcode_data" value={ p.BarcodeData.String } class="input input-bordered w-full font-mono" placeholder="Scanned code..." />
                        </div>

						<div class="card-actions justify-end mt-6 gap-2">
                            <a href={ templ.SafeURL(fmt.Sprintf("/parts/%d", p.ID)) } class="btn btn-ghost">Cancel</a>
							<button class="btn btn-primary px-8">Save Changes</button>
						</div>
					</form>
				</div>
			</div>
		</div>
	}
}