package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/csrf"
	"github.com/tuxedocurly/wledger/internal/storage"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ StorageLayoutEditor(layout storage.CabinetLayout, user auth.User) {
	@layouts.Base("Cabinet designer", user) {
		@templ.JSONScript("layout-editor-data", layout)
		<div class="max-w-[1800px] mx-auto w-full" x-data="physicalLayoutEditor()" x-init="init()" x-on:keydown.window="onKeydown($event)">
			@components.PageHeader("Cabinet setup", "Configure ordered controllers, physical strings and wiring paths, then edit independent drawer geometry and cabinet-wide LED assignments. Settings never write to WLED.", []components.Breadcrumb{{Label: "Physical storage", URL: "/storage/cabinets"}, {Label: layout.Cabinet.Name, URL: fmt.Sprintf("/storage/cabinets/%d", layout.Cabinet.ID)}, {Label: "Designer"}})
			<form method="POST" action={templ.SafeURL(fmt.Sprintf("/storage/cabinets/%d/edit", layout.Cabinet.ID))} x-on:submit="prepare($event)" class="space-y-3">
				<input type="hidden" name="csrf_token" value={csrf.TokenFromContext(ctx)} x-ref="csrf"/>
				<input type="hidden" name="layout" x-ref="layout"/>
				<div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-base-300 bg-base-200 p-3">
					<div class="flex flex-wrap gap-2 items-center">
						<strong class="mr-2" x-text="mode === 'bins' ? activeDrawer()?.label : state.name"></strong>
						<button type="button" class="btn btn-sm btn-ghost" x-on:click="undo()" x-bind:disabled="!undoStack.length" aria-label="Undo">↶ Undo</button>
						<button type="button" class="btn btn-sm btn-ghost" x-on:click="redo()" x-bind:disabled="!redoStack.length" aria-label="Redo">↷ Redo</button>
						<span class="badge" x-show="dirty">Unsaved changes</span>
					</div>
					<div class="flex flex-wrap gap-2">
						<a class="btn btn-sm btn-ghost" href={templ.SafeURL(fmt.Sprintf("/storage/cabinets/%d", layout.Cabinet.ID))}>Cancel</a>
						<button type="submit" class="btn btn-primary btn-sm">Save layout</button>
					</div>
				</div>
				<div class="grid grid-cols-1 xl:grid-cols-[190px_minmax(0,1fr)_300px] gap-3 items-start">
					<aside class="card bg-base-200 border border-base-300 shadow-md">
						<div class="card-body p-3 space-y-4">
							<section x-show="mode === 'cabinet'">
								<h2 class="font-bold text-sm mb-2">Drawing tools</h2>
								<div class="grid grid-cols-2 xl:grid-cols-1 gap-2">
									<button type="button" class="btn btn-sm justify-start" x-bind:class="tool === 'select' ? 'btn-primary' : 'btn-outline'" x-on:click="setTool('select')">Select</button>
									<button type="button" class="btn btn-sm justify-start" x-bind:class="tool === 'drawer' ? 'btn-primary' : 'btn-outline'" x-on:click="setTool('drawer')">Drawer</button>
									<button type="button" class="btn btn-sm justify-start" x-bind:class="tool === 'outline' ? 'btn-primary' : 'btn-outline'" x-on:click="setTool('outline')">Dummy outline</button>
									<button type="button" class="btn btn-sm justify-start" x-bind:class="tool === 'rectangle' ? 'btn-primary' : 'btn-outline'" x-on:click="setTool('rectangle')">Rectangle</button>
									<button type="button" class="btn btn-sm justify-start" x-bind:class="tool === 'line' ? 'btn-primary' : 'btn-outline'" x-on:click="setTool('line')">Line</button>
									<button type="button" class="btn btn-sm justify-start" x-bind:class="tool === 'label' ? 'btn-primary' : 'btn-outline'" x-on:click="setTool('label')">Label</button>
									<button type="button" class="btn btn-sm justify-start" x-bind:class="tool === 'pan' ? 'btn-primary' : 'btn-outline'" x-on:click="setTool('pan')">Pan</button>
								</div>
								<p class="text-xs opacity-70 mt-2">Drag on the canvas to draw. Drag a shape to move it; use corner handles to resize.</p>
							</section>
							<section x-show="mode === 'wiring'" class="rounded border border-secondary/40 p-2 space-y-2">
								<h2 class="font-bold text-sm">Wiring path drawing</h2>
								<p class="text-xs">Click ordered path points on the cabinet canvas. Double-click to finish the current section.</p>
								<button type="button" class="btn btn-sm btn-secondary w-full" x-on:click="finishPathSection()">Finish path section</button>
								<button type="button" class="btn btn-sm btn-ghost w-full" x-on:click="mode='cabinet';tool='select';activePathSectionKey='';renderCanvas()">Cancel path drawing</button>
							</section>
							<section x-show="mode === 'bins'">
								<div class="flex justify-between items-center mb-2"><h2 class="font-bold text-sm">Drawer bins</h2><button type="button" class="btn btn-xs btn-ghost" x-on:click="closeDrawer()">Back</button></div>
								<div class="grid grid-cols-2 gap-2">
									<button type="button" class="btn btn-sm" x-bind:class="tool === 'select' ? 'btn-primary' : 'btn-outline'" x-on:click="setTool('select')">Select</button>
									<button type="button" class="btn btn-sm" x-bind:class="tool === 'bin' ? 'btn-primary' : 'btn-outline'" x-on:click="setTool('bin')" x-bind:disabled="!selectedAvailableBin">Draw bin</button>
								</div>
								<label class="form-control mt-3"><span class="label-text text-xs">Existing unattached inventory bin</span><select class="select select-bordered select-sm" x-model="selectedAvailableBin"><option value="">Choose bin to place</option><template x-for="bin in availableBins()" :key="bin.id"><option x-bind:value="bin.id" x-text="bin.name + ' (#' + bin.id + ')'"></option></template></select></label>
								<p class="text-xs opacity-70 mt-2">Drawing a bin places only the explicitly selected existing inventory bin.</p>
							</section>
							<section class="border-t border-base-300 pt-3 space-y-2">
								<h2 class="font-bold text-sm">Canvas</h2>
								<label class="form-control"><span class="label-text text-xs">Grid spacing</span><input type="number" min="0.1" step="any" class="input input-bordered input-sm" x-model.number="gridSize" x-on:change="gridSize = Math.max(0.1, gridSize)"/></label>
								<label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" x-model="snap"/><span class="label-text text-sm">Snap to grid</span></label>
								<label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" x-model="showGrid"/><span class="label-text text-sm">Show grid</span></label>
								<div class="join w-full"><button type="button" class="btn btn-sm join-item flex-1" x-on:click="zoomBy(0.8)" aria-label="Zoom out">−</button><button type="button" class="btn btn-sm join-item flex-1" x-on:click="resetView()">Reset</button><button type="button" class="btn btn-sm join-item flex-1" x-on:click="zoomBy(1.25)" aria-label="Zoom in">+</button></div>
								<p class="text-xs text-center opacity-70" x-text="Math.round(zoom * 100) + '% zoom' "></p>
							</section>
							<section class="border-t border-base-300 pt-3" x-show="mode === 'cabinet'">
								<h2 class="font-bold text-sm mb-2">Drawers</h2>
								<div class="space-y-1 max-h-48 overflow-auto"><template x-for="(drawer,index) in state.drawers" :key="drawer.key"><button type="button" class="btn btn-sm btn-ghost justify-start w-full truncate" x-bind:class="state.uiSelectionKind === 'drawer' && state.uiSelectionKey === drawer.key ? 'btn-active' : ''" x-on:click="selectDrawer(drawer)" x-on:dblclick="openDrawer(drawer)" x-text="(index + 1) + '. ' + drawer.label"></button></template></div>
								<button type="button" class="btn btn-sm btn-outline w-full mt-2" x-on:click="addDrawerFromButton()">＋ Add drawer</button>
							</section>
						</div>
					</aside>

					<section class="card bg-base-200 border border-base-300 shadow-md min-w-0">
						<div class="card-body p-3">
							<div class="flex flex-wrap justify-between items-center gap-2"><div><h2 class="font-bold" x-text="mode === 'wiring' ? 'Wiring and drawer canvas' : (mode === 'cabinet' ? 'Cabinet canvas' : 'Bin layout canvas')"></h2><p class="text-xs opacity-70" x-text="mode === 'wiring' ? 'String paths share cabinet coordinates with the independent physical drawer layout.' : 'Double-click a drawer to edit its bins.'"></p></div><span class="badge badge-outline" x-text="mode === 'bins' ? activeDrawer()?.width + ' × ' + activeDrawer()?.height : state.width + ' × ' + state.height"></span></div>
							<div class="w-full overflow-auto rounded-lg border border-base-300 bg-base-100 mt-2">
								<svg x-ref="canvas" class="block w-full min-h-[420px] max-h-[75vh] touch-none select-none" role="application" aria-label="Interactive physical layout canvas" tabindex="0" preserveAspectRatio="xMidYMid meet" x-on:pointerdown="canvasPointerDown($event)" x-on:pointermove="canvasPointerMove($event)" x-on:pointerup="canvasPointerUp($event)" x-on:pointercancel="cancelPointer()" x-on:wheel.prevent="wheelZoom($event)" x-on:click.self="canvasClick($event)" x-on:dblclick="finishPathSection()">
									<defs><pattern id="layout-grid" x-bind:width="gridSize" x-bind:height="gridSize" patternUnits="userSpaceOnUse"><path x-bind:d="'M ' + gridSize + ' 0 L 0 0 0 ' + gridSize" fill="none" stroke="currentColor" stroke-opacity="0.16" stroke-width="0.12"/></pattern></defs>
																		<rect x="-100000" y="-100000" width="200000" height="200000" fill="var(--color-base-100)"/>
																		<rect x="0" y="0" x-bind:width="canvasWidth()" x-bind:height="canvasHeight()" x-bind:fill="showGrid ? 'url(#layout-grid)' : 'var(--color-base-100)'" stroke="var(--color-base-content)" stroke-opacity="0.5" stroke-width="0.3"/>
																		<g x-ref="decorLayer"></g><g x-ref="drawerLayer"></g><g x-ref="binLayer"></g><g x-ref="previewLayer"></g>
								</svg>
							</div>
							<p class="text-xs opacity-70 mt-2" x-show="mode !== 'bins'">Drawer rectangles and ordered LED string paths share cabinet coordinates but are saved independently. Moving a drawer never changes its cabinet-wide pixel assignment.</p>
						</div>
					</section>

					<aside class="card bg-base-200 border border-base-300 shadow-md">
						<div class="card-body p-4 space-y-3">
							<h2 class="font-bold">Properties</h2>
							<section class="space-y-3" x-show="state.uiSelectionKind === 'drawer'">
								<label class="form-control"><span class="label-text text-xs">Drawer label</span><input class="input input-bordered input-sm" x-model="selectedDrawer().label" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label>
								<div class="grid grid-cols-2 gap-2"><label class="form-control"><span class="label-text text-xs">Order</span><input class="input input-bordered input-sm" type="number" x-model.number="selectedDrawer().display_order" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Width</span><input class="input input-bordered input-sm" type="number" min="0.1" step="any" x-model.number="selectedDrawer().width" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">X</span><input class="input input-bordered input-sm" type="number" min="0" step="any" x-model.number="selectedDrawer().x" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Y</span><input class="input input-bordered input-sm" type="number" min="0" step="any" x-model.number="selectedDrawer().y" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Height</span><input class="input input-bordered input-sm" type="number" min="0.1" step="any" x-model.number="selectedDrawer().height" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label></div>
								<div class="rounded border border-info/50 bg-info/10 p-3 space-y-3">
									<h3 class="font-bold text-sm">Drawer LED assignment</h3>
									<p class="text-xs">Enter cabinet-wide 1-based pixels. Drawer numbers and physical positions do not determine wiring order. A range may cross strings and controllers; WLEDger calculates each controller-local span.</p>
									<p class="text-xs font-mono" x-text="controllerSummary()"></p>
									<template x-if="ledRangesFor(selectedDrawer()).length">
										<div class="rounded border border-base-300 p-2 space-y-2">
											<div class="grid grid-cols-3 gap-2">
												<label class="form-control"><span class="label-text text-xs">Cabinet pixel Start</span><input class="input input-bordered input-sm" type="number" min="1" step="1" x-model="ledRangesFor(selectedDrawer())[0].start_pixel" x-bind:disabled="!selectedDrawer().id"/></label>
												<label class="form-control"><span class="label-text text-xs">Pixel Count</span><input class="input input-bordered input-sm" type="number" min="1" step="1" x-model="ledRangesFor(selectedDrawer())[0].pixel_count" x-bind:disabled="!selectedDrawer().id"/></label>
												<div class="form-control"><span class="label-text text-xs">Calculated End</span><output class="input input-bordered input-sm" x-text="ledEnd(ledRangesFor(selectedDrawer())[0])"></output></div>
											</div>
											<p class="text-[11px]" x-text="allocationDestinations(ledRangesFor(selectedDrawer())[0]).join(' → ') || 'Controller/string destinations appear after a valid start and count are entered.'"></p>
										</div>
									</template>
									<details class="rounded border border-base-300 p-2" x-show="ledRangesFor(selectedDrawer()).length > 1 || selectedDrawer()?.id">
										<summary class="cursor-pointer text-xs font-semibold">Advanced: additional non-contiguous ranges</summary>
										<div class="mt-2 space-y-2">
											<template x-for="(range,index) in ledRangesFor(selectedDrawer()).slice(1)" :key="range.id || ('additional-' + index)">
												<div class="rounded border border-base-300 p-2 space-y-2">
													<div class="flex items-center justify-between"><strong class="text-xs" x-text="'Additional range ' + (index + 2)"></strong><button type="button" class="btn btn-xs btn-ghost text-error" x-on:click="removeLedRange(selectedDrawer(), index + 1)">Remove</button></div>
													<div class="grid grid-cols-3 gap-2"><label class="form-control"><span class="label-text text-xs">Start</span><input class="input input-bordered input-sm" type="number" min="1" step="1" x-model="range.start_pixel"/></label><label class="form-control"><span class="label-text text-xs">Count</span><input class="input input-bordered input-sm" type="number" min="1" step="1" x-model="range.pixel_count"/></label><div class="form-control"><span class="label-text text-xs">End</span><output class="input input-bordered input-sm" x-text="ledEnd(range)"></output></div></div>
													<p class="text-[11px]" x-text="allocationDestinations(range).join(' → ')"></p>
												</div>
												</template>
											<button type="button" class="btn btn-xs btn-outline" x-on:click="addLedRange(selectedDrawer())" x-bind:disabled="!selectedDrawer().id">＋ Add another range</button>
										</div>
									</details>
									<div class="flex flex-wrap gap-2"><button type="button" class="btn btn-sm btn-primary" x-on:click="saveLedAllocations(selectedDrawer())" x-bind:disabled="!selectedDrawer().id">Save drawer pixels</button></div>
									<p class="text-xs text-info" x-show="!selectedDrawer().id">Save the drawer layout first to assign its stable physical drawer ID.</p>
									<p class="text-xs" x-text="ledStatus(selectedDrawer()).error || ledStatus(selectedDrawer()).message" x-bind:class="ledStatus(selectedDrawer()).error ? 'text-error font-semibold' : 'opacity-80'"></p>
									<p class="text-xs text-success" role="status" x-show="ledSaveNotice" x-text="ledSaveNotice"></p>
									<p class="text-xs text-error" role="alert" x-show="ledSaveError" x-text="ledSaveError"></p>
									<p class="text-xs text-warning" role="status" x-show="legacyLedDraftNotice" x-text="legacyLedDraftNotice"></p>
								</div>
								if user.IsAdmin() {
									<details class="rounded border border-base-300 bg-base-300/30 p-2 space-y-2">
										<summary class="cursor-pointer text-xs font-semibold">Advanced hardware diagnostics (read-only)</summary>
										<label class="form-control mt-2"><span class="label-text text-xs">Controller to inspect</span><select class="select select-bordered select-xs" x-model.number="diagnosticControllerID" x-on:change="physicalOutputLayout=null;outputDiscoveryError=''" ><template x-for="assigned in assignedControllers" :key="'diag-' + assigned.Controller.id"><option x-bind:value="assigned.Controller.id" x-text="assigned.Controller.name + ' (#' + assigned.Controller.id + ')' "></option></template></select></label>
										<button type="button" class="btn btn-xs btn-outline mt-2" x-on:click="discoverPhysicalOutputs(diagnosticControllerID)">Read WLED output topology</button>
										<p class="text-xs text-error" role="alert" x-show="outputDiscoveryError" x-text="outputDiscoveryError"></p>
										<template x-if="physicalOutputLayout && Number(diagnosticControllerID) === physicalOutputLayout.controller_id">
											<div class="space-y-2 mt-2" aria-label="Read-only WLED output map">
												<div class="relative flex h-12 w-full overflow-hidden rounded border border-base-content/30 bg-base-100"><template x-for="output in physicalOutputLayout.outputs" :key="output.order"><div class="relative flex h-full min-w-0 items-center justify-center border-r border-base-content/40 bg-info/20 text-[9px]" x-bind:style="'flex-basis:' + (output.length / physicalOutputLayout.capacity * 100) + '%'" ><span class="truncate text-center" x-text="'Output ' + (output.order + 1) + ' · ' + output.first_index + '–' + output.last_index"></span><template x-for="mark in outputAllocationMarkers(output, selectedDrawer())" :key="mark.key"><span class="absolute inset-y-0 bg-primary/60 ring-1 ring-primary" x-bind:style="'left:' + mark.left + '%;width:' + mark.width + '%'" x-bind:title="'Selected drawer cabinet range mapped to local pixels ' + mark.start + '–' + mark.end"></span></template></div></template></div>
												<p class="text-[10px]" x-text="'WLED physical outputs on controller #' + physicalOutputLayout.controller_id + ', local pixels 1–' + physicalOutputLayout.capacity + '. Outputs, physical strings and WLED segments are distinct.'"></p>
												<div class="space-y-1"><template x-for="output in physicalOutputLayout.outputs" :key="'diag-details-' + output.order"><p class="text-[10px] font-mono" x-text="'Output ' + (output.order + 1) + ': WLED start ' + output.start + ', length ' + output.length + ', GPIO ' + output.pins.join(', ') + ', local pixels ' + output.first_index + '–' + output.last_index"></p></template></div>
											</div>
										</template>
									</details>
								}
								<div class="rounded bg-base-300/50 p-2 text-xs"><strong>Coordinate boundary</strong><p class="mt-1">Drawer records store cabinet-wide logical pixels. WLEDger translates to controller-local indices and verified WLED segment-relative commands only during Locate. Legacy containers, segment IDs and bin LED indices remain separate.</p></div>
								<div class="flex flex-wrap gap-2"><button type="button" class="btn btn-sm btn-outline" x-on:click="openDrawer(selectedDrawer())">Open bin layout</button><button type="button" class="btn btn-sm btn-warning btn-outline" x-on:click="archiveDrawer()" x-show="selectedDrawer()?.id">Archive</button><button type="button" class="btn btn-sm btn-error btn-outline" x-on:click="deleteSelectedDrawer()">Delete</button></div>
							</section>
							<section class="space-y-3" x-show="state.uiSelectionKind === 'bin'">
								<h3 class="font-semibold" x-text="selectedBin()?.name || ('Bin #' + selectedBin()?.id)"></h3>
								<div class="grid grid-cols-2 gap-2"><label class="form-control"><span class="label-text text-xs">Order</span><input class="input input-bordered input-sm" type="number" x-model.number="selectedBin().display_order" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">X</span><input class="input input-bordered input-sm" type="number" min="0" step="any" x-model.number="selectedBin().x" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Y</span><input class="input input-bordered input-sm" type="number" min="0" step="any" x-model.number="selectedBin().y" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Width</span><input class="input input-bordered input-sm" type="number" min="0.1" step="any" x-model.number="selectedBin().width" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Height</span><input class="input input-bordered input-sm" type="number" min="0.1" step="any" x-model.number="selectedBin().height" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label></div>
								<p class="text-xs opacity-70">Inventory bin and stock remain separate from this physical placement.</p><button type="button" class="btn btn-error btn-outline btn-sm" x-on:click="removeSelectedPlacement()">Remove placement</button>
							</section>
							<section class="space-y-3" x-show="state.uiSelectionKind === 'decoration'">
								<label class="form-control"><span class="label-text text-xs">Paint label text</span><input class="input input-bordered input-sm" x-model="selectedDecoration().text" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()" x-bind:disabled="selectedDecoration().kind !== 'label'"/></label>
								<div class="grid grid-cols-2 gap-2"><label class="form-control"><span class="label-text text-xs">X</span><input class="input input-bordered input-sm" type="number" x-model.number="selectedDecoration().x" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Y</span><input class="input input-bordered input-sm" type="number" x-model.number="selectedDecoration().y" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Width</span><input class="input input-bordered input-sm" type="number" min="0" step="any" x-model.number="selectedDecoration().width" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Height</span><input class="input input-bordered input-sm" type="number" min="0" step="any" x-model.number="selectedDecoration().height" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label></div><p class="text-xs opacity-70">Paint objects are decorative; they are never inventory bins or drawers.</p><button type="button" class="btn btn-error btn-outline btn-sm" x-on:click="deleteDecoration()">Delete drawing</button>
							</section>
							<section class="space-y-3" x-show="!state.uiSelectionKind">
								if user.IsAdmin() {
									<div class="rounded border border-primary/40 bg-primary/5 p-3 space-y-3">
										<h3 class="font-semibold text-sm">1. Cabinet controllers</h3>
										<p class="text-xs">Assign zero to five exclusive controllers. Their order defines cabinet-wide pixel numbering; it is independent of drawer numbers and positions.</p>
										<div class="max-h-48 space-y-1 overflow-auto"><template x-for="controller in controllers" :key="controller.id"><label class="flex cursor-pointer items-center gap-2 rounded p-1 hover:bg-base-300"><input class="checkbox checkbox-sm" type="checkbox" x-bind:checked="controllerSelected(controller.id)" x-on:change="toggleController(controller.id, $event.target.checked)"/><span class="text-xs" x-text="controller.name + ' (#' + controller.id + ')' "></span></label></template></div>
										<div class="space-y-1"><strong class="text-xs">Cabinet controller order</strong><template x-for="(controllerID,index) in controllerDraft" :key="'order-' + controllerID"><div class="flex items-center gap-2 rounded bg-base-100 p-1"><span class="badge badge-primary badge-xs" x-text="index + 1"></span><span class="flex-1 truncate text-xs" x-text="controllers.find(item => item.id === controllerID)?.name || ('Controller #' + controllerID)"></span><button type="button" class="btn btn-xs btn-ghost" x-on:click="moveController(controllerID,-1)" x-bind:disabled="index===0" aria-label="Move controller up">↑</button><button type="button" class="btn btn-xs btn-ghost" x-on:click="moveController(controllerID,1)" x-bind:disabled="index===controllerDraft.length-1" aria-label="Move controller down">↓</button></div></template></div>
										<template x-for="change in controllerMappingPreview()" :key="'controller-impact-' + change.drawer + '-' + change.start"><div class="rounded bg-warning/10 p-2 text-[11px]"><strong x-text="change.drawer + ': pixels ' + change.start + ' +' + change.count"></strong><p><span class="font-semibold">Before:</span> <span x-text="change.before.join(' + ') || 'unmapped'"></span></p><p><span class="font-semibold">After:</span> <span x-text="change.after.join(' + ') || 'out of range'"></span></p></div></template>
										<label class="label cursor-pointer justify-start gap-2" x-show="controllerMappingPreview().length"><input type="checkbox" class="checkbox checkbox-sm" x-model="controllerMappingImpactConfirmed"/><span class="label-text text-xs">I reviewed and confirm the displayed destination changes.</span></label>
										<button type="button" class="btn btn-sm btn-outline" x-on:click="saveCabinetController()">Save controller order</button>
										<p class="text-xs text-success" role="status" x-show="controllerSaveNotice" x-text="controllerSaveNotice"></p>
										<p class="text-xs text-error" role="alert" x-show="controllerSaveError" x-text="controllerSaveError"></p>
									</div>
									<div class="rounded border border-secondary/40 bg-secondary/5 p-3 space-y-3">
										<h3 class="font-semibold text-sm">2. LED strings and wiring paths</h3>
										<p class="text-xs">String lengths determine each controller total. Ordered path sections describe where each pixel sequence runs on this cabinet canvas; one string may snake across rows, turn corners, or follow an irregular path.</p>
										<template x-for="(controllerID,controllerIndex) in controllerDraft" :key="'wiring-controller-' + controllerID">
											<div class="rounded bg-base-100 p-2 space-y-2">
												<div class="flex flex-wrap items-center justify-between gap-2"><strong class="text-xs" x-text="'Controller ' + (controllerIndex+1) + ': ' + (controllers.find(item => item.id === controllerID)?.name || ('#' + controllerID))"></strong><span class="badge badge-xs" x-text="controllerCabinetSpan(controllerID)"></span></div>
												<button type="button" class="btn btn-xs btn-outline" x-on:click="configureControllerStrings(controllerID)" x-show="!configuredControllerIDs.map(Number).includes(Number(controllerID))">Configure physical strings</button>
												<template x-for="string in stringRows(controllerID)" :key="string.key">
													<div class="rounded border border-base-300 p-2 space-y-2" x-bind:class="selectedStringKey===string.key?'ring-1 ring-secondary':''">
														<div class="flex items-center gap-1"><span class="badge badge-secondary badge-xs" x-text="'S' + (Number(string.display_order)+1)"></span><label class="form-control flex-1"><span class="label-text text-[10px]">String name</span><input class="input input-bordered input-xs" x-model="string.name"/></label><label class="form-control w-24"><span class="label-text text-[10px]">Pixels</span><input class="input input-bordered input-xs" type="number" min="1" step="1" x-model="string.pixel_count"/></label><button type="button" class="btn btn-xs btn-ghost" x-on:click="moveWiringString(string,-1)" x-bind:disabled="stringRows(controllerID).indexOf(string)===0" aria-label="Move string up">↑</button><button type="button" class="btn btn-xs btn-ghost" x-on:click="moveWiringString(string,1)" x-bind:disabled="stringRows(controllerID).indexOf(string)===stringRows(controllerID).length-1" aria-label="Move string down">↓</button></div>
														<p class="text-[10px]" x-text="'Cabinet range ' + stringCabinetRange(string) + ' · sections cover ' + wiringPathPixelTotal(string) + ' / ' + (Number(string.pixel_count)||0) + ' pixels'"></p>
														<label class="label cursor-pointer justify-start gap-2 py-0"><input type="checkbox" class="checkbox checkbox-xs" x-model="string.layout_complete"/><span class="label-text text-[10px]">Mark physical path complete</span></label>
														<div class="space-y-1"><template x-for="section in [...string.sections].sort((a,b)=>Number(a.display_order)-Number(b.display_order))" :key="section.key"><div class="rounded bg-base-200 p-2 space-y-1"><div class="flex items-center gap-1"><span class="text-[10px] flex-1" x-text="'Section ' + (Number(section.display_order)+1) + ' · ' + (Number(section.pixel_count)||0) + ' pixels · ' + section.points.length + ' path points'"></span><button type="button" class="btn btn-xs btn-ghost" x-on:click="movePathSection(string,section,-1)">↑</button><button type="button" class="btn btn-xs btn-ghost" x-on:click="movePathSection(string,section,1)">↓</button><button type="button" class="btn btn-xs btn-ghost" x-on:click="drawPathSection(string,section)">Draw path</button><button type="button" class="btn btn-xs btn-ghost text-error" x-on:click="removePathSection(string,section)">×</button></div><label class="form-control"><span class="label-text text-[10px]">Pixels in this ordered section</span><input class="input input-bordered input-xs" type="number" min="1" step="1" x-model="section.pixel_count"/></label></div></template></div>
														<div class="flex gap-1"><button type="button" class="btn btn-xs btn-outline" x-on:click="selectWiringString(string)">Highlight string</button><button type="button" class="btn btn-xs btn-outline" x-on:click="addPathSection(string)">＋ Add path section</button><button type="button" class="btn btn-xs btn-ghost text-error" x-on:click="removeWiringString(string)">Remove string</button></div>
													</div>
												</template>
												<button type="button" class="btn btn-xs btn-outline" x-on:click="addWiringString(controllerID)">＋ Add string</button>
											</div>
										</template>
										<template x-for="change in wiringMappingPreview()" :key="'wiring-impact-' + change.drawer + '-' + change.start"><div class="rounded bg-warning/10 p-2 text-[11px]"><strong x-text="change.drawer + ': cabinet pixels ' + change.start + ' +' + change.count"></strong><p><span class="font-semibold">Before:</span> <span x-text="change.before.join(' + ') || 'unmapped'"></span></p><p><span class="font-semibold">After:</span> <span x-text="change.after.join(' + ') || 'out of range'"></span></p></div></template>
										<label class="label cursor-pointer justify-start gap-2" x-show="wiringMappingPreview().length"><input type="checkbox" class="checkbox checkbox-sm" x-model="wiringMappingImpactConfirmed"/><span class="label-text text-xs">I reviewed and confirm the displayed wiring/mapping impact.</span></label>
										<button type="button" class="btn btn-sm btn-secondary" x-on:click="saveCabinetWiring()" x-bind:disabled="!configuredControllerIDs.length">Save strings and wiring paths</button>
										<p class="text-xs opacity-70" x-show="mode==='wiring' && tool==='path-point'">Click ordered points on the cabinet canvas; double-click to finish this section.</p>
										<p class="text-xs text-success" role="status" x-show="wiringSaveNotice" x-text="wiringSaveNotice"></p>
										<p class="text-xs text-error" role="alert" x-show="wiringSaveError" x-text="wiringSaveError"></p>
									</div>
								}
								<label class="form-control"><span class="label-text text-xs">Cabinet name</span><input class="input input-bordered input-sm" x-model="state.name" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label>
								<div class="grid grid-cols-2 gap-2"><label class="form-control"><span class="label-text text-xs">Canvas width</span><input class="input input-bordered input-sm" type="number" min="0.1" step="any" x-model.number="state.width" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label><label class="form-control"><span class="label-text text-xs">Canvas height</span><input class="input input-bordered input-sm" type="number" min="0.1" step="any" x-model.number="state.height" x-on:focus="beginPropertyEdit()" x-on:change="finishPropertyEdit()"/></label></div>
								<p class="text-xs opacity-70">Drawer geometry is saved separately and never implies a pixel allocation.</p><button type="button" class="btn btn-warning btn-outline btn-sm" x-on:click="archiveCabinet()">Archive cabinet</button><button type="button" class="btn btn-error btn-outline btn-sm" x-on:click="deleteCabinet()">Delete cabinet</button>
							</section>
							<p class="text-sm text-error rounded bg-error/10 p-2" role="alert" x-show="error" x-text="error" x-cloak></p>
						</div>
					</aside>
				</div>
			</form>
		</div>
		<script src="/static/js/physical_layout_editor.js"></script>
	}
}
