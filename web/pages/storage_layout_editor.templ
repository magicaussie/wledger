package pages

import (
 "fmt"
 "github.com/tuxedocurly/wledger/internal/auth"
 "github.com/tuxedocurly/wledger/internal/csrf"
 "github.com/tuxedocurly/wledger/internal/storage"
 "github.com/tuxedocurly/wledger/web/components"
 "github.com/tuxedocurly/wledger/web/layouts"
)

templ StorageLayoutEditor(layout storage.CabinetLayout, user auth.User) {
 @layouts.Base("Edit physical layout", user) {
  @templ.JSONScript("layout-editor-data", layout)
  <div class="max-w-7xl mx-auto w-full" x-data="physicalLayoutEditor()" x-init="init()">
   @components.PageHeader("Edit physical layout", "Edit cabinet, drawer and bin geometry. Saving never changes stock or electrical mappings.", []components.Breadcrumb{{Label:"Physical storage",URL:"/storage/cabinets"},{Label:layout.Cabinet.Name,URL:fmt.Sprintf("/storage/cabinets/%d",layout.Cabinet.ID)},{Label:"Edit"}})
   <form method="POST" action={templ.SafeURL(fmt.Sprintf("/storage/cabinets/%d/edit",layout.Cabinet.ID))} x-on:submit="prepare($event)" class="space-y-6">
    <input type="hidden" name="csrf_token" value={ csrf.TokenFromContext(ctx) } x-ref="csrf"/><input type="hidden" name="layout" x-ref="layout"/>
    <div class="card bg-base-200 shadow-xl border border-base-300"><div class="card-body grid grid-cols-1 md:grid-cols-3 gap-4">
     <label class="form-control"><span class="label-text">Cabinet name</span><input class="input input-bordered" x-model="state.name" required/></label>
     <label class="form-control"><span class="label-text">Grid width</span><input class="input input-bordered" type="number" min="0.1" step="any" x-model.number="state.width" required/></label>
     <label class="form-control"><span class="label-text">Grid height</span><input class="input input-bordered" type="number" min="0.1" step="any" x-model.number="state.height" required/></label>
    </div></div>
    <template x-for="(drawer, index) in state.drawers" :key="drawer.id || drawer.key">
     <section class="card bg-base-200 shadow-xl border border-base-300"><div class="card-body space-y-4">
      <div class="flex flex-wrap justify-between gap-2"><h2 class="font-bold" x-text="'Drawer ' + (index + 1)"></h2><div class="flex gap-2"><button type="button" class="btn btn-warning btn-outline btn-sm" x-on:click="lifecycle('/drawers/' + drawer.id + '/archive', 'Archive this drawer? It preserves its bins and stock.')" x-show="drawer.id">Archive</button><button type="button" class="btn btn-error btn-outline btn-sm" x-on:click="lifecycle('/drawers/' + drawer.id + '/delete', 'Delete this empty drawer?')" x-show="drawer.id">Delete</button><button type="button" class="btn btn-error btn-outline btn-sm" x-on:click="removeDrawer(index)" x-show="drawer.id === 0">Discard new drawer</button></div></div>
      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-7 gap-3"><label class="form-control lg:col-span-2"><span class="label-text">Label</span><input class="input input-bordered" x-model="drawer.label" required/></label><label class="form-control"><span class="label-text">Order</span><input class="input input-bordered" type="number" x-model.number="drawer.display_order"/></label><label class="form-control"><span class="label-text">X</span><input class="input input-bordered" type="number" min="0" step="any" x-model.number="drawer.x"/></label><label class="form-control"><span class="label-text">Y</span><input class="input input-bordered" type="number" min="0" step="any" x-model.number="drawer.y"/></label><label class="form-control"><span class="label-text">Width</span><input class="input input-bordered" type="number" min="0.1" step="any" x-model.number="drawer.width"/></label><label class="form-control"><span class="label-text">Height</span><input class="input input-bordered" type="number" min="0.1" step="any" x-model.number="drawer.height"/></label></div>
      <div class="overflow-x-auto"><table class="table table-sm"><thead><tr><th>Bin</th><th>Order</th><th>X</th><th>Y</th><th>Width</th><th>Height</th><th>Placement</th></tr></thead><tbody><template x-for="bin in drawer.bins" :key="bin.id"><tr><td><span x-text="bin.name || ('Bin #' + bin.id)"></span></td><td><input class="input input-bordered input-sm w-20" type="number" x-model.number="bin.display_order"/></td><td><input class="input input-bordered input-sm w-20" type="number" min="0" step="any" x-model.number="bin.x"/></td><td><input class="input input-bordered input-sm w-20" type="number" min="0" step="any" x-model.number="bin.y"/></td><td><input class="input input-bordered input-sm w-20" type="number" min="0.1" step="any" x-model.number="bin.width"/></td><td><input class="input input-bordered input-sm w-20" type="number" min="0.1" step="any" x-model.number="bin.height"/></td><td><button type="button" class="btn btn-error btn-outline btn-xs" x-on:click="lifecycle('/bins/' + bin.id + '/detach', 'Remove this physical placement? The inventory bin, stock and electrical mapping are retained.')">Remove placement</button></td></tr></template></tbody></table></div>
      <div class="flex flex-wrap gap-2"><select class="select select-bordered" x-model="drawer.selectedBin"><option value="">Associate an unattached bin</option><template x-for="bin in availableBins(drawer)" :key="bin.id"><option :value="bin.id" x-text="bin.name + ' (#' + bin.id + ')'"></option></template></select><button type="button" class="btn btn-outline" x-on:click="attachBin(drawer)" :disabled="!drawer.selectedBin">Add bin</button></div>
     </div></section>
    </template>
    <div class="flex flex-wrap gap-3"><button type="button" class="btn btn-outline" x-on:click="addDrawer()">Add drawer</button><button type="button" class="btn btn-warning btn-outline" x-on:click="lifecycle('/archive', 'Archive this cabinet? It preserves all drawers and stock.')">Archive cabinet</button><button type="button" class="btn btn-error btn-outline" x-on:click="lifecycle('/delete', 'Delete this empty cabinet?')">Delete cabinet</button><a class="btn btn-ghost" href={templ.SafeURL(fmt.Sprintf("/storage/cabinets/%d",layout.Cabinet.ID))}>Cancel</a><button type="submit" class="btn btn-primary">Save layout</button></div>
    <p class="text-sm text-error" x-show="error" x-text="error" x-cloak></p>
   </form>
  </div>
  <script>
  function physicalLayoutEditor(){return {state:{},bins:[],dirty:false,error:'',init(){let d=JSON.parse(document.getElementById('layout-editor-data').textContent);this.state={id:d.Cabinet.ID,revision:d.Cabinet.LayoutRevision,name:d.Cabinet.Name,coordinate_system:d.Cabinet.CoordinateSystem,display_order:d.Cabinet.DisplayOrder,width:d.Cabinet.LayoutWidth,height:d.Cabinet.LayoutHeight,drawers:d.Drawers.map(x=>({id:x.Drawer.ID,label:x.Drawer.Label,display_order:x.Drawer.DisplayOrder,x:x.Drawer.X,y:x.Drawer.Y,width:x.Drawer.Width,height:x.Drawer.Height,bins:x.Bins.map(b=>({id:b.BinID,display_order:b.DisplayOrder,x:b.X,y:b.Y,width:b.Width,height:b.Height})),selectedBin:'',key:x.Drawer.ID}))};this.bins=d.UnattachedBins;window.addEventListener('beforeunload',e=>{if(this.dirty){e.preventDefault();e.returnValue='';}});this.$watch('state',()=>this.dirty=true,{deep:true})},addDrawer(){this.state.drawers.push({id:0,key:crypto.randomUUID(),label:'New drawer',display_order:this.state.drawers.length,x:0,y:0,width:10,height:10,bins:[],selectedBin:''})},removeDrawer(i){this.state.drawers.splice(i,1)},availableBins(d){let used=new Set(this.state.drawers.flatMap(x=>x.bins.map(b=>b.id)));return this.bins.filter(b=>!used.has(b.ID)&&!used.has(b.id)).map(b=>({id:b.ID||b.id,name:b.Name||b.name}))},attachBin(d){let b=this.availableBins(d).find(x=>String(x.id)===String(d.selectedBin));if(b){d.bins.push({id:b.id,name:b.name,display_order:d.bins.length,x:0,y:0,width:1,height:1});d.selectedBin=''}},lifecycle(path,message){if(!window.confirm(message))return;let f=document.createElement('form');f.method='post';f.action='/storage/cabinets/'+this.state.id+path;for(let [n,v] of [['csrf_token',this.$refs.csrf.value],['revision',this.state.revision]]){let i=document.createElement('input');i.type='hidden';i.name=n;i.value=v;f.appendChild(i)}document.body.appendChild(f);f.submit()},prepare(e){this.error='';let payload=JSON.parse(JSON.stringify(this.state));payload.drawers.forEach(d=>{delete d.key;delete d.selectedBin});if(!payload.name||payload.width<=0||payload.height<=0){e.preventDefault();this.error='A cabinet name and positive dimensions are required.';return}this.$refs.layout.value=JSON.stringify(payload);this.dirty=false}}}
  </script>
 }
}
