package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/config"

	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/csrf"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/internal/storage"
	"github.com/tuxedocurly/wledger/internal/wled"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
)

// Physical browsing reads drawer/bin placement only from the physical storage
// tables. The drawer page also offers a separately authorized, session-owned
// Locate action using saved controller-wide LED allocations.

templ StorageCabinets(cabinets []storage.BrowseCabinet, user auth.User) {
	@layouts.Base(i18n.T(ctx, "M6Storage"), user) {
		<div class="max-w-7xl mx-auto w-full">
			@components.PageHeader(
				i18n.T(ctx, "M6Storage"),
				i18n.T(ctx, "M6BrowsePhysicalStorage"),
				nil,
			) {
				if user.CanWrite() {
					<form method="POST" action="/storage/cabinets" class="flex flex-wrap gap-2 items-end">
						<label class="form-control"><span class="label-text text-xs">Cabinet name</span><input class="input input-bordered input-sm" name="name" required/></label>
						<input type="hidden" name="csrf_token" value={ csrf.TokenFromContext(ctx) }/><input type="hidden" name="width" value="100"/><input type="hidden" name="height" value="100"/><input type="hidden" name="display_order" value="0"/>
						<button class="btn btn-primary btn-sm" type="submit">Create cabinet</button>
					</form>
				}
			}

			if len(cabinets) == 0 {
				@components.PhysicalStorageEmptyState(i18n.T(ctx, "M6NoCabinetsConfigured"), i18n.T(ctx, "M6NoCabinetsConfiguredDescription"))
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pb-12 items-start">
					for _, cabinet := range cabinets {
						<div class="card bg-base-200 shadow-xl border border-base-300 h-full">
							<div class="card-body p-5">
								<div class="flex items-start justify-between gap-3">
									<div class="min-w-0">
										<h2 class="text-xl font-bold truncate">{ cabinet.Name }</h2>
									</div>
									<span class="badge badge-sm badge-outline font-mono shrink-0 whitespace-nowrap">{ i18n.T(ctx, "M6CabinetNumber") } #{ fmt.Sprintf("%d", cabinet.ID) }</span>
								</div>
								<div class="flex flex-wrap gap-2 mt-3">
									<span class="badge badge-ghost badge-sm uppercase tracking-wider">{ i18n.T(ctx, "M6PhysicalPlacement") }</span>
									if cabinet.Archived != 0 {
										<span class="badge badge-warning badge-sm">{ i18n.T(ctx, "M6Archived") }</span>
									}
								</div>
								<div class="divider my-2"></div>
								<dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
									<div class="min-w-0">
										<dt class="uppercase tracking-wider text-base-content/80">{ i18n.T(ctx, "M6ActiveDrawers") }</dt>
										<dd class="font-mono text-sm">{ fmt.Sprintf("%d", len(cabinet.Drawers)) }</dd>
									</div>
									<div class="min-w-0">
										<dt class="uppercase tracking-wider text-base-content/80">{ i18n.T(ctx, "M6CoordinateSystem") }</dt>
										<dd class="font-mono text-sm truncate">{ cabinet.CoordinateSystem }</dd>
									</div>
									<div class="min-w-0">
										<dt class="uppercase tracking-wider text-base-content/80">{ i18n.T(ctx, "M6LayoutRevision") }</dt>
										<dd class="font-mono text-sm">{ fmt.Sprintf("%d", cabinet.LayoutRevision) }</dd>
									</div>
									<div class="min-w-0">
										<dt class="uppercase tracking-wider text-base-content/80">{ i18n.T(ctx, "M6ElectricalController") }</dt>
										<dd class="font-mono text-sm">
											if cabinet.ControllerID.Valid {
												{ fmt.Sprintf("#%d", cabinet.ControllerID.Int64) }
											} else {
												{ i18n.T(ctx, "M6None") }
											}
										</dd>
									</div>
								</dl>
								<div class="card-actions justify-end mt-4">
									<a href={ templ.SafeURL(fmt.Sprintf("/storage/cabinets/%d", cabinet.ID)) } class="btn btn-outline btn-sm gap-2">
										{ i18n.T(ctx, "View") }
									</a>
								</div>
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}

templ StorageCabinet(cabinet storage.BrowseCabinet, user auth.User) {
	@layouts.Base(cabinet.Name, user) {
		<div class="max-w-5xl mx-auto w-full">
			@components.PageHeader(
				cabinet.Name,
				i18n.T(ctx, "M6CabinetDetailDescription"),
				[]components.Breadcrumb{
					{Label: i18n.T(ctx, "M6Storage"), URL: "/storage/cabinets"},
					{Label: cabinet.Name},
				},
			) {
				<div class="flex flex-wrap gap-2">
					<span class="badge badge-ghost badge-md font-mono">{ i18n.T(ctx, "M6CabinetNumber") } #{ fmt.Sprintf("%d", cabinet.ID) }</span>
					if user.CanWrite() {
						<a class="btn btn-outline btn-sm" href={ templ.SafeURL(fmt.Sprintf("/storage/cabinets/%d/edit", cabinet.ID)) }>Edit layout</a>
					}
				</div>
			}

			<div class="card bg-base-200 shadow-xl border border-base-300 mb-6">
				<div class="card-body p-5">
					<div class="flex flex-wrap items-center gap-2">
						<span class="badge badge-ghost badge-sm uppercase tracking-wider">{ i18n.T(ctx, "M6PhysicalPlacement") }</span>
						if cabinet.Archived != 0 {
							<span class="badge badge-warning badge-sm">{ i18n.T(ctx, "M6Archived") }</span>
						}
					</div>
					<p class="text-sm text-base-content/80 mt-2">
						{ i18n.T(ctx, "M6ElectricalMappingNotice") }
					</p>
					<div class="divider my-2"></div>
					<dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
						<div class="min-w-0">
							<dt class="uppercase tracking-wider text-base-content/80">{ i18n.T(ctx, "M6CoordinateSystem") }</dt>
							<dd class="font-mono text-sm truncate">{ cabinet.CoordinateSystem }</dd>
						</div>
						<div class="min-w-0">
							<dt class="uppercase tracking-wider text-base-content/80">{ i18n.T(ctx, "M6LayoutRevision") }</dt>
							<dd class="font-mono text-sm">{ fmt.Sprintf("%d", cabinet.LayoutRevision) }</dd>
						</div>
						<div class="min-w-0">
							<dt class="uppercase tracking-wider text-base-content/80">{ i18n.T(ctx, "M6ElectricalRevision") }</dt>
							<dd class="font-mono text-sm">{ fmt.Sprintf("%d", cabinet.ElectricalRevision) }</dd>
						</div>
						<div class="min-w-0">
							<dt class="uppercase tracking-wider text-base-content/80">{ i18n.T(ctx, "M6ElectricalController") }</dt>
							<dd class="font-mono text-sm">
								if cabinet.ControllerID.Valid {
									{ fmt.Sprintf("#%d", cabinet.ControllerID.Int64) }
								} else {
									{ i18n.T(ctx, "M6None") }
								}
							</dd>
						</div>
					</dl>
				</div>
			</div>

			if len(cabinet.Drawers) > 0 && cabinet.LayoutWidth > 0 && cabinet.LayoutHeight > 0 {
				<div class="relative bg-base-200 border border-base-300 rounded-lg mb-6" style={ templ.SafeCSS(fmt.Sprintf("aspect-ratio: %g / %g", cabinet.LayoutWidth, cabinet.LayoutHeight)) }>
					for _, drawer := range cabinet.Drawers {
						<a href={ templ.SafeURL(fmt.Sprintf("/storage/drawers/%d", drawer.ID)) } class="absolute border border-primary bg-base-100 text-base-content p-2 overflow-auto focus-visible:outline-2 focus-visible:outline-primary" style={ templ.SafeCSS(fmt.Sprintf("left:%g%%;top:%g%%;width:%g%%;height:%g%%",100*drawer.X/cabinet.LayoutWidth,100*drawer.Y/cabinet.LayoutHeight,100*drawer.Width/cabinet.LayoutWidth,100*drawer.Height/cabinet.LayoutHeight)) }>{ drawerName(drawer, i18n.T(ctx,"M6Drawer")) }</a>
					}
				</div>
			}

			<h2 class="text-xs uppercase tracking-widest font-bold text-base-content/80 mb-3">
				{ i18n.T(ctx, "M6DrawersLabel") } · { fmt.Sprintf("%d", len(cabinet.Drawers)) }
			</h2>

			if len(cabinet.Drawers) == 0 {
				@components.PhysicalStorageEmptyState(i18n.T(ctx, "M6NoActiveDrawers"), i18n.T(ctx, "M6NoActiveDrawersDescription"))
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pb-12">
					for _, drawer := range cabinet.Drawers {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/storage/drawers/%d", drawer.ID)) }
							class="card bg-base-200 shadow-md border border-base-300 hover:shadow-lg transition-all block"
						>
							<div class="card-body p-4">
								<div class="flex items-start justify-between gap-2">
									<h3 class="font-bold truncate">
										if drawer.Label != "" {
											{ drawer.Label }
										} else {
											{ i18n.T(ctx, "M6Drawer") }
										}
									</h3>
									<span class="badge badge-sm badge-outline font-mono shrink-0">#{ fmt.Sprintf("%d", drawer.ID) }</span>
								</div>
								<p class="text-xs text-base-content/80 font-mono mt-1">
									{ fmt.Sprintf("%g × %g", drawer.Width, drawer.Height) } · at ({ fmt.Sprintf("%g, %g", drawer.X, drawer.Y) })
								</p>
								<p class="text-xs text-base-content/80 mt-1">{ i18n.T(ctx, "M6OpenDrawerToViewBins") }</p>
							</div>
						</a>
					}
				</div>
			}
		</div>
	}
}

templ StorageDrawer(detail storage.BrowseDrawerDetail, cabinetName string, user auth.User, selectedBinID int64, session *wled.PhysicalLocateSession, stopped bool) {
	@layouts.Base(drawerName(detail.Drawer, i18n.T(ctx, "M6Drawer")), user) {
		<div class="max-w-6xl mx-auto w-full" x-data={ drawerInitialState(selectedBinID) }>
			@components.PageHeader(
				drawerName(detail.Drawer, i18n.T(ctx, "M6Drawer")),
				i18n.T(ctx, "M6DrawerDetailDescription"),
				[]components.Breadcrumb{
					{Label: i18n.T(ctx, "M6Storage"), URL: "/storage/cabinets"},
					{Label: fmt.Sprintf("%s #%d", i18n.T(ctx, "M6CabinetNumber"), detail.Drawer.CabinetID), URL: fmt.Sprintf("/storage/cabinets/%d", detail.Drawer.CabinetID)},
					{Label: drawerName(detail.Drawer, i18n.T(ctx, "M6Drawer"))},
				},
			) {
				<div class="flex flex-wrap items-center gap-2">
					<span class="badge badge-ghost badge-md font-mono">{ i18n.T(ctx, "M6Drawer") } #{ fmt.Sprintf("%d", detail.Drawer.ID) }</span>
					<span class="badge badge-outline">{ cabinetName }</span>
				</div>
			}

			if !config.PhysicalWLEDOutputEnabled() {
				<div class="alert alert-info mb-6" role="status">LED Locate is unavailable in inventory-only mode. Inventory navigation and physical layout editing are unchanged. If an earlier Locate may have reached a controller, Stop can only retry its saved, re-verified targeted cleanup ranges.</div>
			}
			if session != nil && session.DrawerID == detail.Drawer.ID {
				<div class={ locateAlertClass(session.State) }>
					<div class="min-w-0">
						<strong>LED activation status: { session.State }</strong>
						<p class="text-sm">Cabinet { session.CabinetName } · { session.DrawerName } · Bin #{ fmt.Sprintf("%d", session.BinID) } · { session.Color } · brightness { fmt.Sprintf("%d", session.Brightness) }/255</p>
						<p class="text-xs">{ session.LastOperation } · { session.LastOperationAt.Format("2006-01-02 15:04:05 MST") }</p>
						if session.LastSuccessfulAt != "" {
							<p class="text-xs">Last WLED command acknowledged: { session.LastSuccessfulOperation } · { session.LastSuccessfulAt }</p>
						}
						if session.LastError != "" {
						<p class="text-sm font-semibold">{ session.LastError }</p>
						}
					</div>
					if user.CanWrite() && user.ID == session.OwnerID && (session.State == "activating" || session.State == "active" || session.State == "partial" || session.State == "stopping") {
						<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/storage/drawers/%d/stop", detail.Drawer.ID)) }>
							<input type="hidden" name="csrf_token" value={ csrf.TokenFromContext(ctx) }/>
							<button class="btn btn-error" type="submit">Stop Locate / Turn Off Allocated LEDs</button>
						</form>
					}
				</div>
			} else if stopped {
				<div class="alert alert-info mb-6" role="status">No application-owned drawer Locate session is active. Repeated Stop is safe.</div>
			}

			<div class="card bg-base-200 shadow-xl border border-base-300 mb-6">
				<div class="card-body p-5">
					<div class="flex flex-wrap items-center gap-2">
						<span class="badge badge-ghost badge-sm uppercase tracking-wider">{ i18n.T(ctx, "M6PhysicalPlacement") }</span>
						<span class="badge badge-outline badge-sm uppercase tracking-wider">{ i18n.T(ctx, "M6ElectricalMappingSeparate") }</span>
						<span class="badge badge-ghost badge-sm font-mono">{ i18n.T(ctx, "M6BinCountLabel") }: { fmt.Sprintf("%d", len(detail.Bins)) } · { i18n.T(ctx, "M6UnitCountLabel") }: { fmt.Sprintf("%d", totalUnits(detail.Bins)) }</span>
					</div>
					<p class="text-sm text-base-content/80 mt-2">
						{ i18n.T(ctx, "M6PhysicalVsElectricalExplanation") }
					</p>
					<div class="divider my-2"></div>
					<p class="text-xs font-mono text-base-content/80">
						{ i18n.T(ctx, "M6DrawerGeometry") }: { fmt.Sprintf("%g × %g", detail.Drawer.Width, detail.Drawer.Height) } { i18n.T(ctx, "M6CoordinateAt") } ({ fmt.Sprintf("%g, %g", detail.Drawer.X, detail.Drawer.Y) })
					</p>
				</div>
			</div>

			<div class="flex flex-wrap gap-2 mb-6" role="group" aria-label={ i18n.T(ctx, "M6Presentation") }>
				<button type="button" class="btn btn-outline" x-on:click="layout = false; presentation = 'grid'" x-bind:aria-pressed="!layout && presentation === 'grid'">{ i18n.T(ctx, "M6Grid") }</button>
				<button type="button" class="btn btn-outline" x-on:click="layout = false; presentation = 'list'" x-bind:aria-pressed="!layout && presentation === 'list'">{ i18n.T(ctx, "M6List") }</button>
				<button type="button" class="btn btn-outline" x-on:click="layout = !layout" x-bind:aria-pressed="layout">{ i18n.T(ctx, "M6ViewBinLayout") }</button>
			</div>
			<div x-show="!layout">
				if len(detail.Bins) > 0 && drawerPartLocations(detail.Bins) == 0 {
					@components.PhysicalStorageEmptyState(i18n.T(ctx, "NoPartsFound"), i18n.T(ctx, "M6ViewBinLayout"))
				}
				<div x-bind:class="presentation === 'grid' ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-6' : 'flex flex-col gap-4 mb-6'">
					for _, bin := range detail.Bins {
						for _, part := range bin.Contents {
							<article class="card bg-base-200 border border-base-300">
								<div class="card-body p-4">
									if part.ImagePath.Valid && part.ImagePath.String != "" {
										<img src={ part.ImagePath.String } alt="" class="w-20 h-20 object-contain" loading="lazy" onerror="this.hidden = true"/>
									}
									<a href={ templ.SafeURL(fmt.Sprintf("/parts/%d", part.PartID)) } class="link font-bold break-words">{ part.Name }</a>
									<a href={ templ.SafeURL(fmt.Sprintf("/parts?bin=%d", bin.BinID)) } class="link">{ bin.Name } · #{ fmt.Sprintf("%d", bin.BinID) }</a>
									<span class="font-mono">×{ fmt.Sprintf("%d", part.Quantity) }</span>
								</div>
							</article>
						}
					}
				</div>
			</div>
			<div x-show="layout" x-cloak>
				<div class="relative bg-base-200 border border-base-300 rounded-lg mb-6" style={ templ.SafeCSS(fmt.Sprintf("aspect-ratio: %g / %g", detail.Drawer.Width, detail.Drawer.Height)) }>
					for _, bin := range detail.Bins {
						<div class={ drawerBinClass(bin.BinID, selectedBinID) } style={ templ.SafeCSS(fmt.Sprintf("left:%g%%;top:%g%%;width:%g%%;height:%g%%", 100*bin.X/detail.Drawer.Width, 100*bin.Y/detail.Drawer.Height, 100*bin.Width/detail.Drawer.Width, 100*bin.Height/detail.Drawer.Height)) }>
							<a href={ templ.SafeURL(fmt.Sprintf("/parts?bin=%d", bin.BinID)) } class="block truncate">{ bin.Name } · #{ fmt.Sprintf("%d", bin.BinID) }</a>
							if user.CanWrite() && config.PhysicalWLEDOutputEnabled() {
								<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/storage/drawers/%d/locate", detail.Drawer.ID)) }>
									<input type="hidden" name="csrf_token" value={ csrf.TokenFromContext(ctx) }/>
									<input type="hidden" name="bin_id" value={ fmt.Sprintf("%d", bin.BinID) }/>
									<button type="submit" class="btn btn-xs btn-primary mt-1">Locate this bin</button>
								</form>
							}
						</div>
					}
				</div>
			</div>
			if len(detail.Bins) == 0 {
				@components.PhysicalStorageEmptyState(i18n.T(ctx, "M6NoBinsInDrawer"), i18n.T(ctx, "M6NoBinsInDrawerDescription"))
			} else {
				<div x-show="layout" x-cloak class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-12 items-start">
					for _, bin := range detail.Bins {
						<div class="card bg-base-200 shadow-md border border-base-300">
							<div class="card-body p-4">
								<div class="flex items-start justify-between gap-2">
									<div class="min-w-0">
										<h3 id={ fmt.Sprintf("bin-%d", bin.BinID) } class="font-bold truncate">
											if bin.Name != "" {
												{ bin.Name }
											} else {
												{ i18n.T(ctx, "M6Bin") }
											}
										</h3>
									</div>
									<span class="badge badge-sm badge-outline font-mono shrink-0">{ i18n.T(ctx, "M6BinNumber") } #{ fmt.Sprintf("%d", bin.BinID) }</span>
								</div>
								<p class="text-xs text-base-content/80 font-mono mt-1">
									{ fmt.Sprintf("%g × %g", bin.Width, bin.Height) } { i18n.T(ctx, "M6CoordinateAt") } ({ fmt.Sprintf("%g, %g", bin.X, bin.Y) })
								</p>
								<div class="divider my-2"></div>
								if len(bin.Contents) == 0 {
									<div class="flex items-center justify-between">
										<span class="text-xs text-base-content/80">{ i18n.T(ctx, "EmptyBin") }</span>
										<a href={ templ.SafeURL(fmt.Sprintf("/parts?bin=%d", bin.BinID)) } class="btn btn-ghost btn-xs">{ i18n.T(ctx, "View") }</a>
									</div>
								} else {
									<ul class="space-y-2">
										for _, part := range bin.Contents {
											<li class="flex items-center justify-between gap-3">
												<div class="min-w-0">
													<a href={ templ.SafeURL(fmt.Sprintf("/parts/%d", part.PartID)) } class="link-hover font-medium truncate block">{ part.Name }</a>
													if part.PartNumber.Valid && part.PartNumber.String != "" {
														<span class="text-[11px] font-mono text-base-content/80">{ i18n.T(ctx, "M6PartNumber") } { part.PartNumber.String }</span>
													}
												</div>
												<span class="font-mono text-base-content/80 shrink-0">×{ fmt.Sprintf("%d", part.Quantity) }</span>
											</li>
										}
									</ul>
									<div class="card-actions justify-end mt-3">
										<a href={ templ.SafeURL(fmt.Sprintf("/parts?bin=%d", bin.BinID)) } class="btn btn-ghost btn-xs">{ i18n.T(ctx, "View") }</a>
									</div>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>
	}
}

// drawerName returns a drawer's label, or a stable fallback built from its id
// when the label is empty — used for the page title and the breadcrumb tail.
func drawerName(drawer storage.BrowseDrawer, fallback string) string {
	if drawer.Label != "" {
		return drawer.Label
	}
	return fmt.Sprintf("%s #%d", fallback, drawer.ID)
}

func drawerInitialState(selectedBinID int64) string {
	return fmt.Sprintf("{ presentation: 'grid', layout: %t }", selectedBinID > 0)
}

func drawerBinClass(binID, selectedBinID int64) string {
	if binID == selectedBinID && selectedBinID != 0 {
		return "absolute border-4 border-primary bg-primary/30 text-base-content overflow-auto p-2 font-bold shadow-lg z-10"
	}
	return "absolute border border-base-content bg-base-100 text-base-content overflow-auto p-2"
}

func locateAlertClass(state string) string {
	switch state {
	case "active":
		return "alert alert-success shadow-sm mb-6"
	case "partial", "stopping":
		return "alert alert-warning shadow-sm mb-6"
	default:
		return "alert alert-info shadow-sm mb-6"
	}
}

func drawerPartLocations(bins []storage.BrowseBin) int {
	count := 0
	for _, bin := range bins {
		count += len(bin.Contents)
	}
	return count
}

// totalUnits sums the recorded quantities across every bin's contents so a
// drawer can show a stable "N bins / M units" summary. Zero quantities are
// counted as zero — the value is never rounded or inferred.
func totalUnits(bins []storage.BrowseBin) int64 {
	var total int64
	for _, bin := range bins {
		for _, part := range bin.Contents {
			total += part.Quantity
		}
	}
	return total
}
