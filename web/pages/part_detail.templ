package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ PartDetail(user auth.User, p db.Part, stock []db.GetPartAssignmentsRow, controllers []db.Controller) {
	@layouts.Base(p.Name, user) {
		<div class="max-w-6xl mx-auto w-full">
			<div class="text-sm breadcrumbs mb-4 opacity-70">
				<ul>
					<li><a href="/parts">Inventory</a></li>
					<li class="font-bold">{ p.Name }</li>
				</ul>
			</div>
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
				<div class="lg:col-span-1 space-y-6">
					<div class="card bg-base-200 shadow-xl border border-base-300 overflow-hidden">
						<figure class="aspect-square bg-base-300 relative group">
							if p.ImagePath.Valid && p.ImagePath.String != "" {
								<img src={ "/uploads/" + p.ImagePath.String } alt={ p.Name } class="object-cover w-full h-full transition-transform duration-500 group-hover:scale-105"/>
							} else {
								<div class="flex flex-col items-center justify-center w-full h-full text-base-content/20">
									<span class="text-6xl mb-2">📦</span>
									<span class="text-xs uppercase font-bold tracking-widest">No Image</span>
								</div>
							}
							<div class="absolute top-2 right-2 badge badge-neutral font-mono text-xs shadow-md">ID: { fmt.Sprintf("%d", p.ID) }</div>
						</figure>
						<div class="card-body p-5">
							<div class="mb-2">
								<h1 class="text-2xl font-black leading-tight text-base-content">{ p.Name }</h1>
								if p.PartNumber.Valid && p.PartNumber.String != "" {
									<div class="flex items-center gap-2 mt-1">
										<span class="badge badge-outline text-xs font-mono opacity-70">{ p.PartNumber.String }</span>
									</div>
								}
							</div>
							if p.Description.Valid && p.Description.String != "" {
								<p class="text-sm text-base-content/70 leading-relaxed border-l-2 border-primary/20 pl-3 my-2">
									{ p.Description.String }
								</p>
							} else {
								<p class="text-sm italic opacity-40 my-2">No description provided.</p>
							}
							<div class="stats stats-vertical bg-base-100 shadow-sm border border-base-300 mt-4 text-xs lg:text-sm">
								<div class="stat p-3">
									<div class="stat-title opacity-60">Unit Cost</div>
									<div class="stat-value text-lg text-primary">${ fmt.Sprintf("%.2f", p.UnitCost.Float64) }</div>
								</div>
								<div class="stat p-3">
									<div class="stat-title opacity-60">Total Value</div>
									<div class="stat-value text-lg text-base-content opacity-70">
										${ fmt.Sprintf("%.2f", p.UnitCost.Float64 * float64(calculateTotal(stock))) }
									</div>
								</div>
							</div>
							if user.CanWrite() {
								<div class="card-actions justify-end mt-6 pt-4 border-t border-base-content/10 gap-2">
									<a href={ templ.SafeURL(fmt.Sprintf("/parts/%d/edit", p.ID)) } class="btn btn-sm btn-outline gap-2">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
										Edit
									</a>
									if user.CanDelete() {
										<form action={ templ.SafeURL(fmt.Sprintf("/parts/%d/delete", p.ID)) } method="POST" hx-boost="false">
											<button
												type="submit"
												class="btn btn-sm btn-outline btn-error gap-2"
												onclick="if(!confirm('Are you sure you want to delete this part? This cannot be undone.')){ return false; }"
											>
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
												Delete
											</button>
										</form>
									}
								</div>
							}
						</div>
					</div>
				</div>
				<div class="lg:col-span-2 space-y-6">
					<div class="card bg-base-100 shadow-xl border border-base-300">
						<div class="card-body p-0 sm:p-6">
							<div class="p-4 sm:p-0 flex justify-between items-center">
								<h2 class="card-title text-lg flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
									Stock Locations
								</h2>
								<div class="badge badge-secondary badge-lg font-bold">Total: { fmt.Sprintf("%d", calculateTotal(stock)) }</div>
							</div>
							if len(stock) == 0 {
								<div class="alert alert-warning text-sm m-4 sm:m-0 w-auto">
									<svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
									<span>No stock assigned. Add items below.</span>
								</div>
							} else {
								<div class="overflow-x-auto w-full">
									<table class="table table-zebra w-full">
										<thead>
											<tr class="bg-base-200 text-base-content/70">
												<th class="w-1/3">Controller</th>
												<th>Bin</th>
												<th class="text-right">Qty</th>
												<th class="text-right pr-6">Actions</th>
											</tr>
										</thead>
										<tbody>
											for _, s := range stock {
												<tr class="hover">
													<td>
														if s.ControllerName.Valid {
															<div class="font-medium">{ s.ControllerName.String }</div>
															<div class="text-xs opacity-50 truncate max-w-[100px]">{ s.ControllerIp.String }</div>
														} else {
															<span class="opacity-50 italic">Unassigned</span>
														}
													</td>
													<td>
														<span class="badge badge-neutral font-mono font-bold">{ s.BinName }</span>
													</td>
													<td class="text-right font-bold text-lg font-mono">{ fmt.Sprintf("%d", s.Quantity) }</td>
													<td class="text-right">
														<div class="flex items-center justify-end gap-2">
															if user.CanWrite() {
																if s.ControllerID.Valid {
																	<button
																		type="button"
																		hx-post={ fmt.Sprintf("/hardware/%d/locate?bin_id=%d", s.ControllerID.Int64, s.BinID) }
																		hx-trigger="click"
																		hx-swap="none"
																		class="btn btn-xs btn-primary text-white shadow-sm border-none"
																		title="Locate LED"
																	>
																		<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 sm:mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path></svg>
																		<span class="hidden sm:inline">Locate</span>
																	</button>
																}
															}
															if user.CanDelete() {
																<form
																	action={ templ.SafeURL(fmt.Sprintf("/parts/%d/stock/%d/delete", p.ID, s.BinID)) }
																	method="POST"
																	hx-boost="false"
																	style="display:inline;"
																>
																	<button
																		type="submit"
																		class="btn btn-xs btn-outline btn-error shadow-sm"
																		onclick="return confirm('Remove this stock assignment?');"
																		title="Remove Stock"
																	>
																		<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
																	</button>
																</form>
															}
														</div>
													</td>
												</tr>
											}
										</tbody>
									</table>
								</div>
							}
						</div>
					</div>
					if user.CanWrite() {
						<div class="card bg-base-200 shadow-xl">
							<div class="card-body">
								<h3 class="font-bold text-lg flex items-center gap-2">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
									Add Stock
								</h3>
								<form action={ templ.SafeURL(fmt.Sprintf("/parts/%d/assign", p.ID)) } method="POST" class="flex flex-col gap-4">
									<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
										<div class="form-control">
											<label class="label"><span class="label-text">Controller</span></label>
											<select
												name="controller_id"
												class="select select-bordered w-full"
												hx-get="/parts/bins_options"
												hx-target="#bin-select"
												hx-swap="outerHTML"
												hx-trigger="change"
											>
												<option disabled selected>Select Controller</option>
												for _, c := range controllers {
													<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name }</option>
												}
											</select>
										</div>
										<div class="form-control">
											<label class="label"><span class="label-text">Bin</span></label>
											<select id="bin-select" name="bin_id" class="select select-bordered w-full" disabled>
												<option>Select Controller First</option>
											</select>
										</div>
									</div>
									<div class="form-control">
										<label class="label"><span class="label-text">Quantity</span></label>
										<div class="flex items-center gap-4">
											<div class="join">
												<button type="button" class="btn join-item" onclick="this.parentNode.querySelector('input[type=number]').stepDown()">-</button>
												<input type="number" name="quantity" class="input input-bordered join-item w-20 text-center" value="1" min="1"/>
												<button type="button" class="btn join-item" onclick="this.parentNode.querySelector('input[type=number]').stepUp()">+</button>
											</div>
											<button class="btn btn-primary flex-1">
												Assign Stock
											</button>
										</div>
									</div>
								</form>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	}
}

func calculateTotal(stock []db.GetPartAssignmentsRow) int64 {
	var t int64 = 0
	for _, s := range stock {
		t += s.Quantity
	}
	return t
}

templ BinOptions(bins []db.Bin) {
	<select id="bin-select" name="bin_id" class="select select-bordered w-full">
		if len(bins) == 0 {
			<option disabled selected>No bins available</option>
		} else {
			<option disabled selected>Select Bin</option>
			for _, b := range bins {
				<option value={ fmt.Sprintf("%d", b.ID) }>{ b.Name }</option>
			}
		}
	</select>
}
