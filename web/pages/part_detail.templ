package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ PartDetail(user auth.User, part db.Part, stock []db.GetPartAssignmentsRow, links []db.PartLink, docs []db.PartDoc, controllers []db.Controller) {
	@layouts.Base(part.Name, user) {
		<div class="max-w-5xl mx-auto w-full">
			@components.PageHeader(
				part.Name,
				part.Description.String,
				[]components.Breadcrumb{
					{Label: "Inventory", URL: "/parts"},
					{Label: part.Name},
				},
			) {
				if user.CanWrite() {
					<a href={ templ.SafeURL(fmt.Sprintf("/parts/%d/edit", part.ID)) } class="btn btn-outline gap-2">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
						Edit Part
					</a>
					@components.DeleteButton(components.DeleteButtonProps{
						ID:          fmt.Sprintf("%d", part.ID),
						TargetURL:   fmt.Sprintf("/parts/%d/delete", part.ID),
						Message:     "Are you sure you want to delete this part? This will remove all associated documents, images, and inventory assignments.",
						ButtonLabel: "Delete",
					})
				}
			}
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
				<div class="space-y-6">
					<div class="card bg-base-200 shadow-xl border border-base-300 overflow-hidden">
						<figure class="aspect-square bg-base-300 relative group">
							if part.ImagePath.Valid && part.ImagePath.String != "" {
								<img src={ part.ImagePath.String } alt={ part.Name } class="w-full h-full object-cover"/>
							} else {
								<div class="flex flex-col items-center justify-center h-full opacity-20">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-24 w-24" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
								</div>
							}
						</figure>
					</div>
					<div class="card bg-base-200 shadow-xl border border-base-300">
						<div class="card-body p-4">
							<h3 class="font-bold text-xs uppercase tracking-wider opacity-50 mb-3">Specifications</h3>
							<div class="space-y-3 text-sm">
								if part.PartNumber.Valid {
									<div class="flex justify-between">
										<span class="opacity-70">MPN</span>
										<span class="font-mono">{ part.PartNumber.String }</span>
									</div>
								}
								if part.Manufacturer.Valid {
									<div class="flex justify-between">
										<span class="opacity-70">Manufacturer</span>
										<span class="font-medium">{ part.Manufacturer.String }</span>
									</div>
								}
								if part.Supplier.Valid {
									<div class="flex justify-between">
										<span class="opacity-70">Supplier</span>
										<span class="font-medium">{ part.Supplier.String }</span>
									</div>
								}
								<div class="divider my-1"></div>
								<div class="flex justify-between">
									<span class="opacity-70">Unit Cost</span>
									<span class="font-mono">$ { fmt.Sprintf("%.2f", part.UnitCost.Float64) }</span>
								</div>
							</div>
						</div>
					</div>
					if len(links) > 0 || len(docs) > 0 {
						<div class="card bg-base-200 shadow-xl border border-base-300">
							<div class="card-body p-4">
								<h3 class="font-bold text-xs uppercase tracking-wider opacity-50 mb-3">Resources</h3>
								if len(links) > 0 {
									<div class="flex flex-col gap-2">
										for _, link := range links {
											<a href={ templ.SafeURL(link.Url) } target="_blank" class="btn btn-sm btn-ghost justify-start font-normal h-auto py-2">
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
												{ link.Label.String }
											</a>
										}
									</div>
								}
								if len(links) > 0 && len(docs) > 0 {
									<div class="divider my-1"></div>
								}
								if len(docs) > 0 {
									<div class="flex flex-col gap-2">
										for _, doc := range docs {
											<a href={ templ.SafeURL(doc.FilePath) } target="_blank" class="btn btn-sm btn-ghost justify-start font-normal h-auto py-2">
												<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
												{ doc.FileName }
											</a>
										}
									</div>
								}
							</div>
						</div>
					}
				</div>
				<div class="lg:col-span-2 space-y-6">
					<div class="stats shadow-xl border border-base-300 w-full bg-base-200">
						<div class="stat">
							<div class="stat-title">Total In Stock</div>
							<div class="stat-value text-primary">
								{ fmt.Sprintf("%d", calculateTotalStock(stock)) }
							</div>
							if part.MinStockThreshold.Valid && calculateTotalStock(stock) <= part.MinStockThreshold.Int64 {
								<div class="stat-desc text-warning font-bold">Low Stock Warning</div>
							}
						</div>
					</div>
					<div class="card bg-base-200 shadow-xl border border-base-300">
						<div class="card-body p-0">
							<div class="p-4 border-b border-base-300 flex justify-between items-center">
								<h3 class="font-bold">Locations</h3>
								if user.CanWrite() {
									<button onclick="stock_modal.showModal()" class="btn btn-sm btn-primary">
										<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
										Add Stock
									</button>
								}
							</div>
							<div class="overflow-x-auto">
								<table class="table">
									<thead>
										<tr>
											<th>Location</th>
											<th>Controller</th>
											<th class="text-right">Qty</th>
											<th class="text-right w-1">Actions</th>
										</tr>
									</thead>
									<tbody>
										if len(stock) == 0 {
											<tr>
												<td colspan="4" class="text-center py-8 opacity-50">
													No stock assigned.
												</td>
											</tr>
										}
										for _, s := range stock {
											<tr>
												<td class="font-medium">
													if s.BinName.Valid {
														<div class="flex items-center gap-2">
															<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
															{ s.BinName.String }
														</div>
													} else {
														<div class="flex items-center gap-2 text-warning" title="This stock is no longer assigned to a valid bin">
															<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
															Orphaned
														</div>
													}
												</td>
												<td class="text-sm opacity-70">
													if s.ControllerName.Valid {
														{ s.ControllerName.String }
													} else {
														<span class="italic">Unmanaged</span>
													}
												</td>
												<td class="text-right font-mono font-bold">{ fmt.Sprintf("%d", s.Quantity) }</td>
												<td class="text-right">
													<div class="flex justify-end gap-1">
														if s.ControllerID.Valid && s.BinID.Valid {
															<button
																hx-post={ fmt.Sprintf("/hardware/%d/locate?bin_id=%d", s.ControllerID.Int64, s.BinID.Int64) }
																hx-swap="none"
																class="btn btn-xs btn-ghost text-accent"
																title="Locate"
															>
																<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
															</button>
														}
														if user.CanWrite() {
															if !s.BinName.Valid || !s.ControllerID.Valid {
																<button
																	{ templ.Attributes{"onclick": fmt.Sprintf("move_stock_modal_%d.showModal()", s.ID)}... }
																	class="btn btn-xs btn-outline btn-warning"
																	title="Reassign to a valid bin"
																>
																	Fix
																</button>
																@components.MoveStockModal(
																	fmt.Sprintf("move_stock_modal_%d", s.ID),
																	"Reassign Orphaned Stock",
																	fmt.Sprintf("This stock is currently not assigned to any physical bin. Select a new location for these %d items.", s.Quantity),
																	fmt.Sprintf("/parts/%d/stock/%d/move", part.ID, s.ID),
																	s.Quantity,
																	controllers,
																)
															} else {
																<button
																	{ templ.Attributes{"onclick": fmt.Sprintf("move_stock_modal_%d.showModal()", s.ID)}... }
																	class="btn btn-xs btn-ghost"
																	title="Move Stock"
																>
																	<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"></path></svg>
																</button>
																@components.MoveStockModal(
																	fmt.Sprintf("move_stock_modal_%d", s.ID),
																	"Move Stock",
																	fmt.Sprintf("Select a new location to move these %d items to.", s.Quantity),
																	fmt.Sprintf("/parts/%d/stock/%d/move", part.ID, s.ID),
																	s.Quantity,
																	controllers,
																)
															}
															<form action={ templ.SafeURL(fmt.Sprintf("/parts/%d/stock/%d/delete", part.ID, s.ID)) } method="POST" onsubmit="return confirm('Remove this stock assignment?');">
																<button class="btn btn-xs btn-ghost text-error" title="Remove">
																	<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
																</button>
															</form>
														}
													</div>
												</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				</div>
			</div>
			if user.CanWrite() {
				@components.Modal(components.ModalProps{
					ID:       "stock_modal",
					Title:    "Add Stock Location",
					BoxClass: "bg-base-100 overflow-visible",
				}) {
					<form
						action={ templ.SafeURL(fmt.Sprintf("/parts/%d/assign", part.ID)) }
						method="POST"
						class="space-y-5"
						x-data="{ valid: false }"
						@input="valid = $el.checkValidity()"
						x-init="valid = $el.checkValidity()"
					>
						<div class="form-control w-full">
							<label class="label pt-0 pb-2 justify-start gap-2">
								<span class="label-text font-medium">WLED Controller</span>
								<div
									class="tooltip tooltip-bottom md:tooltip-right before:text-xs before:w-[14rem] md:before:w-[24rem] z-50"
									data-tip="Select the WLED controller containing the bin you want to store this part in."
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-base-content/80 hover:text-primary transition-colors cursor-help">
										<path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm11.378-3.917c-.89-.777-2.366-.777-3.255 0a.75.75 0 01-.988-1.129c1.454-1.272 3.776-1.272 5.23 0 1.539 1.345 1.469 3.797.147 4.931-1.019.874-1.725 1.76-1.725 2.865v.75a.75.75 0 01-1.5 0v-.75c0-1.76 1.144-3.09 2.45-4.21.602-.516.59-1.2.14-1.593zM12 18a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd"></path>
									</svg>
								</div>
							</label>
							<select
								name="controller_id"
								class="select select-bordered w-full"
								hx-get="/parts/bins_options"
								hx-target="#bin_select"
								hx-trigger="change"
								required
							>
								<option value="" disabled selected>Select a controller...</option>
								for _, c := range controllers {
									<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name }</option>
								}
							</select>
						</div>
						<div class="form-control w-full">
							<label class="label pt-0 pb-2 justify-start gap-2">
								<span class="label-text font-medium">Bin / Location</span>
								<div
									class="tooltip tooltip-bottom md:tooltip-right before:text-xs before:w-[14rem] md:before:w-[24rem] z-50"
									data-tip="Choose the specific physical bin (LED segment) assigned to this part."
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-base-content/80 hover:text-primary transition-colors cursor-help">
										<path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm11.378-3.917c-.89-.777-2.366-.777-3.255 0a.75.75 0 01-.988-1.129c1.454-1.272 3.776-1.272 5.23 0 1.539 1.345 1.469 3.797.147 4.931-1.019.874-1.725 1.76-1.725 2.865v.75a.75.75 0 01-1.5 0v-.75c0-1.76 1.144-3.09 2.45-4.21.602-.516.59-1.2.14-1.593zM12 18a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd"></path>
									</svg>
								</div>
							</label>
							<select id="bin_select" name="bin_id" class="select select-bordered w-full" required>
								<option value="" disabled selected>Select a controller first</option>
							</select>
							<label class="label">
								<span class="label-text-alt text-base-content/50">Select a controller to load available bins</span>
							</label>
						</div>
						<div class="form-control w-full" x-data="{ qty: 1 }">
							<label class="label pt-0 pb-2 justify-start gap-2">
								<span class="label-text font-medium">Quantity</span>
								<div
									class="tooltip tooltip-bottom md:tooltip-right before:text-xs before:w-[14rem] md:before:w-[24rem] z-50"
									data-tip="Enter how many units are currently stored in this specific bin."
								>
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-base-content/80 hover:text-primary transition-colors cursor-help">
										<path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm11.378-3.917c-.89-.777-2.366-.777-3.255 0a.75.75 0 01-.988-1.129c1.454-1.272 3.776-1.272 5.23 0 1.539 1.345 1.469 3.797.147 4.931-1.019.874-1.725 1.76-1.725 2.865v.75a.75.75 0 01-1.5 0v-.75c0-1.76 1.144-3.09 2.45-4.21.602-.516.59-1.2.14-1.593zM12 18a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd"></path>
									</svg>
								</div>
							</label>
							<div class="join w-full">
								<button
									type="button"
									class="btn btn-primary join-item btn-square"
									@click="qty = Math.max(1, parseInt(qty || 0) - 1)"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path></svg>
								</button>
								<input
									type="number"
									name="quantity"
									x-model="qty"
									min="1"
									class="input input-bordered join-item w-full text-center appearance-none"
									required
								/>
								<button
									type="button"
									class="btn btn-primary join-item btn-square"
									@click="qty = parseInt(qty || 0) + 1"
								>
									<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
								</button>
							</div>
						</div>
						<div class="modal-action mt-8">
							<button type="button" class="btn btn-ghost" onclick="stock_modal.close()">Cancel</button>
							<button type="submit" class="btn btn-primary px-6" :disabled="!valid">Save Stock</button>
						</div>
					</form>
				}
			}
		</div>
	}
}

// Helper to sum stock
// TODO: potentially move this into /internal/utils
func calculateTotalStock(stock []db.GetPartAssignmentsRow) int64 {
	var total int64 = 0
	for _, s := range stock {
		total += s.Quantity
	}
	return total
}
