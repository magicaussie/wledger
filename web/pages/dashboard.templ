package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/icons"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ Dashboard(user auth.User, stats db.GetDashboardStatsRow, dashboardWalls []components.DashboardWall, legacyControllers []components.DashboardController) {
	@layouts.Base("Dashboard", user) {
		<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
			<div>
				<h1 class="text-3xl font-bold">Dashboard</h1>
				<p class="opacity-70">Visual inventory status.</p>
			</div>
		</div>
		<div class="flex justify-end mb-6">
			if user.CanConfigure() {
				<button @click="document.getElementById('create_wall_modal').showModal()" class="btn btn-primary shadow-sm" title="Create Wall">
					@icons.PlusIcon(5)
					Create Wall
				</button>
			}
		</div>
		<div class="flex flex-col md:flex-row md:flex-wrap justify-center gap-6 mb-12">
			@components.StatCard(
				"Unique Parts",
				fmt.Sprintf("%d", stats.TotalParts),
				"text-primary",
			)
			@components.StatCard(
				"Total Stock",
				fmt.Sprintf("%d", int64(stats.TotalItemsInStock)),
				"text-secondary",
			)
			@components.StatCard(
				"Total Value",
				fmt.Sprintf("$%.2f", stats.TotalStockValue),
				"text-success",
			)
			@components.StatCard(
				"Controllers",
				fmt.Sprintf("%d / %d", stats.OnlineControllers, stats.TotalControllers),
				"text-accent",
			)
		</div>
		<div class="space-y-12">
			if len(dashboardWalls) == 0 {
				if len(legacyControllers) == 0 {
					@components.EmptyState(
						"No containers configured",
						"Go to Hardware to set up your first WLED controller and map some bins.",
						"🔌",
					)
				} else {
					<div class="alert alert-info shadow-sm mb-8 ma-8">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
						<span>Showing all controllers. Create a <strong>Wall</strong> to organize your view.</span>
					</div>
					for _, ctrl := range legacyControllers {
						@components.DashboardGrid(ctrl)
					}
				}
			} else {
				for _, wall := range dashboardWalls {
					<div class="card bg-base-200 shadow-xl border border-base-300 mb-6">
						<div class="flex items-end justify-between border-b border-base-300 pb-4 mb-6 p-6">
							<div>
								<h2 class="font-bold text-sm uppercase tracking-wider opacity-50">{ wall.Name }</h2>
								if wall.Description != "" {
									<p class="opacity-60 text-xs mt-1">{ wall.Description }</p>
								}
							</div>
							if user.CanConfigure() {
								<a href={ templ.SafeURL(fmt.Sprintf("/walls/%d/edit", wall.ID)) } class="btn btn-md btn-primary btn-outline gap-2">
									@icons.PencilIcon(5)
									Edit Wall
								</a>
							}
						</div>
						if len(wall.Containers) == 0 {
							<div class="text-center py-12 border-2 border-dashed border-base-300 rounded-xl opacity-50">
								<p>No containers on this wall.</p>
							</div>
						} else {
							<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 p-6">
								for _, container := range wall.Containers {
									@components.DashboardContainerCard(container)
								}
							</div>
						}
					</div>
				}
			}
		</div>
		<!-- Create Wall Modal -->
		<dialog id="create_wall_modal" class="modal">
			<div class="modal-box bg-base-100 p-0 overflow-hidden border border-base-300 shadow-2xl">
				<div class="bg-base-200 p-6 border-b border-base-300 flex justify-between items-center">
					<h3 class="font-bold text-sm uppercase tracking-wider opacity-50">Create New Wall</h3>
					<form method="dialog">
						<button class="btn btn-sm btn-circle btn-ghost">✕</button>
					</form>
				</div>
				<div class="p-6">
					<form id="create_wall_form" method="POST" action="/walls" class="space-y-6">
						<div class="form-control">
							<label class="label pt-0"><span class="label-text font-bold text-xs uppercase opacity-50 tracking-widest">Wall Name</span></label>
							<input type="text" name="name" placeholder="e.g., Garage Wall" class="input input-bordered w-full" required/>
						</div>
						<div class="form-control">
							<label class="label pt-0"><span class="label-text font-bold text-xs uppercase opacity-50 tracking-widest">Description (Optional)</span></label>
							<textarea name="description" placeholder="Main storage area in the garage." class="textarea textarea-bordered w-full h-24"></textarea>
						</div>
					</form>
					<div class="modal-action mt-8 pt-6 border-t border-base-200">
						<form method="dialog">
							<button class="btn btn-ghost">Cancel</button>
						</form>
						<button form="create_wall_form" type="submit" class="btn btn-primary px-8">Create Wall</button>
					</div>
				</div>
			</div>
		</dialog>
	}
}
