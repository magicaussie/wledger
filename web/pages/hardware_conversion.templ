package pages

import (
	"fmt"

	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
)

// ConversionView is the render model for the administrator conversion preview.
// It is deliberately decoupled from the hardware package so the pages package
// does not depend on service packages (which would create an import cycle via
// uierror).
type ConversionView struct {
	Space        string
	TotalDrawers int
	Convertible  int
	Blocked      int
	AffectedBins int
	Findings     []ConversionFindingView
	Fingerprint  string
	CSRF         string
	Result       string
}

// ConversionFindingView is one drawer's preflight result for display.
type ConversionFindingView struct {
	Name        string
	SegmentID   int64
	LedStart    int64
	LedCount    int64
	Convertible bool
	Reason      string
	Bins        []ConversionBinView
}

// ConversionBinView is one proposed bin index change for display.
type ConversionBinView struct {
	BinID int64
	From  int64
	To    int64
}

// ConversionPreview renders the administrator-only, read-only preflight for a
// drawer-relative LED coordinate conversion. It never triggers a conversion;
// the confirmation form POSTs to a CSRF-protected, admin-only endpoint.
templ ConversionPreview(user auth.User, view ConversionView) {
	@layouts.Base(i18n.T(ctx, "LedCoordinateConversion"), user) {
		<div class="max-w-5xl mx-auto w-full space-y-6" data-csrf={ view.CSRF } data-fingerprint={ view.Fingerprint }>
			<div>
				<a href="/hardware" class="btn btn-sm btn-ghost gap-2 pl-0">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
					{ i18n.T(ctx, "BackToHardware") }
				</a>
			</div>

			@components.PageHeader(i18n.T(ctx, "LedCoordinateConversion"), i18n.T(ctx, "LedCoordinateConversionDescription"), nil)

			<!-- Result feedback -->
			if view.Result == "converted" {
				<div class="alert alert-success shadow-sm">
					<span>{ i18n.T(ctx, "ConversionSuccess") }</span>
				</div>
			} else if view.Result == "already_drawer" {
				<div class="alert alert-info shadow-sm">
					<span>{ i18n.T(ctx, "ConversionAlreadyDrawer") }</span>
				</div>
			} else if view.Result == "refused" {
				<div class="alert alert-warning shadow-sm">
					<span>{ i18n.T(ctx, "ConversionRefusedNotice") }</span>
				</div>
			} else if view.Result == "stale" {
				<div class="alert alert-warning shadow-sm">
					<span>{ i18n.T(ctx, "ConversionStaleNotice") }</span>
				</div>
			} else if view.Result == "unresolved" {
				<div class="alert alert-warning shadow-sm">
					<span>{ i18n.T(ctx, "ConversionUnresolvedNotice") }</span>
				</div>
			}

			<!-- Physical equivalence notice -->
			<div class="card bg-base-100 border border-base-300 shadow-sm">
				<div class="card-body">
					<h3 class="font-bold text-sm uppercase tracking-wider opacity-50">{ i18n.T(ctx, "ConversionWhatChanges") }</h3>
					<p class="text-sm opacity-80">{ i18n.T(ctx, "PhysicalUnchangedNotice") }</p>
				</div>
			</div>

			<!-- Summary -->
			<div class="stats stats-vertical sm:stats-horizontal shadow w-full border border-base-300 bg-base-200">
				<div class="stat">
					<div class="stat-title">{ i18n.T(ctx, "CurrentCoordinateSpace") }</div>
					<div class="stat-value text-lg">{ i18n.T(ctx, coordinateSpaceLabel(view.Space)) }</div>
				</div>
				<div class="stat">
					<div class="stat-title">{ i18n.T(ctx, "TotalDrawers") }</div>
					<div class="stat-value text-2xl">{ fmt.Sprintf("%d", view.TotalDrawers) }</div>
				</div>
				<div class="stat">
					<div class="stat-title">{ i18n.T(ctx, "AffectedBins") }</div>
					<div class="stat-value text-2xl">{ fmt.Sprintf("%d", view.AffectedBins) }</div>
				</div>
				<div class="stat">
					<div class="stat-title">{ i18n.T(ctx, "ConvertibleDrawers") }</div>
					<div class="stat-value text-2xl text-success">{ fmt.Sprintf("%d", view.Convertible) }</div>
				</div>
				<div class="stat">
					<div class="stat-title">{ i18n.T(ctx, "BlockedDrawers") }</div>
					<div class="stat-value text-2xl text-error">{ fmt.Sprintf("%d", view.Blocked) }</div>
				</div>
			</div>

			if view.Space == "drawer" {
				<div class="alert alert-info shadow-sm">
					<span>{ i18n.T(ctx, "NoConversionNeeded") }</span>
				</div>
			} else if view.Space == "unresolved" {
				<div class="alert alert-warning shadow-sm">
					<span>{ i18n.T(ctx, "ConversionUnresolvedNotice") }</span>
				</div>
			} else {
				<!-- Per-drawer findings -->
				<div class="card bg-base-200 border border-base-300 shadow-xl">
					<div class="card-body">
						<h3 class="font-bold text-sm uppercase tracking-wider opacity-50 mb-2">{ i18n.T(ctx, "ConversionFindings") }</h3>
						if len(view.Findings) == 0 {
							<p class="opacity-60">{ i18n.T(ctx, "ConversionNothingToDo") }</p>
						} else {
							<div class="space-y-4">
								for _, f := range view.Findings {
									<div class="rounded-xl border border-base-300 bg-base-100 p-4">
										<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
											<div class="flex items-center gap-3">
												<span class="font-bold">{ f.Name }</span>
												<span class="badge badge-ghost badge-sm font-mono">{ i18n.T(ctx, "Segment") } { fmt.Sprintf("%d", f.SegmentID) }</span>
												<span class="badge badge-ghost badge-sm font-mono" title={ i18n.T(ctx, "LedAllocation") }>{ fmt.Sprintf("[%d,%d)", f.LedStart, f.LedStart+f.LedCount) }</span>
											</div>
											if f.Convertible {
												<span class="badge badge-success badge-outline badge-sm font-bold uppercase">{ i18n.T(ctx, "ConversionConvertible") }</span>
											} else {
												<span class="badge badge-error badge-outline badge-sm font-bold uppercase">{ i18n.T(ctx, "ConversionBlocked") }</span>
											}
										</div>
										if f.Reason != "" {
											<p class="text-sm text-error mt-2">{ i18n.T(ctx, "BlockedReason") }: { f.Reason }</p>
										}
										if len(f.Bins) > 0 {
											<div class="overflow-x-auto mt-3">
												<table class="table table-xs w-full">
													<thead>
														<tr>
															<th class="text-left">Bin</th>
															<th class="text-left">{ i18n.T(ctx, "SegmentRelativeShort") } ({ i18n.T(ctx, "SegmentRelative") })</th>
															<th class="text-left">{ i18n.T(ctx, "DrawerRelativeShort") } ({ i18n.T(ctx, "DrawerRelative") })</th>
														</tr>
													</thead>
													<tbody>
														for _, b := range f.Bins {
															<tr>
																<td class="font-mono">{ fmt.Sprintf("%d", b.BinID) }</td>
																<td class="font-mono">{ fmt.Sprintf("%d", b.From) }</td>
																<td class="font-mono">{ fmt.Sprintf("%d", b.To) }</td>
															</tr>
														}
													</tbody>
												</table>
											</div>
										}
									</div>
								}
							</div>
						}
					</div>
				</div>

				<!-- Confirmation -->
				if view.Blocked > 0 {
					<div class="alert alert-error shadow-sm">
						<span>{ i18n.T(ctx, "ConversionCannotProceed") }</span>
					</div>
				} else {
					<div class="card bg-base-200 border border-base-300 shadow-xl">
						<div class="card-body">
							<h3 class="font-bold text-sm uppercase tracking-wider opacity-50">{ i18n.T(ctx, "ConfirmConversion") }</h3>
							<form method="POST" action="/hardware/conversion" class="mt-2 space-y-4">
								<input type="hidden" name="csrf_token" value={ view.CSRF }/>
								<input type="hidden" name="fingerprint" value={ view.Fingerprint }/>
								<label class="label cursor-pointer justify-start gap-3">
									<input type="checkbox" name="confirm" value="confirm" class="checkbox checkbox-error" required/>
									<span class="label-text">{ i18n.T(ctx, "ConfirmConversionCheckbox") }</span>
								</label>
								<div class="flex justify-end">
									<button type="submit" class="btn btn-error px-8">{ i18n.T(ctx, "RunConversion") }</button>
								</div>
							</form>
						</div>
					</div>
				}
			}
		</div>
	}
}

// coordinateSpaceLabel maps a persisted coordinate space to a translation key.
func coordinateSpaceLabel(space string) string {
	switch space {
	case "segment":
		return "CoordinateSpaceSegment"
	case "drawer":
		return "CoordinateSpaceDrawer"
	case "unresolved":
		return "CoordinateSpaceUnresolved"
	default:
		return "CoordinateSpaceUnresolved"
	}
}
