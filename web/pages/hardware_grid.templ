package pages

import (
	"fmt"

	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/internal/csrf"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ HardwareGrid(user auth.User, c db.Controller, containers []db.Container, bins []db.Bin, binIndexSpace string) {
	@layouts.Base(i18n.T(ctx, "ConfigureGrid"), user) {
		<div class="mb-6">
			<a href="/hardware" class="btn btn-sm btn-ghost gap-2 pl-0">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
				{ i18n.T(ctx, "BackToHardware") }
			</a>
			<h1 class="text-3xl font-bold mt-2">{ i18n.TD(ctx, "ConfigureController", map[string]interface{}{"Name": c.Name}) }</h1>
			<p class="opacity-70">{ i18n.T(ctx, "MapLEDsToBins") }</p>
		</div>

		if user.IsAdmin() {
			<div class="card bg-base-100 border border-warning shadow-sm mb-6">
				<div class="card-body p-4">
					<h2 class="font-bold">Physical drawer Locate safety</h2>
					<p class="text-sm">Enable only after verifying the physical outputs form continuous controller-wide logical order. Saving performs read-only WLED /json/info and /json/cfg requests and fingerprints reported output starts and pins; verification fails closed if those are missing, non-contiguous, reversed, skipped, matrix-mapped, or custom-mapped. Each Locate also checks segment coverage and mode. Do not assign ranges used by another feature: WLEDger takes exclusive ownership of saved drawer ranges during Locate. Stop sends black only to those allocated ranges, and never powers off unrelated segments. The previous per-pixel color is not restored.</p>
					<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/hardware/%d/locate-mapping", c.ID)) } class="flex flex-wrap items-center gap-3">
						<input type="hidden" name="csrf_token" value={ csrf.TokenFromContext(ctx) }/>
						<label class="label cursor-pointer justify-start gap-3">
							<input type="checkbox" class="checkbox checkbox-warning" name="locate_mapping_verified" value="verified" checked={ c.LocateMappingVerified }/>
							<span>Administrator verified this controller-wide output mapping</span>
						</label>
						<label class="label cursor-pointer justify-start gap-3">
							<input type="checkbox" class="checkbox checkbox-warning" name="locate_ranges_reserved" value="reserved" checked={ c.LocateMappingVerified }/>
							<span>Administrator reserves saved drawer LED ranges exclusively for WLEDger Locate</span>
						</label>
						<button class="btn btn-sm btn-warning" type="submit">Save Locate safety setting</button>
					</form>
					<p class="text-xs">Current setting:
						if c.LocateMappingVerified {
							<strong>Output configuration snapshot saved; runtime checks it before every Locate</strong>
						} else {
							<strong>Disabled — hardware activation is blocked</strong>
						}
					</p>
				</div>
			</div>
		}

		if binIndexSpace == "unresolved" {
			<div class="alert alert-warning shadow-sm mb-6 flex-col items-start gap-2">
				<span class="font-bold">{ i18n.T(ctx, "ConversionUnresolvedGridWarning") }</span>
				<span class="text-sm">{ i18n.T(ctx, "ConversionUnresolvedGridGuidance") }</span>
			</div>
		} else if binIndexSpace == "drawer" {
			<div class="alert alert-info shadow-sm mb-6 text-sm">
				<span>{ i18n.T(ctx, "DrawerRelativeEditingNotice") }</span>
			</div>
		}

		if user.IsAdmin() && binIndexSpace == "segment" {
			<div class="mb-6 flex justify-end">
				<a href="/hardware/conversion" class="btn btn-sm btn-outline btn-primary gap-2">
					{ i18n.T(ctx, "LedCoordinateConversion") }
				</a>
			</div>
		}

		<div class="card bg-base-100 shadow-xl border border-base-300">
			<div class="card-body">
				@components.GridPainter(c, containers, bins, binIndexSpace, user.CanConfigure() && binIndexSpace != "unresolved")
			</div>
		</div>
	}
}