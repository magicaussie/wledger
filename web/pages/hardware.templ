package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"

	"github.com/tuxedocurly/wledger/internal/controllerconfig"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ Hardware(user auth.User, controllers []db.Controller, cabinets []db.Cabinet, controllerSaved bool) {
	@layouts.Base(i18n.T(ctx, "Hardware"), user) {
		@components.PageHeader(i18n.T(ctx, "Hardware"), "Create physical storage first. Controller endpoints, LED strings, wiring paths and pixel allocation are optional, separate configuration.", nil)
		<div class="mb-4"><a class="btn btn-outline" href="/hardware/led-test-centre">LED Test Centre</a></div>
		<section class="card border border-primary/30 bg-primary/5 shadow-sm mb-8">
			<div class="card-body gap-4">
				<div class="flex flex-wrap items-start justify-between gap-4">
					<div>
						<h2 class="card-title">Cabinets</h2>
						<p class="text-sm opacity-80">Build inventory locations independently: create a cabinet, add drawers and bins, then assign parts and quantities. Optional WLED wiring is configured separately.</p>
					</div>
					<div class="flex flex-wrap gap-2">
						<a class="btn btn-primary btn-sm" href="/storage/cabinets">Open Cabinets</a>
						if user.CanWrite() {
							<a class="btn btn-outline btn-sm" href="/storage/cabinets">Create Cabinet</a>
						}
					</div>
				</div>
				<div class="rounded-lg bg-base-100/70 p-3 text-sm">
					<strong>Physical-first:</strong> Create Cabinet → Add Drawers → Add Bins → Assign Inventory. <span class="ml-1">Configure controller outputs in Hardware, assign controllers to a cabinet, then map output paths and drawer pixels.</span>
				</div>
				if len(cabinets) > 0 {
					<div class="flex flex-wrap gap-2">
						for _, cabinet := range cabinets {
							<a class="badge badge-outline py-3" href={ templ.SafeURL(fmt.Sprintf("/storage/cabinets/%d/edit", cabinet.ID)) }>{ cabinet.Name }</a>
						}
					</div>
				} else {
					<p class="text-sm opacity-70">No cabinets yet. Create one to begin; drawers and their inventory identities are configured separately from electrical wiring.</p>
				}
			</div>
		</section>
		if controllerSaved {
			<div role="status" class="alert alert-success mb-4">Controller settings saved.</div>
		}
		<section aria-labelledby="controller-management-heading" class="mb-8">
			<div class="flex flex-wrap items-end justify-between gap-3 mb-3">
				<div>
					<h2 id="controller-management-heading" class="text-lg font-semibold">WLED controllers</h2>
					<p class="text-sm opacity-70">Controller settings are separate from physical cabinet, drawer and bin creation. No controller is required to manage inventory locations.</p>
				</div>
				if user.IsAdmin() {
					<div class="flex flex-wrap gap-2">
						<button onclick="import_controller_modal.showModal()" class="btn btn-outline btn-sm">Import controller config</button>
						<a href="/hardware/new" class="btn btn-primary btn-sm">Add WLED controller</a>
					</div>
				}
			</div>
			if len(controllers) == 0 {
				<div class="rounded border border-base-300 bg-base-200 p-4 text-sm">No WLED controllers configured. You can create cabinets, drawers, bins and assign inventory without one.</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					for _, c := range controllers {
						<article class="card bg-base-200 border border-base-300">
							<div class="card-body p-4">
								<div class="flex items-start justify-between gap-3">
									<div class="min-w-0">
										<h3 class="card-title text-base truncate">{ c.Name }</h3>
										<a href={ templ.SafeURL(controllerManagementURL(c)) } target="_blank" rel="noopener noreferrer" class="link link-hover text-xs font-mono break-all">{ c.IpAddress }</a>
									</div>
									<button type="button" hx-get={ fmt.Sprintf("/hardware/%d/status", c.ID) } hx-trigger="click" hx-swap="innerHTML" class="badge badge-ghost text-xs" title="Read controller status only when clicked">Check connection</button>
								</div>
								<p class="text-xs opacity-70">HTTP endpoint: <code>{ controllerManagementURL(c) }</code></p>
																	<p class="text-xs opacity-70">Type: { c.ControllerType } · Capacity: { fmt.Sprintf("%d pixels", c.LedCount) }</p>
								<div class="card-actions justify-end"><a href={ templ.SafeURL(fmt.Sprintf("/hardware/%d/wiring-designer", c.ID)) } class="btn btn-sm btn-secondary">Edit Wiring</a></div>
								if user.IsAdmin() {
									<div class="card-actions justify-end border-t border-base-content/10 pt-3">

																<a href={ templ.SafeURL(fmt.Sprintf("/hardware/%d/edit", c.ID)) } class="btn btn-sm btn-ghost">Advanced controller settings</a>
										<a href={ templ.SafeURL(fmt.Sprintf("/hardware/%d/export", c.ID)) } class="btn btn-sm btn-ghost">Export config</a>
										<form action={ templ.SafeURL(fmt.Sprintf("/hardware/%d/delete", c.ID)) } method="POST" { templ.Attributes{"onsubmit": fmt.Sprintf("return confirm('%s');", i18n.T(ctx, "ConfirmDeleteController"))}... }>
											@components.CSRFInput()
											<button class="btn btn-sm btn-ghost text-error" type="submit">Delete</button>
										</form>
									</div>
								}
							</div>
						</article>
					}
				</div>
			}
		</section>
		<section aria-labelledby="legacy-hardware-heading" class="mb-8">
			<details class="rounded-lg border border-base-300 p-3">
				<summary id="legacy-hardware-heading" class="cursor-pointer font-semibold">Advanced legacy electrical tools</summary>
				<p class="text-sm opacity-70 mt-2">Legacy containers, WLED segments and bin LED indices are not physical drawers or bins. These tools do not create physical storage locations.</p>
				if user.IsAdmin() {
					<div class="mt-3 flex flex-wrap gap-2">
						<a href="/hardware/labels" class="btn btn-outline btn-sm">Legacy electrical bin labels</a>
						for _, c := range controllers {
							<a href={ templ.SafeURL(fmt.Sprintf("/hardware/%d/grid", c.ID)) } class="btn btn-ghost btn-sm">{ c.Name } · Legacy grid</a>
						}
					</div>
				}
			</details>
		</section>

	if user.IsAdmin() {
		@components.Modal(components.ModalProps{
			ID:    "import_controller_modal",
			Title: i18n.T(ctx, "ImportConfig"),
		}) {
			<p class="text-sm opacity-70 mb-4">{ i18n.T(ctx, "ImportConfigHelp") }</p>
			<form action="/hardware/import" method="POST" enctype="multipart/form-data" class="space-y-4">
				@components.CSRFInput()
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "ConfigFile") }</span></label>
					<input type="file" name="config_file" accept=".json,application/json" class="file-input file-input-bordered w-full" required/>
				</div>
				<div class="divider text-xs opacity-50">{ i18n.T(ctx, "OptionalOverrides") }</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Name") }</span></label>
					<input type="text" name="name" placeholder={ i18n.T(ctx, "LeaveBlankToUseFile") } class="input input-bordered w-full"/>
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "IPAddress") }</span></label>
					<input type="text" name="ip_address" placeholder={ i18n.T(ctx, "LeaveBlankToUseFile") } class="input input-bordered w-full font-mono"/>
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Port") }</span></label>
					<input type="number" name="port" min="1" max="65535" step="1" placeholder={ i18n.T(ctx, "LeaveBlankToUseFile") } class="input input-bordered w-full font-mono"/>
				</div>
				<div class="modal-action">
					<button type="button" class="btn" onclick="import_controller_modal.close()">{ i18n.T(ctx, "Cancel") }</button>
					<button class="btn btn-primary">{ i18n.T(ctx, "ImportConfig") }</button>
				</div>
			</form>
		}
		}
	}
}

templ ControllerOutputEditor(settings controllerconfig.Settings) {
	<section class="rounded-lg border border-secondary/40 bg-secondary/5 p-4 space-y-4" x-data={ fmt.Sprintf("controllerOutputEditor(%q)", controllerOutputsJSON(settings.Outputs)) }>
		<input type="hidden" name="outputs_json" x-bind:value="JSON.stringify(outputs)"/>
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div><h3 class="font-semibold">Physical outputs / strings</h3><p class="text-xs opacity-70">Output totals define controller capacity. Set each output's order, pixel length, direction and physical arrangement here.</p></div>
			<div class="text-right"><strong x-text="totalPixels() + ' total pixels'"></strong><button type="button" class="btn btn-xs btn-outline ml-2" x-on:click="addOutput()">Add output</button></div>
		</div>
		<div class="flex h-14 w-full overflow-hidden rounded border border-base-content/30 bg-base-100" role="img" aria-label="Proportional controller output preview">
			<template x-for="(output, index) in outputs" x-bind:key="(output.id || 'new') + '-' + index">
				<div class="flex min-w-0 items-center justify-center border-r border-base-content/30 bg-secondary/20 px-1 text-center text-[10px]" x-bind:style="'flex-basis:' + previewWidth(output)" x-bind:title="output.name + ': ' + output.pixel_count + ' pixels, ' + output.direction + ', ' + output.pattern">
					<span class="truncate" x-text="(index + 1) + '. ' + output.name + ' · ' + output.pixel_count"></span>
				</div>
			</template>
		</div>
		<template x-if="outputs.length === 0"><p class="rounded bg-base-100 p-3 text-sm">No outputs configured. Add at least one output before assigning this controller to an electrically mapped cabinet.</p></template>
		<div class="space-y-3">
			<template x-for="(output, index) in outputs" x-bind:key="'fields-' + (output.id || 'new') + '-' + index">
				<fieldset class="rounded border border-base-300 bg-base-100 p-3 space-y-3">
					<legend class="px-1 text-xs font-semibold" x-text="'Output ' + (index + 1)"></legend>
					<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-3">
						<label class="form-control"><span class="label-text mb-1">Name</span><input class="input input-bordered input-sm" maxlength="120" x-model="output.name" required/></label>
						<label class="form-control"><span class="label-text mb-1">Pixels</span><input class="input input-bordered input-sm" type="number" min="1" step="1" x-model.number="output.pixel_count" required/></label>
						<label class="form-control"><span class="label-text mb-1">Wiring direction</span><select class="select select-bordered select-sm" x-model="output.direction"><option value="forward">Forward</option><option value="reverse">Reversed</option></select></label>
						<label class="form-control"><span class="label-text mb-1">Pattern</span><select class="select select-bordered select-sm" x-model="output.pattern"><option value="linear">Linear</option><option value="serpentine_rows">Serpentine rows</option><option value="serpentine_columns">Serpentine columns</option><option value="custom">Custom pixel order</option></select></label>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-3" x-show="output.pattern === 'serpentine_rows' || output.pattern === 'serpentine_columns' || output.pattern === 'custom'">
						<label class="form-control"><span class="label-text mb-1">Rows</span><input class="input input-bordered input-sm" type="number" min="1" step="1" x-model.number="output.rows"/></label>
						<label class="form-control"><span class="label-text mb-1">Columns</span><input class="input input-bordered input-sm" type="number" min="1" step="1" x-model.number="output.columns"/></label>
						<p class="col-span-full text-xs opacity-70" x-show="output.pattern !== 'custom'">Rows × columns must equal the output pixel count.</p>
					</div>
					<div class="space-y-2" x-show="output.pattern === 'custom'"><div class="flex flex-wrap items-end gap-2"><label class="form-control min-w-56"><span class="label-text mb-1">Generate custom wiring order</span><select class="select select-bordered select-sm" x-model="output.custom_layout"><option value="manual">Manual permutation</option><option value="row-major">Left-to-right rows</option><option value="right-to-left-rows">Independently reversed rows</option><option value="top-to-bottom-columns">Top-to-bottom columns</option><option value="bottom-to-top-columns">Bottom-to-top columns</option><option value="serpentine-rows">Serpentine rows</option><option value="serpentine-columns">Serpentine columns</option><option value="mixed">Mixed directions (manual permutation)</option></select></label><button type="button" class="btn btn-sm btn-outline" x-on:click="generateCustomOrder(output)" x-bind:disabled="output.custom_layout === 'manual' || output.custom_layout === 'mixed'">Generate order</button></div><label class="form-control"><span class="label-text mb-1">Custom zero-based pixel order</span><textarea class="textarea textarea-bordered textarea-sm font-mono" rows="2" x-model="output.custom_order_text" x-on:input="parseCustomOrder(output)" placeholder="0, 1, 2, 5, 4, 3"></textarea><span class="label-text-alt">Enter each output pixel index once, from 0 to pixel count − 1. Manual permutations support independently reversed rows/columns and arbitrary mixed directions.</span></label><p class="text-xs text-error" x-show="output.custom_order_error" x-text="output.custom_order_error"></p></div>
					<div class="rounded border border-base-300 p-2" aria-label="Exact logical to physical pixel preview">
						<p class="text-[10px] font-semibold">Exact logical pixel → physical output pixel map</p>
						<div class="mt-1 flex flex-wrap gap-1"><template x-for="pixel in previewPixels(output)" x-bind:key="pixel.logical"><span class="badge badge-outline badge-xs font-mono" x-text="pixel.logical + '→' + pixel.physical"></span></template></div>
						<div class="mt-2 flex items-center gap-2"><button type="button" class="btn btn-xs btn-ghost" x-on:click="previewPage(output, -1)" x-bind:disabled="Number(output.preview_start) === 0">Previous pixels</button><span class="text-[10px] font-mono" x-text="previewPageLabel(output)"></span><button type="button" class="btn btn-xs btn-ghost" x-on:click="previewPage(output, 1)" x-bind:disabled="Number(output.preview_start) + 40 >= Number(output.pixel_count)">Next pixels</button></div>
						<p class="mt-1 text-[10px] opacity-70" x-show="previewPending">Calculating the canonical pixel mapping…</p>
						<p class="mt-1 text-[10px] text-error" x-show="previewError" x-text="previewError"></p>
					</div>
					<div class="flex flex-wrap items-center gap-2">
						<button type="button" class="btn btn-xs btn-ghost" x-on:click="moveOutput(index, -1)" x-bind:disabled="index === 0" aria-label="Move output earlier">↑ Move earlier</button>
						<button type="button" class="btn btn-xs btn-ghost" x-on:click="moveOutput(index, 1)" x-bind:disabled="index === outputs.length - 1" aria-label="Move output later">↓ Move later</button>
						<button type="button" class="btn btn-xs btn-ghost text-error" x-on:click="removeOutput(index)">Remove output</button>
					</div>
				</fieldset>
			</template>
		</div>
		<p class="text-xs opacity-70">This saves WLEDger's output-to-cabinet mapping. It does not write electrical settings to the controller device. Verify firmware and wiring separately before enabling physical output.</p>
	</section>
}

templ HardwareControllerEdit(user auth.User, controller db.Controller, errorMessage, name, address, port string, settings controllerconfig.Settings) {
	@layouts.Base("Edit WLED Controller", user) {
		@components.PageHeader("Edit WLED Controller", "Update this controller in place. Cabinet memberships, drawer allocations, wiring, pixel mappings, bins, and stock assignments remain attached.", nil)
		<div class="mx-auto max-w-4xl card bg-base-200 shadow-xl">
			<div class="card-body">
				<p class="text-sm opacity-70">Controller record #{ controller.ID } · current endpoint <code>{ controller.IpAddress }</code></p>
				if errorMessage != "" {
					<div role="alert" class="alert alert-error"><span>{ errorMessage }</span></div>
				}
				<form action={ templ.SafeURL(fmt.Sprintf("/hardware/%d/update", controller.ID)) } method="POST" class="space-y-4">
					@components.CSRFInput()
					<div class="form-control">
						<label class="label" for="controller-name"><span class="label-text">Controller name</span></label>
						<input id="controller-name" type="text" name="name" value={ name } class="input input-bordered w-full" required/>
					</div>
					<div class="form-control">
						<label class="label" for="controller-address"><span class="label-text">IP address or hostname</span></label>
						<input id="controller-address" type="text" name="ip_address" value={ address } class="input input-bordered w-full font-mono" required autocomplete="off"/>
						<p class="label-text-alt">Enter only an IPv4/IPv6 address or DNS hostname. Do not include a scheme, path, credentials, or port.</p>
					</div>
					<div class="form-control">
						<label class="label" for="controller-port"><span class="label-text">HTTP port</span></label>
						<input id="controller-port" type="number" name="port" value={ port } min="1" max="65535" step="1" class="input input-bordered w-full font-mono" required/>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
						<label class="form-control"><span class="label-text mb-2">Controller type</span><select class="select select-bordered" name="controller_type"><option value="wled" selected?={ settings.ControllerType == "wled" }>WLED (automatic capability)</option><option value="wled-esp8266" selected?={ settings.ControllerType == "wled-esp8266" }>WLED ESP8266</option><option value="wled-esp32" selected?={ settings.ControllerType == "wled-esp32" }>WLED ESP32</option><option value="wled-compatible" selected?={ settings.ControllerType == "wled-compatible" }>WLED-compatible controller</option></select></label>
						<label class="form-control"><span class="label-text mb-2">Connection timeout (ms)</span><input class="input input-bordered" type="number" name="connection_timeout_ms" min="100" max="30000" step="100" value={ fmt.Sprintf("%d", settings.ConnectionTimeoutMS) } required/></label>
					</div>
					@ControllerOutputEditor(settings)
					<label class="label cursor-pointer justify-start gap-3 rounded border border-warning/40 p-3"><input class="checkbox checkbox-warning" type="checkbox" name="confirm_mapping_impact" value="confirm"/><span class="text-sm">I reviewed the output order/capacity preview and confirm any displayed drawer mapping impact.</span></label>
					<p class="text-sm opacity-70">Changing the address or port is blocked while a durable physical Locate may still own this controller. Output configuration is saved here; cabinet pages only manage physical path geometry and drawer allocations.</p>
					<div class="card-actions justify-end">
						<a class="btn btn-ghost" href="/hardware">Cancel</a>
						<button type="submit" class="btn btn-primary">Save controller</button>
					</div>
				</form>
			</div>
		</div>
	}
}
