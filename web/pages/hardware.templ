package pages

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"

	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
)

templ Hardware(user auth.User, controllers []db.Controller, cabinets []db.Cabinet, controllerSaved bool) {
	@layouts.Base(i18n.T(ctx, "Hardware"), user) {
		@components.PageHeader(i18n.T(ctx, "Hardware"), "Create physical storage first. Controller endpoints, LED strings, wiring paths and pixel allocation are optional, separate configuration.", nil)
		<section class="card border border-primary/30 bg-primary/5 shadow-sm mb-8">
			<div class="card-body gap-4">
				<div class="flex flex-wrap items-start justify-between gap-4">
					<div>
						<h2 class="card-title">Cabinets</h2>
						<p class="text-sm opacity-80">Build inventory locations independently: create a cabinet, add drawers and bins, then assign parts and quantities. Optional WLED wiring is configured separately.</p>
					</div>
					<div class="flex flex-wrap gap-2">
						<a class="btn btn-primary btn-sm" href="/storage/cabinets">Open Cabinets</a>
						if user.CanWrite() {
							<a class="btn btn-outline btn-sm" href="/storage/cabinets">Create Cabinet</a>
						}
					</div>
				</div>
				<div class="rounded-lg bg-base-100/70 p-3 text-sm">
					<strong>Physical-first:</strong> Create Cabinet → Add Drawers → Add Bins → Assign Inventory. <span class="ml-1">Optional electrical setup: assign WLED controllers → configure strings and wiring → map drawer pixels.</span>
				</div>
				if len(cabinets) > 0 {
					<div class="flex flex-wrap gap-2">
						for _, cabinet := range cabinets {
							<a class="badge badge-outline py-3" href={ templ.SafeURL(fmt.Sprintf("/storage/cabinets/%d/edit", cabinet.ID)) }>{ cabinet.Name }</a>
						}
					</div>
				} else {
					<p class="text-sm opacity-70">No cabinets yet. Create one to begin; drawers and their inventory identities are configured separately from electrical wiring.</p>
				}
			</div>
		</section>
		if controllerSaved {
			<div role="status" class="alert alert-success mb-4">Controller settings saved.</div>
		}
		<section aria-labelledby="controller-management-heading" class="mb-8">
			<div class="flex flex-wrap items-end justify-between gap-3 mb-3">
				<div>
					<h2 id="controller-management-heading" class="text-lg font-semibold">WLED controllers</h2>
					<p class="text-sm opacity-70">Controller settings are separate from physical cabinet, drawer and bin creation. No controller is required to manage inventory locations.</p>
				</div>
				if user.IsAdmin() {
					<div class="flex flex-wrap gap-2">
						<button onclick="import_controller_modal.showModal()" class="btn btn-outline btn-sm">Import controller config</button>
						<button onclick="add_controller_modal.showModal()" class="btn btn-primary btn-sm">Add WLED controller</button>
					</div>
				}
			</div>
			if len(controllers) == 0 {
				<div class="rounded border border-base-300 bg-base-200 p-4 text-sm">No WLED controllers configured. You can create cabinets, drawers, bins and assign inventory without one.</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					for _, c := range controllers {
						<article class="card bg-base-200 border border-base-300">
							<div class="card-body p-4">
								<div class="flex items-start justify-between gap-3">
									<div class="min-w-0">
										<h3 class="card-title text-base truncate">{ c.Name }</h3>
										<a href={ templ.SafeURL(controllerManagementURL(c)) } target="_blank" rel="noopener noreferrer" class="link link-hover text-xs font-mono break-all">{ c.IpAddress }</a>
									</div>
									<div hx-get={ fmt.Sprintf("/hardware/%d/status", c.ID) } hx-trigger="load" class="badge badge-ghost text-xs">{ i18n.T(ctx, "Checking") }</div>
								</div>
								<p class="text-xs opacity-70">HTTP endpoint: <code>{ controllerManagementURL(c) }</code></p>
								if user.IsAdmin() {
									<div class="card-actions justify-end border-t border-base-content/10 pt-3">
										<a href={ templ.SafeURL(fmt.Sprintf("/hardware/%d/edit", c.ID)) } class="btn btn-sm btn-outline">Edit controller</a>
										<a href={ templ.SafeURL(fmt.Sprintf("/hardware/%d/export", c.ID)) } class="btn btn-sm btn-ghost">Export config</a>
										<form action={ templ.SafeURL(fmt.Sprintf("/hardware/%d/delete", c.ID)) } method="POST" { templ.Attributes{"onsubmit": fmt.Sprintf("return confirm('%s');", i18n.T(ctx, "ConfirmDeleteController"))}... }>
											@components.CSRFInput()
											<button class="btn btn-sm btn-ghost text-error" type="submit">Delete</button>
										</form>
									</div>
								}
							</div>
						</article>
					}
				</div>
			}
		</section>
		<section aria-labelledby="legacy-hardware-heading" class="mb-8">
			<details class="rounded-lg border border-base-300 p-3">
				<summary id="legacy-hardware-heading" class="cursor-pointer font-semibold">Advanced legacy electrical tools</summary>
				<p class="text-sm opacity-70 mt-2">Legacy containers, WLED segments and bin LED indices are not physical drawers or bins. These tools do not create physical storage locations.</p>
				if user.IsAdmin() {
					<div class="mt-3 flex flex-wrap gap-2">
						<a href="/hardware/labels" class="btn btn-outline btn-sm">Legacy electrical bin labels</a>
						for _, c := range controllers {
							<a href={ templ.SafeURL(fmt.Sprintf("/hardware/%d/grid", c.ID)) } class="btn btn-ghost btn-sm">{ c.Name } · Legacy grid</a>
						}
					</div>
				}
			</details>
		</section>
		if user.IsAdmin() {
			@components.Modal(components.ModalProps{
				ID:    "add_controller_modal",
			Title: i18n.T(ctx, "AddNewController"),
		}) {
			<form action="/hardware" method="POST" class="space-y-4">
				@components.CSRFInput()
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Name") }</span></label>
					<input type="text" name="name" placeholder="e.g. Shelf LEDs" class="input input-bordered w-full" required/>
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "IPAddress") }</span></label>
					<input type="text" name="ip_address" placeholder="192.168.1.x" class="input input-bordered w-full font-mono" required/>
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Port") }</span></label>
					<input type="number" name="port" value="80" min="1" max="65535" step="1" required class="input input-bordered w-full font-mono"/>
				</div>

				<div class="modal-action">
					<button type="button" class="btn" onclick="add_controller_modal.close()">{ i18n.T(ctx, "Cancel") }</button>
					<button class="btn btn-primary">{ i18n.T(ctx, "AddController") }</button>
				</div>
			</form>
		}
			@components.Modal(components.ModalProps{
				ID:    "import_controller_modal",
			Title: i18n.T(ctx, "ImportConfig"),
		}) {
			<p class="text-sm opacity-70 mb-4">{ i18n.T(ctx, "ImportConfigHelp") }</p>
			<form action="/hardware/import" method="POST" enctype="multipart/form-data" class="space-y-4">
				@components.CSRFInput()
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "ConfigFile") }</span></label>
					<input type="file" name="config_file" accept=".json,application/json" class="file-input file-input-bordered w-full" required/>
				</div>
				<div class="divider text-xs opacity-50">{ i18n.T(ctx, "OptionalOverrides") }</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Name") }</span></label>
					<input type="text" name="name" placeholder={ i18n.T(ctx, "LeaveBlankToUseFile") } class="input input-bordered w-full"/>
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "IPAddress") }</span></label>
					<input type="text" name="ip_address" placeholder={ i18n.T(ctx, "LeaveBlankToUseFile") } class="input input-bordered w-full font-mono"/>
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Port") }</span></label>
					<input type="number" name="port" min="1" max="65535" step="1" placeholder={ i18n.T(ctx, "LeaveBlankToUseFile") } class="input input-bordered w-full font-mono"/>
				</div>
				<div class="modal-action">
					<button type="button" class="btn" onclick="import_controller_modal.close()">{ i18n.T(ctx, "Cancel") }</button>
					<button class="btn btn-primary">{ i18n.T(ctx, "ImportConfig") }</button>
				</div>
			</form>
		}
		}
	}
}

templ HardwareControllerEdit(user auth.User, controller db.Controller, errorMessage, name, address, port string) {
	@layouts.Base("Edit WLED Controller", user) {
		@components.PageHeader("Edit WLED Controller", "Update this controller in place. Cabinet memberships, drawer allocations, wiring, pixel mappings, bins, and stock assignments remain attached.", nil)
		<div class="mx-auto max-w-2xl card bg-base-200 shadow-xl">
			<div class="card-body">
				<p class="text-sm opacity-70">Controller record #{ controller.ID } · current endpoint <code>{ controller.IpAddress }</code></p>
				if errorMessage != "" {
					<div role="alert" class="alert alert-error"><span>{ errorMessage }</span></div>
				}
				<form action={ templ.SafeURL(fmt.Sprintf("/hardware/%d/update", controller.ID)) } method="POST" class="space-y-4">
					@components.CSRFInput()
					<div class="form-control">
						<label class="label" for="controller-name"><span class="label-text">Controller name</span></label>
						<input id="controller-name" type="text" name="name" value={ name } class="input input-bordered w-full" required/>
					</div>
					<div class="form-control">
						<label class="label" for="controller-address"><span class="label-text">IP address or hostname</span></label>
						<input id="controller-address" type="text" name="ip_address" value={ address } class="input input-bordered w-full font-mono" required autocomplete="off"/>
						<p class="label-text-alt">Enter only an IPv4/IPv6 address or DNS hostname. Do not include a scheme, path, credentials, or port.</p>
					</div>
					<div class="form-control">
						<label class="label" for="controller-port"><span class="label-text">HTTP port</span></label>
						<input id="controller-port" type="number" name="port" value={ port } min="1" max="65535" step="1" class="input input-bordered w-full font-mono" required/>
					</div>
					<p class="text-sm opacity-70">Changing the address or port is blocked while a durable physical Locate may still own this controller. A name-only change does not alter Locate recovery or mapping.</p>
					<div class="card-actions justify-end">
						<a class="btn btn-ghost" href="/hardware">Cancel</a>
						<button type="submit" class="btn btn-primary">Save controller</button>
					</div>
				</form>
			</div>
		</div>
	}
}
