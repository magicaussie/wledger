package pages

import (
	"database/sql"
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/web/components"
	"github.com/tuxedocurly/wledger/web/layouts"
	"net/url"
)

type PartView struct {
	ID          int64
	Name        string
	Description sql.NullString
	PartNumber  sql.NullString
	ImagePath   sql.NullString
	IsFavorite  sql.NullBool
	UnitCost    sql.NullFloat64
	TotalStock  int64
}

// PartsList is the full page wrapper
templ PartsList(user auth.User, parts []PartView, search string, page int) {
	@layouts.Base("Inventory", user) {
		@components.PageHeader("Inventory", "", nil)
		<div class="flex flex-col md:flex-row justify-end items-center mb-6 gap-4">
			@components.PartSearchBar(search, user.CanWrite())
		</div>
		<div id="parts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 pb-12 items-start">
			if len(parts) == 0 && page == 1 {
				@components.EmptyState("No parts found", fmt.Sprintf("We couldn't find anything matching \"%s\".", search), "📦") {
					if search != "" {
						<button onclick="document.querySelector('input[name=q]').value = ''; htmx.trigger('input[name=q]', 'input');" class="btn btn-sm btn-outline mt-4">
							Clear Search
						</button>
					}
				}
			} else {
				@PartCards(parts, search, page)
			}
		</div>
		@components.ImportModal()
	}
}

templ PartCards(parts []PartView, search string, page int) {
	// Render the cards
	for _, part := range parts {
		<a
			href={ templ.SafeURL(fmt.Sprintf("/parts/%d", part.ID)) }
			class="card bg-base-200 shadow-xl hover:shadow-2xl transition-shadow cursor-pointer block group"
		>
			<figure class="h-48 bg-base-300 relative overflow-hidden">
				if part.ImagePath.Valid && part.ImagePath.String != "" {
					<img
						src={ part.ImagePath.String }
						alt={ part.Name }
						class="object-cover w-full h-full transform transition-transform duration-500 group-hover:scale-110"
					/>
				} else {
					<div class="flex items-center justify-center w-full h-full text-4xl opacity-20 transform transition-transform duration-500 group-hover:scale-110">📷</div>
				}
			</figure>
			<div class="card-body p-4 relative z-10 bg-base-200">
				<h2 class="card-title text-base justify-between">
					<span>
						{ part.Name }
						if part.IsFavorite.Bool {
							<span class="text-warning text-xs ml-1">★</span>
						}
					</span>
					if part.TotalStock > 0 {
						@components.PartLocateButton(part.ID, "btn-sm -mr-2 -mt-1")
					}
				</h2>
				<p class="text-xs opacity-70 truncate">{ part.Description.String }</p>
				<div class="flex justify-between items-end mt-4">
					<div class="flex flex-col">
						<span class="text-s font-mono opacity-50"># { part.PartNumber.String }</span>
						<span class="badge badge- badge-info mt-1">Stock: { fmt.Sprintf("%d", part.TotalStock) }</span>
					</div>
				</div>
			</div>
		</a>
	}
	// sentinel for loading more parts
	if len(parts) >= 20 {
		<div
			hx-get={ fmt.Sprintf("/parts?page=%d&q=%s&scroll=true", page+1, url.QueryEscape(search)) }
			hx-trigger="intersect once"
			hx-swap="outerHTML"
			class="col-span-full h-12 w-full flex justify-center items-center opacity-50 text-xs"
		>
			<span class="loading loading-dots loading-lg text-primary"></span>
		</div>
	}
}
