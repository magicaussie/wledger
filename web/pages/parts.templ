package pages

import (
	"database/sql"
	"fmt"
	"github.com/tuxedocurly/wledger/internal/auth"
	"github.com/tuxedocurly/wledger/web/layouts"
	"net/url"
)

type PartView struct {
	ID          int64
	Name        string
	Description sql.NullString
	PartNumber  sql.NullString
	ImagePath   sql.NullString
	IsFavorite  sql.NullBool
	UnitCost    sql.NullFloat64
	TotalStock  any
}

// PartsList is the full page wrapper
templ PartsList(user auth.User, parts []PartView, search string, page int) {
	@layouts.Base("Inventory", user) {
		<div class="flex flex-col md:flex-row justify-between items-center mb-6 gap-4">
			<h1 class="text-3xl font-bold">Inventory</h1>
			<div class="flex gap-2 w-full md:w-auto">
				<form action="/parts" method="GET" class="join w-full md:w-auto">
					<input
						type="text"
						name="q"
						value={ search }
						class="input input-bordered join-item w-full md:w-64"
						placeholder="Search parts..."
						hx-get="/parts"
						hx-trigger="input changed delay:250ms, search"
						hx-target="#parts-grid"
						hx-select="#parts-grid"
						hx-swap="outerHTML"
						hx-push-url="true"
					/>
					<button class="btn join-item">Search</button>
				</form>
				if user.CanWrite() {
					<a href="/parts/new" class="btn btn-primary">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
						Add Part
					</a>
				}
			</div>
		</div>
		<div id="parts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 pb-12 items-start">
			if len(parts) == 0 && page == 1 {
				<div class="col-span-full">
					<div class="card bg-base-200 shadow-xl border border-base-300">
						<div class="card-body flex flex-col items-center justify-center py-16 text-center opacity-60">
							<div class="text-6xl mb-4 grayscale">📦</div>
							<h2 class="text-2xl font-bold">No parts found</h2>
							<p class="text-sm">We couldn't find anything matching "{ search }".</p>
							if search != "" {
								<button onclick="document.querySelector('input[name=q]').value = ''; htmx.trigger('input[name=q]', 'input');" class="btn btn-sm btn-outline mt-4">
									Clear Search
								</button>
							}
						</div>
					</div>
				</div>
			} else {
				@PartCards(parts, search, page)
			}
		</div>
	}
}

// PartCards renders ONLY the part cards and the next-page trigger.
templ PartCards(parts []PartView, search string, page int) {
	for _, part := range parts {
		<a href={ templ.SafeURL(fmt.Sprintf("/parts/%d", part.ID)) } class="card bg-base-200 shadow-xl hover:shadow-2xl transition-shadow cursor-pointer block group">
			<figure class="h-48 bg-base-300 relative overflow-hidden">
				if part.ImagePath.Valid && part.ImagePath.String != "" {
					<img
						src={ part.ImagePath.String }
						alt={ part.Name }
						class="object-cover w-full h-full transform transition-transform duration-500 group-hover:scale-110"
					/>
				} else {
					<div class="flex items-center justify-center w-full h-full text-4xl opacity-20 transform transition-transform duration-500 group-hover:scale-110">📷</div>
				}
			</figure>
			<div class="card-body p-4 relative z-10 bg-base-200">
				<h2 class="card-title text-base">
					{ part.Name }
					if part.IsFavorite.Bool {
						<span class="text-warning text-xs">★</span>
					}
				</h2>
				<p class="text-xs opacity-70 truncate">{ part.Description.String }</p>
				<div class="flex justify-between items-end mt-4">
					<div class="flex flex-col">
						<span class="text-s font-mono opacity-50"># { part.PartNumber.String }</span>
						<span class="badge badge-sm badge-secondary mt-1">Stock: { fmt.Sprintf("%v", part.TotalStock) }</span>
					</div>
				</div>
			</div>
		</a>
	}
	if len(parts) >= 20 {
		<div
			hx-get={ fmt.Sprintf("/parts?page=%d&q=%s&scroll=true", page+1, url.QueryEscape(search)) }
			hx-trigger="revealed"
			hx-swap="outerHTML"
			class="col-span-full py-8 flex justify-center text-primary"
		>
			<span class="loading loading-dots loading-lg"></span>
		</div>
	}
}
