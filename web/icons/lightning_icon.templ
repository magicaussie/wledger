package icons

import "fmt"

templ LightningIcon(size int) {
	<svg xmlns="http://www.w3.org/2000/svg" class={ fmt.Sprintf("w-%d h-%d", size, size) } fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
}
