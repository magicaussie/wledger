package icons

import "fmt"

templ PowerIcon(size int) {
	<svg xmlns="http://www.w3.org/2000/svg" class={ fmt.Sprintf("w-%d h-%d mr-3", size, size) } fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.636 5.636a9 9 0 1012.728 0M12 3v9"></path>
	</svg>
}
