package icons

import "fmt"

templ GripIcon(size int) {
	<svg xmlns="http://www.w3.org/2000/svg" class={ fmt.Sprintf("w-%d h-%d", size, size) } fill="none" viewBox="0 0 24 24" stroke="currentColor">
		<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8h16M4 16h16" />
	</svg>
}
