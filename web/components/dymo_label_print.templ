package components

import (
	"fmt"

	"github.com/tuxedocurly/wledger/internal/i18n"
)

// DYMO LabelWriter 550 standard label sizes (width × height in millimetres).
// Catalog numbers match the common retail rolls. Add/remove as needed.
type DymoLabelSize struct {
	ID   string
	Name string
	W    float64
	H    float64
}

var dymoSizes = []DymoLabelSize{
	{ID: "30252", Name: `1" x 1" Square`, W: 25, H: 25},
	{ID: "30335", Name: `2" x 1/2"`, W: 52, H: 13},
	{ID: "30334", Name: `2-1/16" x 1"`, W: 52, H: 25},
	{ID: "30347", Name: `2" x 1-1/4" Address`, W: 52, H: 31},
	{ID: "30336", Name: `2" x 1-1/2"`, W: 52, H: 38},
	{ID: "30346", Name: `2" x 3"`, W: 52, H: 76},
	{ID: "30345", Name: `2" x 4"`, W: 52, H: 101},
	{ID: "30329", Name: `3-1/8" x 2-1/8" Shipping`, W: 79, H: 54},
	{ID: "30328", Name: `3-1/8" x 5" Shipping`, W: 79, H: 127},
}

// DymoLabelPrint renders a printable label for a product or bin with the
// standard DYMO LabelWriter 550 label sizes. The user picks a label size, the
// QR is sized to fit, and a @page rule makes the browser print at true size.
// Pass a unique prefix for the Alpine state ids so several labels can coexist
// on one page (e.g. prefix "part-12").
templ DymoLabelPrint(prefix string, title, subtext, qrURL string) {
	<div
		x-data={ fmt.Sprintf(`dymoLabel('%s', '%s')`, prefix, qrURL) }
		class="w-full space-y-4"
	>
		<!-- Label size picker -->
		<div class="form-control w-full">
			<label class="label"><span class="label-text">{ i18n.T(ctx, "DymoLabelSize") }</span></label>
			<select
				x-model={ fmt.Sprintf("sizes[selected] == sizes[selected] && selected") }
				:value="selected"
				@change="selected = $event.target.value; onSizeChange()"
				class="select select-bordered w-full"
			>
				for i, s := range dymoSizes {
					<option value={ fmt.Sprintf("%d", i) }>{ fmt.Sprintf("%s  (%g x %g mm)", s.Name, s.W, s.H) }</option>
				}
			</select>
		</div>

		<!-- Screen preview (approximate scale) -->
		<div class="flex justify-center bg-base-300/40 rounded-lg p-4">
			<div
				class="bg-white text-black rounded-sm shadow-lg flex flex-col items-center justify-center overflow-hidden"
				:style={ fmt.Sprintf("`width:${sizes[selected].w * 3}px;height:${sizes[selected].h * 3}px;`") }
			>
				<img
					:src="qrSrc"
					alt="QR code"
					class="object-contain"
					:style="`height:${Math.min(sizes[selected].w, sizes[selected].h) * 2.4}px;`"
				/>
				<span x-show="sizes[selected].h >= 30" class="font-bold text-center leading-tight px-1" :style="`font-size:${Math.max(6, sizes[selected].w * 0.18)}px;`" x-text="title"></span>
				<span x-show="sizes[selected].h >= 30 && subtext" class="text-center font-mono leading-tight px-1 opacity-70" :style="`font-size:${Math.max(5, sizes[selected].w * 0.13)}px;`" x-text="subtext"></span>
			</div>
		</div>

		<!-- Print-only label at true physical size -->
		<div id={ fmt.Sprintf("dymo-print-%s", prefix) } x-cloak>
			<style id={ fmt.Sprintf("dymo-page-%s", prefix) } x-html="printStyle()"></style>
			<div
				class="dymo-label bg-white text-black flex flex-col items-center justify-center overflow-hidden"
				:style="`width:${sizes[selected].w}mm;height:${sizes[selected].h}mm;`"
			>
				<img :src="qrSrc" alt="QR code" class="object-contain" :style="`height:${Math.min(sizes[selected].w, sizes[selected].h) - 6}mm;`"/>
				<span x-show="sizes[selected].h >= 25" class="font-bold text-center leading-tight px-0.5 w-full" :style="`font-size:${Math.max(2.5, sizes[selected].w * 0.14)}mm;`" x-text="title"></span>
				<span x-show="sizes[selected].h >= 38 && subtext" class="text-center font-mono leading-tight px-0.5 w-full opacity-70" :style="`font-size:${Math.max(2, sizes[selected].w * 0.10)}mm;`" x-text="subtext"></span>
			</div>
		</div>

		<div class="flex justify-end gap-2">
			<button @click="doPrint()" class="btn btn-primary">{ i18n.T(ctx, "PrintLabels") }</button>
		</div>
	</div>
	<script src="/static/js/dymo_label.js"></script>
}