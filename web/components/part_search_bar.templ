package components

// PartSearchBar renders the search input and 'Add Part' button.
// It handles responsive layout (stacking on mobile, row on desktop).
templ PartSearchBar(search string, canWrite bool) {
	<div class="flex flex-col md:flex-row gap-3 w-full md:w-auto">
		<form action="/parts" method="GET" class="join w-full md:w-auto shadow-sm">
			<input
				type="search"
				name="q"
				value={ search }
				class="input input-bordered join-item w-full md:w-64"
				placeholder="Search parts..."
				hx-get="/parts"
				hx-trigger="input changed delay:250ms, search"
				hx-target="#parts-grid"
				hx-select="#parts-grid"
				hx-swap="outerHTML"
				hx-push-url="true"
			/>
		</form>
		if canWrite {
			<a href="/parts/new" class="btn btn-primary w-full md:w-auto shadow-sm gap-2">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
				Add Part
			</a>
		}
	</div>
}
