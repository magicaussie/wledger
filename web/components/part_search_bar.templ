package components

import "github.com/tuxedocurly/wledger/web/icons"
import "github.com/tuxedocurly/wledger/internal/i18n"
import "fmt"

// PartSearchBar renders the search input (with barcode/QR scan support), a
// bin-content filter, and the 'Add Part' button.
// It handles responsive layout (stacking on mobile, row on desktop).
templ PartSearchBar(search string, canWrite bool, binID *int64) {
	<div class="flex flex-col gap-3 w-full">
		<form action="/parts" method="GET" class="join w-full">
			<input
				type="search"
				name="q"
				id="scan-target-q"
				value={ search }
				class="input input-bordered join-item w-full rounded-full"
				placeholder={ i18n.T(ctx, "SearchPartsPlaceholder") }
				hx-get="/parts"
				hx-trigger="input changed delay:250ms, search"
				hx-target="#parts-grid"
				hx-select="#parts-grid"
				hx-swap="outerHTML"
				hx-push-url="true"
			/>
			<button
				type="button"
				class="btn join-item btn-square btn-outline"
				title={ i18n.T(ctx, "ScanBarcode") }
				{ templ.Attributes{"onclick": "startGlobalScanner('scan-target-q'); document.activeElement && document.activeElement.value='';"}... }
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path></svg>
			</button>
			{ "" }
		</form>
		<div class="flex flex-col md:flex-row gap-2 w-full md:w-auto">
			if binID != nil {
				<a href="/parts" class="btn btn-sm btn-ghost gap-1 text-xs opacity-70">
					@icons.X(templ.Attributes{"class": "w-3 h-3"})
					Bin #{ fmt.Sprint(*binID) }
				</a>
			}
			if canWrite {
				<div class="flex gap-2 w-full md:w-auto">
					<button onclick="import_parts_modal.showModal()" class="btn btn-outline flex-1 md:flex-none shadow-sm" title={ i18n.T(ctx, "BulkImport") }>
						@icons.Import(templ.Attributes{"class": "w-5 h-5"})
						{ i18n.T(ctx, "Import") }
					</button>
					<a href="/parts/new" class="btn btn-primary flex-1 md:flex-none shadow-sm gap-2">
						@icons.Plus(templ.Attributes{"class": "w-5 h-5"})
						{ i18n.T(ctx, "AddPart") }
					</a>
				</div>
			}
		</div>
	</div>
}