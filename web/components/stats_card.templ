package components

// StatCard renders a single statistic card.
// title: The label (e.g., "Unique Parts")
// value: The actual number/text to display
// textColor: The Tailwind class for the value color (e.g., "text-primary")
templ StatCard(title string, value string, textColor string) {
	<div class="stats shadow bg-base-200 w-full md:flex-1">
		<div class="stat place-items-center">
			<div class="stat-title text-lg font-bold text-base-content">{ title }</div>
			<div class={ "stat-value break-all " + textColor }>
				{ value }
			</div>
		</div>
	</div>
}
