package components

import (
	"fmt"

	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/icons"
)

// PartFavoriteButton renders a star toggle for a part. When the user can write,
// it is an HTMX button that flips the favorite flag in place; otherwise it is a
// static star shown only when the part is already favorited.
templ PartFavoriteButton(partID int64, isFavorite bool, canWrite bool) {
	if canWrite {
		<button
			hx-post={ fmt.Sprintf("/parts/%d/favorite", partID) }
			hx-swap="outerHTML"
			class="btn btn-ghost btn-circle btn-sm"
			title={ i18n.T(ctx, favoriteTitleKey(isFavorite)) }
			onclick="event.stopPropagation()"
		>
			@icons.Star(isFavorite, templ.Attributes{"class": starClass(isFavorite)})
		</button>
	} else if isFavorite {
		<span class="text-warning" title={ i18n.T(ctx, "Favorite") }>★</span>
	}
}

func favoriteTitleKey(isFavorite bool) string {
	if isFavorite {
		return "RemoveFromFavorites"
	}
	return "AddToFavorites"
}

func starClass(isFavorite bool) string {
	if isFavorite {
		return "w-5 h-5 text-warning"
	}
	return "w-5 h-5 opacity-40"
}
