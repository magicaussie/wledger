package components

type Breadcrumb struct {
	Label string
	URL   string
}

// PageHeader renders a standard page header with breadcrumbs, title, description, and action area.
// Actions are passed as children.
templ PageHeader(title string, description string, breadcrumbs []Breadcrumb) {
	<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
		<div>
			if len(breadcrumbs) > 0 {
				<div class="text-sm breadcrumbs opacity-50 mb-1">
					<ul>
						for _, b := range breadcrumbs {
							if b.URL != "" {
								<li><a href={ templ.SafeURL(b.URL) }>{ b.Label }</a></li>
							} else {
								<li>{ b.Label }</li>
							}
						}
					</ul>
				</div>
			}
			<h1 class="text-3xl md:text-4xl font-bold">{ title }</h1>
			if description != "" {
				<p class="text-sm md:text-lg opacity-70 mt-2">{ description }</p>
			}
		</div>
		<div class="flex gap-2">
			{ children... }
		</div>
	</div>
}
