package components

import "github.com/tuxedocurly/wledger/internal/i18n"

type ModalProps struct {
	ID         string
	Title      string
	TitleClass string // Optional: e.g. "text-warning"
	BoxClass   string // Optional: e.g. "w-11/12 max-w-5xl"
}

// Modal renders a standard DaisyUI dialog.
templ Modal(props ModalProps) {
	<dialog id={ props.ID } class="modal text-left">
		<div class={ "modal-box bg-base-100", props.BoxClass }>
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2" aria-label={ i18n.T(ctx, "Close") } title={ i18n.T(ctx, "Close") }>✕</button>
			</form>
			if props.Title != "" {
				<h3 class={ "font-bold text-lg mb-6", props.TitleClass }>{ props.Title }</h3>
			}
			{ children... }
		</div>
		<form method="dialog" class="modal-backdrop"><button>close</button></form>
	</dialog>
}
