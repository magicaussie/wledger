package components

// Modal renders a standard DaisyUI dialog.
// id: The unique ID for the dialog element.
// title: The modal title.
// boxClass: Optional classes for the modal box (e.g. "w-11/12 max-w-5xl"). Defaults to standard size.
// content: The body of the modal passed as children.
templ Modal(id string, title string, boxClass string) {
	<dialog id={ id } class="modal text-left">
		<div class={ "modal-box bg-base-100", boxClass }>
			<form method="dialog">
				<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
			</form>
			if title != "" {
				<h3 class="font-bold text-lg mb-6">{ title }</h3>
			}
			{ children... }
		</div>
		<form method="dialog" class="modal-backdrop"><button>close</button></form>
	</dialog>
}
