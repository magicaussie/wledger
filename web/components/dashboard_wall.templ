package components

import (
	"fmt"
	"sort"
	"github.com/tuxedocurly/wledger/internal/i18n"
)

templ DashboardContainerCard(container DashboardContainer) {
	<div x-data="{ open() { $refs.modal.showModal() } }" class="h-full">
		<button
			type="button"
			class="card h-full w-full text-left bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-all duration-300 cursor-pointer group overflow-hidden"
			@click="open()"
			aria-haspopup="dialog"
			aria-label={ i18n.TD(ctx, "OpenContainer", map[string]interface{}{"Name": container.Name}) }
		>
			<span class="card-body p-5">
				<span class="flex min-w-0 justify-between items-start gap-2 mb-2">
					<span class="flex min-w-0 flex-1 flex-col">
						<span class="block truncate font-bold text-sm uppercase tracking-wider opacity-50 group-hover:opacity-100 transition-opacity" title={ container.Name }>{ container.Name }</span>
						<span class="block truncate text-[12px] opacity-40 uppercase tracking-widest" title={ container.ControllerName }>{ container.ControllerName } • { i18n.T(ctx, "Segment") } { fmt.Sprintf("%d", container.SegmentID) }</span>
					</span>
					<span class={ "badge badge-xs shrink-0", templ.KV("badge-success", container.ControllerOnline), templ.KV("badge-error", !container.ControllerOnline) }></span>
				</span>
				<span class="flex items-center gap-4 mt-4 bg-base-200 p-3 rounded-lg border border-base-300 shadow-inner">
					<!-- Stock Health Indicator (Color Wheel Style) -->
					@StockHealthIndicator(container.Bins)
					<span class="flex flex-col">
						<span class="text-2xl font-black leading-none">{ fmt.Sprintf("%d", len(container.Bins)) }</span>
						<span class="text-xs opacity-50 uppercase font-bold tracking-tighter">{ i18n.T(ctx, "TotalBins") }</span>
					</span>
				</span>
			</span>
		</button>
		<!-- Grid Preview Modal -->
		<dialog x-ref="modal" class="modal modal-bottom sm:modal-middle" @click.stop>
			<div class="modal-box max-w-4xl p-0 border border-base-300 shadow-2xl bg-base-100">
				<div class="bg-base-200 p-6 border-b border-base-300 flex flex-wrap gap-2 justify-between items-start">
					<div class="min-w-0">
						<h3 class="truncate font-bold text-md uppercase tracking-wider" title={ container.Name }>{ container.Name }</h3>
						<div class="flex flex-wrap gap-x-4 gap-y-1 text-sm opacity-80 uppercase tracking-widest mt-1">
							<span>{ i18n.T(ctx, "Controller") }: { container.ControllerName }</span>
							<span>{ i18n.T(ctx, "Segment") }: { fmt.Sprintf("%d", container.SegmentID) }</span>
							<span>
								if container.ControllerOnline {
									<span class="text-success font-bold">{ i18n.T(ctx, "Online") }</span>
								} else {
									<span class="text-error font-bold">{ i18n.T(ctx, "Offline") }</span>
								}
							</span>
						</div>
					</div>
					<form method="dialog" class="shrink-0">
						<button type="submit" class="btn btn-sm btn-circle btn-ghost" aria-label={ i18n.T(ctx, "Close") }>✕</button>
					</form>
				</div>
				<div class="p-6">
					<div class="overflow-x-auto bg-base-200/50 rounded-xl border border-base-300 p-4 shadow-inner">
						if len(container.Bins) == 0 {
							<p class="py-6 text-center text-sm opacity-70">{ i18n.T(ctx, "NoBinsMapped") }</p>
						} else {
							<div class="grid gap-1.5 p-1 mx-auto" style="width: fit-content; min-width: 100%;">
								for _, bin := range container.Bins {
									<a
										href={ templ.SafeURL(fmt.Sprintf("/parts?bin=%d", bin.ID)) }
										class={ "w-12 h-12 min-w-0 overflow-hidden rounded-md border border-base-300 flex items-center justify-center text-xs font-bold shadow-sm hover:scale-110 hover:shadow-md hover:z-10 hover:border-base-content/50 transition-all duration-200 cursor-pointer " + bin.GetClass() }
										style={ bin.GetStyle() }
										title={ bin.Name }
										aria-label={ bin.Name }
									>
										<span class="block max-w-full px-1 truncate text-center leading-tight drop-shadow-md filter invert-0 grayscale-0 brightness-100">{ bin.Name }</span>
									</a>
								}
							</div>
						}
					</div>
					<div class="modal-action justify-between items-center mt-6 pt-6 border-t border-base-200">
						<div class="flex gap-4 text-sm font-bold uppercase tracking-wider">
							<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-success"></div>{ i18n.T(ctx, "LegendOK") }</div>
							<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-warning"></div>{ i18n.T(ctx, "LegendLow") }</div>
							<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-error"></div>{ i18n.T(ctx, "LegendCritical") }</div>
							<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-base-200 border border-base-300"></div>{ i18n.T(ctx, "LegendEmpty") }</div>
						</div>
					</div>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop"><button type="submit">close</button></form>
		</dialog>
	</div>
}

templ StockHealthIndicator(bins []DashboardBin) {
	{{
		unique := make(map[string]bool)
		for _, b := range bins {
			for _, s := range b.Statuses {
				if s != "" {
					unique[s] = true
				}
			}
		}
		var keys []string
		for k := range unique {
			keys = append(keys, k)
		}
		sort.Strings(keys)

		classes := "w-14 h-14 rounded-full border border-base-300 shadow-inner flex items-center justify-center overflow-hidden"
		style := ""

		if len(keys) == 0 {
			classes += " bg-base-200"
		} else if len(keys) == 1 {
			switch keys[0] {
			case "critical":
				classes += " bg-error"
			case "low":
				classes += " bg-warning"
			case "ok":
				classes += " bg-success"
			}
		} else {
			colorMap := map[string]string{
				"critical": "var(--color-error)",
				"low":      "var(--color-warning)",
				"ok":       "var(--color-success)",
			}

			if len(keys) == 2 {
				c1 := colorMap[keys[0]]
				c2 := colorMap[keys[1]]
				style = fmt.Sprintf("background: linear-gradient(135deg, %s 50%%, %s 50%%);", c1, c2)
			} else if len(keys) >= 3 {
				c1 := colorMap[keys[0]]
				c2 := colorMap[keys[1]]
				c3 := colorMap[keys[2]]
				style = fmt.Sprintf("background: conic-gradient(%s 0deg 120deg, %s 120deg 240deg, %s 240deg 360deg);", c1, c2, c3)
			}
		}
	}}
	<span class={ classes } style={ style }></span>
}
