package components

import (
	"fmt"
	"sort"
)

templ DashboardContainerCard(container DashboardContainer) {
	<div
		class="card bg-base-200 shadow-xl border border-base-300 hover:shadow-2xl transition-all duration-300 cursor-pointer group overflow-hidden"
		@click={ fmt.Sprintf("document.getElementById('container_modal_%d').showModal()", container.ID) }
	>
		<div class="card-body p-5">
			<div class="flex justify-between items-start mb-2">
				<div class="flex flex-col">
					<h2 class="font-bold text-sm uppercase tracking-wider opacity-50 group-hover:opacity-100 transition-opacity">{ container.Name }</h2>
					<span class="text-[12px] opacity-40 uppercase tracking-widest">{ container.ControllerName } • Segment { fmt.Sprintf("%d", container.SegmentID) }</span>
				</div>
				<div class={ "badge badge-xs", templ.KV("badge-success", container.ControllerOnline), templ.KV("badge-error", !container.ControllerOnline) }></div>
			</div>
			<div class="flex items-center gap-4 mt-4 bg-base-100 p-3 rounded-lg border border-base-300 shadow-inner">
				<!-- Stock Health Indicator (Color Wheel Style) -->
				@StockHealthIndicator(container.Bins)
				<div class="flex flex-col">
					<span class="text-2xl font-black leading-none">{ fmt.Sprintf("%d", len(container.Bins)) }</span>
					<span class="text-[10px] opacity-50 uppercase font-bold tracking-tighter">Total Bins</span>
				</div>
			</div>
		</div>
		<!-- Grid Preview Modal -->
		<dialog id={ fmt.Sprintf("container_modal_%d", container.ID) } class="modal modal-bottom sm:modal-middle">
			<div class="modal-box max-w-4xl p-0 overflow-hidden border border-base-300 shadow-2xl bg-base-100">
				<div class="bg-base-200 p-6 border-b border-base-300 flex justify-between items-center">
					<div>
						<h3 class="font-bold text-md uppercase tracking-wider">{ container.Name }</h3>
						<div class="flex gap-4 text-sm opacity-80 uppercase tracking-widest mt-1">
							<span>Controller: { container.ControllerName }</span>
							<span>Segment: { fmt.Sprintf("%d", container.SegmentID) }</span>
							<span>
								if container.ControllerOnline {
									<span class="text-success font-bold">Online</span>
								} else {
									<span class="text-error font-bold">Offline</span>
								}
							</span>
						</div>
					</div>
					<form method="dialog">
						<button class="btn btn-sm btn-circle btn-ghost">✕</button>
					</form>
				</div>
				<div class="p-6">
					<div class="overflow-x-auto bg-base-200/50 rounded-xl border border-base-300 p-4 shadow-inner">
						<div class="grid gap-1.5 p-1 mx-auto" style="width: fit-content; min-width: 100%;">
							for _, bin := range container.Bins {
								<a
									href={ templ.SafeURL(fmt.Sprintf("/parts?bin=%d", bin.ID)) }
									class={ "w-12 h-12 rounded-md border border-base-300 flex items-center justify-center text-xs font-bold shadow-sm hover:scale-110 hover:shadow-md hover:z-10 hover:border-base-content/50 transition-all duration-200 cursor-pointer " + bin.GetClass() }
									style={ bin.GetStyle() }
									title={ bin.Name }
								>
									<span class="drop-shadow-md filter invert-0 grayscale-0 brightness-100">{ bin.Name }</span>
								</a>
							}
						</div>
					</div>
					<div class="modal-action justify-between items-center mt-6 pt-6 border-t border-base-200">
						<div class="flex gap-4 text-sm font-bold uppercase tracking-wider">
							<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-success"></div>OK</div>
							<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-warning"></div>Low</div>
							<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-error"></div>Critical</div>
							<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-base-200 border border-base-300"></div>Empty</div>
						</div>
					</div>
				</div>
			</div>
		</dialog>
	</div>
}

templ StockHealthIndicator(bins []DashboardBin) {
	{{
		unique := make(map[string]bool)
		for _, b := range bins {
			for _, s := range b.Statuses {
				if s != "" {
					unique[s] = true
				}
			}
		}
		var keys []string
		for k := range unique {
			keys = append(keys, k)
		}
		sort.Strings(keys)

		classes := "w-14 h-14 rounded-full border border-500/10 border-base-300 shadow-inner flex items-center justify-center overflow-hidden"
		style := ""

		if len(keys) == 0 {
			classes += " bg-base-200"
		} else if len(keys) == 1 {
			switch keys[0] {
			case "critical":
				classes += " bg-error"
			case "low":
				classes += " bg-warning"
			case "ok":
				classes += " bg-success"
			}
		} else {
			colorMap := map[string]string{
				"critical": "var(--color-error)",
				"low":      "var(--color-warning)",
				"ok":       "var(--color-success)",
			}

			if len(keys) == 2 {
				c1 := colorMap[keys[0]]
				c2 := colorMap[keys[1]]
				style = fmt.Sprintf("background: linear-gradient(135deg, %s 50%%, %s 50%%);", c1, c2)
			} else if len(keys) >= 3 {
				c1 := colorMap[keys[0]]
				c2 := colorMap[keys[1]]
				c3 := colorMap[keys[2]]
				style = fmt.Sprintf("background: conic-gradient(%s 0deg 120deg, %s 120deg 240deg, %s 240deg 360deg);", c1, c2, c3)
			}
		}
	}}
	<div class={ classes } style={ style }></div>
}
