package components

import (
	"fmt"
	"sort"
)

templ DashboardContainerCard(container DashboardContainer) {
	<div
		class="card bg-base-100 shadow-xl border border-base-300 hover:shadow-2xl transition-all duration-300 cursor-pointer group"
		@click={ fmt.Sprintf("document.getElementById('container_modal_%d').showModal()", container.ID) }
	>
		<div class="card-body p-5">
			<div class="flex justify-between items-start mb-2">
				<div class="flex flex-col">
					<h2 class="card-title text-base group-hover:text-primary transition-colors">{ container.Name }</h2>
					<span class="text-[10px] opacity-50 uppercase tracking-wider">{ container.ControllerName } • Segment { fmt.Sprintf("%d", container.SegmentID) }</span>
				</div>
				<div class={ "badge badge-xs", templ.KV("badge-success", container.ControllerOnline), templ.KV("badge-error", !container.ControllerOnline) }></div>
			</div>
			<div class="flex items-center gap-4 mt-4">
				<!-- Stock Health Indicator (Color Wheel Style) -->
				@StockHealthIndicator(container.Bins)
				<div class="flex flex-col">
					<span class="text-2xl font-bold leading-none">{ fmt.Sprintf("%d", len(container.Bins)) }</span>
					<span class="text-[10px] opacity-50 uppercase font-bold">Bins</span>
				</div>
			</div>
		</div>
		<!-- Grid Preview Modal -->
		<dialog id={ fmt.Sprintf("container_modal_%d", container.ID) } class="modal modal-bottom sm:modal-middle">
			<div class="modal-box max-w-4xl">
				<form method="dialog">
					<button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
				</form>
				<h3 class="font-bold text-lg mb-4">{ container.Name }</h3>
				<div class="mb-6 flex gap-4 text-xs opacity-70 border-b border-base-300 pb-4">
					<div class="flex items-center gap-2"><span class="font-semibold">Controller:</span> { container.ControllerName }</div>
					<div class="flex items-center gap-2"><span class="font-semibold">Segment:</span> { fmt.Sprintf("%d", container.SegmentID) }</div>
					<div class="flex items-center gap-2">
						<span class="font-semibold">Status:</span>
						if container.ControllerOnline {
							<span class="text-success font-bold uppercase text-[10px]">Online</span>
						} else {
							<span class="text-error font-bold uppercase text-[10px]">Offline</span>
						}
					</div>
				</div>
				<div class="overflow-x-auto">
					<div class="grid gap-1.5 p-1 mx-auto" style="width: fit-content; min-width: 100%;">
						for _, bin := range container.Bins {
							<a
								href={ templ.SafeURL(fmt.Sprintf("/parts?bin=%d", bin.ID)) }
								class={ "w-12 h-12 rounded-md border border-base-300/50 flex items-center justify-center text-xs font-bold shadow-sm hover:scale-110 hover:shadow-md hover:z-10 hover:border-base-content/50 transition-all duration-200 cursor-pointer " + bin.GetClass() }
								style={ bin.GetStyle() }
								title={ bin.Name }
							>
								<span class="drop-shadow-md filter invert-0 grayscale-0 brightness-100">{ bin.Name }</span>
							</a>
						}
					</div>
				</div>
				<div class="modal-action justify-between items-center">
					<div class="flex gap-4 text-[10px] opacity-70">
						<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-success"></div>OK</div>
						<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-warning"></div>Low</div>
						<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-error"></div>Crit</div>
						<div class="flex items-center gap-1.5"><div class="w-2.5 h-2.5 rounded-full bg-base-200 border border-base-300"></div>Empty</div>
					</div>
					<form method="dialog">
						<button class="btn btn-sm">Close</button>
					</form>
				</div>
			</div>
			<form method="dialog" class="modal-backdrop">
				<button>close</button>
			</form>
		</dialog>
	</div>
}

templ StockHealthIndicator(bins []DashboardBin) {
	{{
		unique := make(map[string]bool)
		for _, b := range bins {
			for _, s := range b.Statuses {
				if s != "" {
					unique[s] = true
				}
			}
		}
		var keys []string
		for k := range unique {
			keys = append(keys, k)
		}
		sort.Strings(keys)

		classes := "w-14 h-14 rounded-full border border-base-300 shadow-inner flex items-center justify-center overflow-hidden"
		style := ""

		if len(keys) == 0 {
			classes += " bg-base-200"
		} else if len(keys) == 1 {
			switch keys[0] {
			case "critical":
				classes += " bg-error"
			case "low":
				classes += " bg-warning"
			case "ok":
				classes += " bg-success"
			}
		} else {
			colorMap := map[string]string{
				"critical": "var(--color-error)",
				"low":      "var(--color-warning)",
				"ok":       "var(--color-success)",
			}

			if len(keys) == 2 {
				c1 := colorMap[keys[0]]
				c2 := colorMap[keys[1]]
				style = fmt.Sprintf("background: linear-gradient(135deg, %s 50%%, %s 50%%);", c1, c2)
			} else if len(keys) >= 3 {
				c1 := colorMap[keys[0]]
				c2 := colorMap[keys[1]]
				c3 := colorMap[keys[2]]
				style = fmt.Sprintf("background: conic-gradient(%s 0deg 120deg, %s 120deg 240deg, %s 240deg 360deg);", c1, c2, c3)
			}
		}
	}}
	<div class={ classes } style={ style }></div>
}
