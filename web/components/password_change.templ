package components

templ ChangePasswordForm(actionURL string, showCurrentPassword bool) {
	<form action={ templ.SafeURL(actionURL) } method="POST" class="space-y-6 max-w-md">
		if showCurrentPassword {
			<div class="form-control">
				<label class="label"><span class="label-text">Current Password</span></label>
				<input type="password" name="current_password" class="input input-bordered w-full" required/>
			</div>
		}
		<div class="form-control">
			<label class="label"><span class="label-text">New Password</span></label>
			<input
				type="password"
				name="new_password"
				id="new_password"
				class="input input-bordered w-full validator"
				required
				minlength="8"
				placeholder="••••••••"
				pattern=".{8,}"
				title="Must be at least 8 characters"
			/>
			<p class="validator-hint text-xs text-error mt-1">Must be at least 8 characters</p>
		</div>
		<div class="form-control">
			<label class="label"><span class="label-text">Confirm New Password</span></label>
			<input
				type="password"
				name="confirm_password"
				class="input input-bordered w-full validator"
				required
				minlength="8"
				placeholder="Re-enter password"
				oninput="this.setCustomValidity(this.value != document.getElementById('new_password').value ? 'Passwords do not match' : '')"
			/>
			<p class="validator-hint text-xs text-error mt-1">Passwords do not match</p>
		</div>
		<div class="pt-4">
			<button class="btn btn-secondary w-full">Update Password</button>
		</div>
	</form>
}
