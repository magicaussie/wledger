package components

templ BinPickerGrid(ctrl DashboardController) {
	<div
		x-data="{ selectedBinID: '' }"
		@bin-selected.stop="selectedBinID = $event.detail.id; $dispatch('bin-selected-form', {id: $event.detail.id})"
		class="space-y-8"
		x-init="window.pickerReady()"
	>
		<input type="hidden" name="bin_id" :value="selectedBinID" required />
		
		if len(ctrl.Containers) == 0 {
			<div class="text-center py-12 opacity-50 border-2 border-dashed border-base-300 rounded-xl">
				<p class="text-lg font-medium">No containers configured</p>
				<p class="text-sm">This controller has no containers or mapped bins.</p>
			</div>
		} else {
			<div class="grid grid-cols-1 gap-8">
				for _, container := range ctrl.Containers {
					@BinPickerCard(container)
				}
			</div>

			<!-- Legend -->
			<div class="flex flex-wrap justify-center gap-4 mt-4 pt-6 border-t border-base-300">
				<div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider opacity-60">
					<div class="w-3 h-3 rounded-md bg-success"></div> OK
				</div>
				<div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider opacity-60">
					<div class="w-3 h-3 rounded-md bg-warning"></div> Low
				</div>
				<div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider opacity-60">
					<div class="w-3 h-3 rounded-md bg-error"></div> Critical
				</div>
				<div class="flex items-center gap-2 text-[10px] font-bold uppercase tracking-wider opacity-60">
					<div class="w-3 h-3 rounded-md bg-base-200 border border-base-300"></div> Empty
				</div>
			</div>
		}
	</div>
}
