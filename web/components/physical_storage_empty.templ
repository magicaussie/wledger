package components

import "github.com/tuxedocurly/wledger/web/icons"

// PhysicalStorageEmptyState reuses the shared empty card with a real icon.
templ PhysicalStorageEmptyState(title string, description string) {
	<div class="col-span-full" data-empty-state="physical-storage">
		<div class="card bg-base-200 shadow-xl border border-base-300">
			<div class="card-body flex flex-col items-center justify-center py-16 text-center">
				<div class="mb-4 grayscale">
					@icons.Box(templ.Attributes{"class": "w-12 h-12"})
				</div>
				<h2 class="text-2xl font-bold">{ title }</h2>
				<p class="text-sm">{ description }</p>
			</div>
		</div>
	</div>
}
