package components

import (
	"fmt"

	"github.com/tuxedocurly/wledger/internal/i18n"
)

// MoveStockModal renders a reusable modal for moving or fixing stock assignments.
// A scan context keeps all scans in the open transfer and validates stable source/product identities.
templ MoveStockModal(modalID string, title string, message string, actionURL string, quantity int64, partID int64, sourceBinID int64) {
	@Modal(ModalProps{
		ID:         modalID,
		Title:      title,
		TitleClass: "text-base-content",
		BoxClass:   "max-w-2xl",
	}) {
		<p class="text-sm text-base-content/80 mb-6">
			{ message }
		</p>
		<div
			x-data={ fmt.Sprintf("stockMoveScan('%s', %d, %d)", modalID, partID, sourceBinID) }
			x-init="init()"
			@bin-selected-form="hasSelection = true; selectedBinID = String($event.detail.id)"
		>
			<form
				id={ fmt.Sprintf("%s_form", modalID) }
				action={ templ.SafeURL(actionURL) }
				method="POST"
				class="space-y-6"
				onsubmit="return confirm('Confirm moving this stock to the selected bin?')"
			>
				@CSRFInput()
				<input id={ fmt.Sprintf("stock_move_scan_input_%s", modalID) } type="text" class="sr-only" tabindex="-1" aria-hidden="true"/>
				<div class="rounded-lg border border-base-300 bg-base-200/40 p-3 space-y-2" role="status" aria-live="polite">
					<p x-text="instruction()" class="text-sm font-medium"></p>
					<p x-show="error" x-text="error" class="text-sm text-error" role="alert"></p>
					<div class="flex flex-wrap gap-2">
						<button type="button" class="btn btn-sm btn-outline" { templ.Attributes{"onclick": fmt.Sprintf("startGlobalScanner('stock_move_scan_input_%s')", modalID)}... }>Scan with camera</button>
						<button type="button" class="btn btn-sm btn-ghost" @click="useManualSelection()">Use manual destination selection</button>
					</div>
				</div>
				<div class="form-control w-full">
					<span
						id={ fmt.Sprintf("%s_bin_picker_heading", modalID) }
						class="label-text font-bold text-xs uppercase tracking-widest block pt-0 pb-2"
					>
						{ i18n.T(ctx, "M6ChooseNewPhysicalBin") }
					</span>
					<div
						id={ fmt.Sprintf("%s_visual_bin_picker", modalID) }
						role="group"
						aria-labelledby={ fmt.Sprintf("%s_bin_picker_heading", modalID) }
						class="min-h-[200px] border-2 border-dashed border-base-300 rounded-xl bg-base-200/30 p-4"
						hx-get="/storage/bin_picker"
						hx-trigger="load"
						hx-swap="innerHTML"
					>
						<div class="text-center text-base-content/80 py-12">
							<p class="text-sm">{ i18n.T(ctx, "M6LoadingBins") }</p>
						</div>
					</div>
				</div>
			</form>

			<div class="modal-action border-t border-base-200 pt-6 mt-8">
				<form method="dialog">
					<button class="btn btn-ghost">{ i18n.T(ctx, "Cancel") }</button>
				</form>
				<button
					form={ fmt.Sprintf("%s_form", modalID) }
					type="submit"
					class="btn btn-primary px-8"
					:disabled="!canSubmit"
				>
					{ i18n.T(ctx, "M6MoveStock") }
				</button>
			</div>
		</div>
	}
}
