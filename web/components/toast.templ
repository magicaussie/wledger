package components

type ToastType string

const (
	ToastInfo    ToastType = "alert-info"
	ToastSuccess ToastType = "alert-success"
	ToastWarning ToastType = "alert-warning"
	ToastError   ToastType = "alert-error"
)

type ToastProps struct {
	Message string
	Type    ToastType
}

// Toast renders a DaisyUI alert to be used within a toast container.
// It uses Alpine.js for auto-dismissing after 5 seconds.
templ Toast(props ToastProps) {
	<div
		id="toast-container"
		hx-swap-oob="beforeend"
	>
		<div
			x-data="{ show: true }"
			x-init="setTimeout(() => $el.remove(), 5000)"
			x-show="show"
			x-transition:leave="transition ease-in duration-300"
			x-transition:leave-start="opacity-100 scale-100"
			x-transition:leave-end="opacity-0 scale-90"
			class={ "alert shadow-lg mb-2", string(props.Type) }
		>
			<span>{ props.Message }</span>
			<button class="btn btn-ghost btn-xs btn-circle" @click="$el.parentElement.remove()">✕</button>
		</div>
	</div>
}
