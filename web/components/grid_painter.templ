package components

import (
	"fmt"
	"github.com/tuxedocurly/wledger/internal/db"
	"github.com/tuxedocurly/wledger/internal/i18n"
	"github.com/tuxedocurly/wledger/web/icons"
)

// GridPainter renders the interactive LED mapping tool with Linear, Grid, and Compound support.
templ GridPainter(controller db.Controller, containers []db.Container, bins []db.Bin, canEdit bool) {
	@templ.JSONScript("grid-bins-data", bins)
	@templ.JSONScript("grid-containers-data", containers)
	<div
		x-data={ fmt.Sprintf(`gridPainter(%d, 'grid-bins-data', 'grid-containers-data', %t)`, 
        controller.ID, 
        canEdit) }
		class="w-full"
	>
		if canEdit {
			<div class="flex flex-col lg:flex-row gap-8 mb-12">
				<!-- Container List -->
				<div class="lg:w-1/3">
					<div class="flex items-center justify-between mb-4 px-1">
						<h3 class="font-bold text-sm uppercase tracking-wider opacity-50">{ i18n.T(ctx, "Containers") }</h3>
						<button @click="addContainer()" class="btn btn-md btn-primary">
							@icons.Plus(templ.Attributes{"class": "w-5 h-5"})
							{ i18n.T(ctx, "AddContainer") }
						</button>
					</div>
					<div
						class="flex flex-col gap-2 max-h-[600px] overflow-y-auto pr-2 bg-base-200 p-3 rounded-xl border border-base-300 shadow-inner"
					>
						<template x-for="(container, idx) in containers" :key="idx">
							<div
								class="p-4 rounded-lg border border-base-300 cursor-pointer transition-all duration-200 flex items-center justify-between group"
								:class="selectedContainerIndex === idx ? 'bg-base-100 border-primary shadow-md ring-1 ring-primary/20' : 'bg-base-100/50 hover:bg-base-100 hover:border-base-content/20'"
								@click="selectedContainerIndex = idx"
							>
								<div class="flex flex-col gap-1">
									<span class="font-bold text-sm" :class="selectedContainerIndex === idx ? 'text-primary' : ''" x-text="container.name"></span>
									<span class="text-xs uppercase font-bold opacity-40 tracking-widest" x-text={ fmt.Sprintf("'%s ' + container.segment_id + ' • ' + container.config.type", i18n.T(ctx, "Segment")) }></span>
								</div>
								<button @click.stop="removeContainer(idx)" class="btn btn-ghost btn-sm text-error btn-square hover:bg-error/10">
									@icons.X(templ.Attributes{"class": "w-5 h-5"})
								</button>
							</div>
						</template>
					</div>
				</div>
				<!-- Selected Container Editor -->
				<div class="lg:w-2/3">
					<div x-show="containers.length > 0" class="card bg-base-200 border border-base-300 shadow-xl h-full">
						<div class="card-body p-0 gap-0">
							<!-- Header -->
							<div class="bg-base-300/50 p-6 border-b border-base-300 flex justify-between items-center rounded-t-xl">
								<h3 class="font-bold text-sm uppercase tracking-wider opacity-50">{ i18n.T(ctx, "EditContainer") }</h3>
								<div class="badge badge-neutral font-mono text-xs" x-text="'ID: ' + (currentContainer.id || 'NEW')"></div>
							</div>
							<div class="p-6 space-y-8">
								<!-- Basic Info -->
								<fieldset class="fieldset w-full bg-base-100 p-6 rounded-xl border border-base-300 shadow-sm">
									<legend class="fieldset-legend font-bold text-sm uppercase tracking-widest opacity-40">{ i18n.T(ctx, "BasicInformation") }</legend>
									<div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
										<div class="form-control w-full">
											<label class="label pt-0"><span class="label-text font-bold text-sm mb-2">{ i18n.T(ctx, "Name") }</span></label>
											<input type="text" x-model="currentContainer.name" class="input input-bordered w-full input-md"/>
										</div>
										<div class="form-control w-full">
											<label class="label pt-0"><span class="label-text font-bold text-sm mb-2">{ i18n.T(ctx, "WledSegmentId") }</span></label>
											<input type="number" x-model.number="currentContainer.segment_id" class="input input-bordered w-full input-md" min="0"/>
										</div>
									</div>
								</fieldset>
								<!-- Configuration -->
								<fieldset class="fieldset w-full bg-base-100 p-6 rounded-xl border border-base-300 shadow-sm">
									<legend class="fieldset-legend font-bold text-sm uppercase tracking-widest opacity-40">{ i18n.T(ctx, "GridConfiguration") }</legend>
									<div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
										<div class="form-control w-full">
											<label class="label pt-0"><span class="label-text font-bold text-sm mb-2">{ i18n.T(ctx, "LayoutType") }</span></label>
											<select x-model="currentContainer.config.type" class="select select-bordered w-full select-md">
												<option value="linear">{ i18n.T(ctx, "LinearStrip") }</option>
												<option value="grid">{ i18n.T(ctx, "Matrix") }</option>
												<option value="compound">{ i18n.T(ctx, "Compound") }</option>
											</select>
										</div>
										<div class="form-control w-full">
											<label class="label pt-0"><span class="label-text font-bold text-sm mb-2">{ i18n.T(ctx, "DataStartPosition") }</span></label>
											<select x-model="currentContainer.config.start_corner" class="select select-bordered w-full select-md">
												<option value="tl">{ i18n.T(ctx, "TopLeft") }</option>
												<option value="tr">{ i18n.T(ctx, "TopRight") }</option>
												<option value="bl">{ i18n.T(ctx, "BottomLeft") }</option>
												<option value="br">{ i18n.T(ctx, "BottomRight") }</option>
											</select>
										</div>
									</div>
									<!-- Dynamic Dimensions -->
									<div class="mt-6 pt-6 border-t border-base-200">
										<!-- Linear -->
										<div x-show="currentContainer.config.type === 'linear'">
											<div class="form-control w-full">
												<label class="label pt-0"><span class="label-text font-bold text-sm mb-2">{ i18n.T(ctx, "TotalLeds") }</span></label>
												<input type="number" x-model.number="currentContainer.config.total" class="input input-bordered w-full input-md" min="1"/>
											</div>
										</div>
										<!-- Grid -->
										<div x-show="currentContainer.config.type === 'grid'" class="grid grid-cols-2 gap-6">
											<div class="form-control w-full">
												<label class="label pt-0"><span class="label-text font-bold text-sm mb-2">{ i18n.T(ctx, "Rows") }</span></label>
												<input type="number" x-model.number="currentContainer.config.rows" class="input input-bordered w-full input-md" min="1"/>
											</div>
											<div class="form-control w-full">
												<label class="label pt-0"><span class="label-text font-bold text-sm mb-2">{ i18n.T(ctx, "Cols") }</span></label>
												<input type="number" x-model.number="currentContainer.config.cols" class="input input-bordered w-full input-md" min="1"/>
											</div>
										</div>
										<!-- Compound -->
										<div x-show="currentContainer.config.type === 'compound'" class="space-y-6">
											<div class="flex items-center justify-between">
												<span class="text-sm font-bold opacity-50 uppercase tracking-widest">{ i18n.T(ctx, "Sections") }</span>
												<div class="tooltip tooltip-bottom md:tooltip-left before:text-xs before:max-w-[12rem] before:whitespace-normal z-50" data-tip={ i18n.T(ctx, "AddSection") }>
													<button type="button" @click="currentContainer.config.sections.push({rows:4,cols:4})" class="btn btn-md btn-outline btn-primary">
														@icons.Plus(templ.Attributes{"class": "w-5 h-5"})
														{ i18n.T(ctx, "AddSection") }
													</button>
												</div>
											</div>
											<div class="grid grid-cols-1 gap-3">
												<template x-for="(section, sIdx) in currentContainer.config.sections" :key="sIdx">
													<div class="flex items-center gap-4 bg-base-200 p-3 rounded-lg border border-base-300">
														<div class="w-8 h-8 rounded-full bg-base-300 flex items-center justify-center font-mono font-bold text-sm opacity-50" x-text="(sIdx+1)"></div>
														<div class="grid grid-cols-2 gap-4 flex-1">
															<div class="form-control">
																<input type="number" x-model.number="section.rows" class="input input-bordered w-full text-center font-bold input-md" placeholder={ i18n.T(ctx, "Rows") } min="1"/>
																<label class="label justify-center py-1"><span class="label-text-alt font-bold opacity-40 uppercase text-xs tracking-tighter">{ i18n.T(ctx, "Rows") }</span></label>
															</div>
															<div class="form-control">
																<input type="number" x-model.number="section.cols" class="input input-bordered w-full text-center font-bold input-md" placeholder={ i18n.T(ctx, "Cols") } min="1"/>
																<label class="label justify-center py-1"><span class="label-text-alt font-bold opacity-40 uppercase text-xs tracking-tighter">{ i18n.T(ctx, "Cols") }</span></label>
															</div>
														</div>
														<div class="tooltip tooltip-left before:text-xs z-50" data-tip="Remove this section.">
															<button type="button" @click="currentContainer.config.sections.splice(sIdx, 1)" class="btn btn-ghost btn-xs text-error btn-square hover:bg-error/10">
																@icons.X(templ.Attributes{"class": "w-4 h-4"})
															</button>
														</div>
													</div>
												</template>
											</div>
										</div>
									</div>
								</fieldset>
								<!-- LED Range Editor -->
								<div x-show="selectedCell !== null" class="bg-base-100 p-6 rounded-xl border border-secondary shadow-md" x-cloak>
									<div class="flex items-center justify-between mb-4">
										<h4 class="font-bold text-sm uppercase tracking-wider opacity-50">{ i18n.T(ctx, "LedRange") }</h4>
										<span class="badge badge-secondary badge-sm font-mono" x-text="selectedCellName"></span>
									</div>
									<p class="text-xs opacity-50 mb-4">{ i18n.T(ctx, "LedRangeHelp") }</p>
									<div class="grid grid-cols-2 gap-4">
										<div class="form-control w-full">
											<label class="label pt-0"><span class="label-text font-bold text-sm mb-2">{ i18n.T(ctx, "StartLed") }</span></label>
											<input type="number" x-model.number="selectedStartLed" min="1" class="input input-bordered w-full input-md"/>
										</div>
										<div class="form-control w-full">
											<label class="label pt-0"><span class="label-text font-bold text-sm mb-2">{ i18n.T(ctx, "EndLed") }</span></label>
											<input type="number" x-model.number="selectedEndLed" min="1" class="input input-bordered w-full input-md"/>
										</div>
									</div>
									<div class="flex items-center justify-between mt-4">
										<span class="text-xs opacity-50 font-mono" x-text="'LED ' + (selectedStartLed - 1) + '  width ' + (selectedEndLed - selectedStartLed + 1)"></span>
										<div class="flex gap-2">
											<button type="button" @click="closeCellEditor()" class="btn btn-sm btn-ghost">{ i18n.T(ctx, "Cancel") }</button>
											<button type="button" @click="unmapCell()" class="btn btn-sm btn-outline btn-error">{ i18n.T(ctx, "Remove") }</button>
											<button type="button" @click="applyCellRange()" class="btn btn-sm btn-primary">{ i18n.T(ctx, "Apply") }</button>
										</div>
									</div>
								</div>
								<!-- Tools -->
								<div class="bg-base-300/30 p-4 rounded-xl border border-base-300">
									<div class="flex flex-col sm:flex-row flex-wrap justify-center sm:justify-end gap-2">
										<div class="tooltip tooltip-top lg:tooltip-left w-full sm:w-auto before:text-xs before:max-w-[12rem] md:before:max-w-[16rem] before:whitespace-normal z-50" data-tip={ i18n.T(ctx, "AutoMapLinear") }>
											<button @click="autoFill('linear')" class="btn btn-md btn-success text-white gap-2 w-full whitespace-nowrap">
												{ i18n.T(ctx, "AutoMapLinear") }
											</button>
										</div>
										<div class="tooltip tooltip-top lg:tooltip-left w-full sm:w-auto before:text-xs before:max-w-[12rem] md:before:max-w-[16rem] before:whitespace-normal z-50" data-tip={ i18n.T(ctx, "AutoMapSnake") }>
											<button @click="autoFill('serpentine')" class="btn btn-md btn-success text-white gap-2 w-full whitespace-nowrap">
												{ i18n.T(ctx, "AutoMapSnake") }
											</button>
										</div>
										<div class="tooltip tooltip-top lg:tooltip-left w-full sm:w-auto before:text-xs before:max-w-[12rem] md:before:max-w-[16rem] before:whitespace-normal z-50" data-tip={ i18n.T(ctx, "ClearMapping") }>
											<button @click="askConfirm('clear')" class="btn btn-md btn-outline btn-error gap-2 w-full whitespace-nowrap">
												{ i18n.T(ctx, "ClearMapping") }
											</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		} else {
			<div class="alert alert-info shadow-sm mb-6">
				<span>{ i18n.T(ctx, "ReadOnlyMode") }</span>
			</div>
		}
		<div class="space-y-16 mt-8">
			<template x-for="(container, cIdx) in containers" :key="cIdx">
				<div class="card bg-base-200 border border-base-300 shadow-xl overflow-hidden">
					<div class="bg-base-300/50 px-6 py-4 border-b border-base-300 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
						<div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
							<h4 class="font-bold text-sm uppercase tracking-wider opacity-50" x-text="container.name"></h4>
							<span class="badge badge-sm badge-neutral font-mono text-xs whitespace-nowrap" x-text={ fmt.Sprintf("'%s ' + container.segment_id", i18n.T(ctx, "Segment")) }></span>
						</div>
						<div class="text-sm font-bold opacity-40 uppercase tracking-widest" x-text={ fmt.Sprintf("getContainerTotalLeds(cIdx) + ' %s'", i18n.T(ctx, "LedsTotal")) }></div>
					</div>
					<div class="card-body p-6 space-y-8">
						<template x-for="(section, secIdx) in getRenderSections(cIdx)" :key="secIdx">
							<div>
								<div x-show="container.config.type === 'compound'" class="mb-3 flex items-center gap-2">
									<span class="badge badge-sm badge-ghost font-bold text-xs uppercase tracking-widest opacity-60" x-text={ fmt.Sprintf("'%s ' + (secIdx + 1)", i18n.T(ctx, "Sections")) }></span>
									<span class="text-sm font-bold opacity-40 uppercase tracking-tighter" x-text="section.rows + '×' + section.cols"></span>
								</div>
								<div class="overflow-x-auto bg-base-100 rounded-xl border border-base-300 p-6 shadow-inner">
									<div
										class="grid gap-1.5 select-none mx-auto"
										:style="`grid-template-columns: repeat(${section.cols}, 2.5rem); width: fit-content;`"
									>
										<template x-for="i in (section.rows * section.cols)">
											<div
												class="aspect-square border border-base-300 rounded-md flex flex-col items-center justify-center text-xs transition-all duration-200 relative overflow-hidden shadow-sm"
												:class="[
													getCellClass(cIdx, getSectionBaseIndex(cIdx, secIdx) + i - 1), 
													isSelectedCell(cIdx, getSectionBaseIndex(cIdx, secIdx) + i - 1) ? 'ring-2 ring-secondary' : '',
													canEdit ? 'cursor-pointer hover:scale-110 hover:z-10 hover:shadow-md hover:border-base-content/50' : 'cursor-default'
												]"
												@click="onCellClick(cIdx, getSectionBaseIndex(cIdx, secIdx) + i - 1)"
											>
												<span x-text="getCellLedLabel(cIdx, getSectionBaseIndex(cIdx, secIdx) + i - 1)" class="font-black text-[9px] leading-tight"></span>
												<span x-show="getBinName(cIdx, getSectionBaseIndex(cIdx, secIdx) + i - 1)" x-text="getBinName(cIdx, getSectionBaseIndex(cIdx, secIdx) + i - 1)" class="text-[7px] font-bold opacity-70 truncate w-full text-center px-0.5 leading-tight"></span>
												<span x-show="getWidth(cIdx, getSectionBaseIndex(cIdx, secIdx) + i - 1) > 1" class="text-[7px] font-bold opacity-80 truncate w-full text-center px-0.5 leading-tight" x-text="'W' + getWidth(cIdx, getSectionBaseIndex(cIdx, secIdx) + i - 1)"></span>
											</div>
										</template>
									</div>
								</div>
							</div>
						</template>
					</div>
				</div>
			</template>
		</div>
		if canEdit {
			<form x-ref="gridForm" method="POST" action={ templ.SafeURL(fmt.Sprintf("/hardware/%d/grid", controller.ID)) } class="mt-16 bg-base-200 p-8 rounded-2xl border border-base-300 shadow-xl flex flex-col md:flex-row justify-between items-center gap-6">
				<div>
					<h3 class="font-bold text-sm uppercase tracking-wider opacity-50">{ i18n.T(ctx, "SaveConfiguration") }</h3>
					<p class="text-xs opacity-40 mt-1">{ i18n.T(ctx, "SaveConfigurationDesc") }</p>
				</div>
				<div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto md:justify-end">
					<a href="/hardware" class="btn btn-ghost w-full sm:w-32 whitespace-nowrap">{ i18n.T(ctx, "Cancel") }</a>
					<button type="button" @click="askConfirm('save')" class="btn btn-primary px-8 sm:px-12 w-full sm:w-auto md:w-48 whitespace-nowrap">{ i18n.T(ctx, "SaveChanges") }</button>
				</div>
				<input type="hidden" name="grid_data" :value="JSON.stringify(exportBinData())"/>
				<input type="hidden" name="config_data" :value="JSON.stringify(exportContainerData())"/>
			</form>
			@Modal(ModalProps{ID: "grid_painter_confirm_modal", Title: i18n.T(ctx, "AreYouSure")}) {
				<p x-text="confirmMessage" class="py-4 text-base-content/80"></p>
				<div class="modal-action">
					<form method="dialog">
						<button class="btn">{ i18n.T(ctx, "Cancel") }</button>
					</form>
					<button type="button" class="btn btn-error" @click="confirmAction()">
						{ i18n.T(ctx, "Confirm") }
					</button>
				</div>
			}
		}
	</div>
	<script src="/static/js/grid_painter.js"></script>
}
