package components

import (
	"fmt"
	"sort"
)

// DashboardBin represents a single cell on the dashboard
type DashboardBin struct {
	ID       int64    `json:"id"`
	Name     string   `json:"name"`
	GridX    int      `json:"grid_x"`
	GridY    int      `json:"grid_y"`
	Statuses []string `json:"statuses"` // "critical", "low", "ok", or empty
}

// DashboardController represents a controller and its grid of bins
type DashboardController struct {
	ID         int64                `json:"id"`
	Name       string               `json:"name"`
	Containers []DashboardContainer `json:"containers"`
}

// DashboardContainer represents a physical container displayed on a wall
type DashboardContainer struct {
	ID               int64          `json:"id"`
	Name             string         `json:"name"`
	SegmentID        int64          `json:"segment_id"`
	ControllerName   string         `json:"controller_name"`
	ControllerOnline bool           `json:"controller_online"`
	Bins             []DashboardBin `json:"bins"`
}

type DashboardWall struct {
	ID          int64                `json:"id"`
	Name        string               `json:"name"`
	Description string               `json:"description"`
	Containers  []DashboardContainer `json:"containers"`
}

// GetStatusKeys returns the unique, sorted statuses for this bin
func (b DashboardBin) GetStatusKeys() []string {
	unique := make(map[string]bool)
	for _, s := range b.Statuses {
		if s != "" {
			unique[s] = true
		}
	}
	var keys []string
	for k := range unique {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}

// GetClass returns standard Tailwind utility classes for single-color bins.
func (b DashboardBin) GetClass() string {
	keys := b.GetStatusKeys()

	// Empty Bin
	if len(keys) == 0 {
		return "bg-base-200"
	}

	// Single Status -> Use DaisyUI Utility Classes
	if len(keys) == 1 {
		switch keys[0] {
		case "critical":
			return "bg-error text-error-content"
		case "low":
			return "bg-warning text-warning-content"
		case "ok":
			return "bg-success text-success-content"
		}
	}

	// Multiple Statuses -> Handled by GetStyle()
	return ""
}

// GetStyle returns the gradient string for multi-status bins.
func (b DashboardBin) GetStyle() string {
	keys := b.GetStatusKeys()

	// Single colors are handled by classes, so we return grid position only
	if len(keys) <= 1 {
		return fmt.Sprintf("grid-column: %d; grid-row: %d;", b.GridX+1, b.GridY+1)
	}

	// Map for Gradients (DaisyUI 5 Standard Variables)
	colorMap := map[string]string{
		"critical": "var(--color-error)",
		"low":      "var(--color-warning)",
		"ok":       "var(--color-success)",
	}

	bgStyle := ""

	// Two Colors (Split Diagonal)
	if len(keys) == 2 {
		c1 := colorMap[keys[0]]
		c2 := colorMap[keys[1]]
		bgStyle = fmt.Sprintf("background: linear-gradient(135deg, %s 50%%, %s 50%%);", c1, c2)
	}

	// Three Colors (Pie Chart)
	if len(keys) >= 3 {
		c1 := colorMap[keys[0]]
		c2 := colorMap[keys[1]]
		c3 := colorMap[keys[2]]
		bgStyle = fmt.Sprintf("background: conic-gradient(%s 0deg 120deg, %s 120deg 240deg, %s 240deg 360deg);", c1, c2, c3)
	}

	return fmt.Sprintf("grid-column: %d; grid-row: %d; %s", b.GridX+1, b.GridY+1, bgStyle)
}

templ DashboardGrid(ctrl DashboardController) {
	if len(ctrl.Containers) == 0 {
		<div class="mb-8">
			<div class="flex items-center gap-2 mb-4">
				<h2 class="font-bold text-sm uppercase tracking-wider opacity-50">{ ctrl.Name }</h2>
				<div class="badge badge-sm badge-ghost">Empty</div>
			</div>
			<div class="text-center py-8 opacity-50 border border-dashed border-base-300 rounded-lg">
				<p class="text-sm">No containers configured.</p>
			</div>
		</div>
	} else {
		<div class="mb-8">
			<div class="flex items-center gap-2 mb-4">
				<h2 class="font-bold text-sm uppercase tracking-wider opacity-50">{ ctrl.Name }</h2>
				<div class="badge badge-sm badge-ghost">{ fmt.Sprintf("%d Containers", len(ctrl.Containers)) }</div>
			</div>
			<div class="card bg-base-200 shadow-xl border border-base-300 overflow-hidden">
				<div class="card-body p-6 gap-6">
					for _, container := range ctrl.Containers {
						<div class="flex flex-col gap-2">
							<div class="flex items-center justify-between px-1">
								<h3 class="font-bold text-xs uppercase tracking-wider opacity-60">{ container.Name }</h3>
								<div class="text-[10px] font-mono opacity-40">ID: { fmt.Sprintf("%d", container.ID) }</div>
							</div>
							<div class="overflow-x-auto bg-base-100 rounded-lg border border-base-300 p-4 shadow-sm">
								<div
									class="grid gap-1.5"
									style="width: fit-content; min-width: 100%;"
								>
									for _, bin := range container.Bins {
										<a
											href={ templ.SafeURL(fmt.Sprintf("/parts?bin=%d", bin.ID)) }
											class={ "w-12 h-12 rounded-md border border-base-200 flex items-center justify-center text-xs font-bold shadow-sm hover:scale-110 hover:shadow-md hover:z-10 hover:border-base-content/50 transition-all duration-200 cursor-pointer " + bin.GetClass() }
											style={ bin.GetStyle() }
											title={ bin.Name }
										>
											<span class="drop-shadow-md filter invert-0 grayscale-0 brightness-100">{ bin.Name }</span>
										</a>
									}
								</div>
							</div>
						</div>
					}
					<div class="flex gap-4 mt-2 text-[10px] font-bold uppercase tracking-wider justify-end opacity-50 pt-4 border-t border-base-content/5">
						<div class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-success"></div>OK</div>
						<div class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-warning"></div>Low</div>
						<div class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-error"></div>Critical</div>
						<div class="flex items-center gap-2"><div class="w-3 h-3 rounded-full bg-base-200 border border-base-300"></div>Empty</div>
					</div>
				</div>
			</div>
		</div>
	}
}
