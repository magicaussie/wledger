package layouts

templ Base(title string) {
    <!DOCTYPE html>
    <html lang="en" data-theme="dark">
        <head>
            <meta charset="UTF-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
            <title>{ title } | WLEDger</title>
            <link href="../static/css/output.css" rel="stylesheet"/>
            <script src="https://unpkg.com/htmx.org@2.0.4"></script>
            <script src="https://unpkg.com/alpinejs@3.14.8/dist/cdn.min.js" defer></script>
            <style id="dynamic-colors">
            :root {
                --color-locate: #0000FF;
                --color-stock-ok: #00FF00;
                --color-stock-low: #FFFF00;
                --color-stock-critical: #FF0000;
            }
            [x-cloak] { display: none !important; }
        </style>
        </head>
        <body class="h-screen w-screen overflow-hidden bg-base-100 text-base-content font-sans" x-data="{ mobileMenuOpen: false }">
            <div id="toast-container" class="toast toast-end z-[100]"></div>
            
            <div class="flex h-full w-full">
                <aside class="hidden md:flex w-64 flex-col bg-base-200 border-r border-base-300 h-full">
                    <a href="/" class="flex items-center gap-2 px-6 h-16 shrink-0 hover:opacity-80 transition-opacity">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                        <span class="text-xl font-bold">WLEDger</span>
                    </a>
                    
                    <nav class="flex-1 px-4 py-4 space-y-1 overflow-y-auto">
                        <div class="mb-4">
                            <input type="text" 
                                   placeholder="Quick Find (Cmd+K)" 
                                   class="input input-sm input-bordered w-full"
                                   @keydown.window.meta.k.prevent="$el.focus()"
                                   @keydown.window.ctrl.k.prevent="$el.focus()"
                                   hx-get="/parts" 
                                   name="q"
                                   hx-select="#parts-grid"
                                   hx-target="#main-content" 
                                   hx-push-url="/parts"
                            />
                        </div>
                        @NavLinks()
                    </nav>

                    <div class="p-4 border-t border-base-300 shrink-0 space-y-2">
                        @GlobalOffButton()
                        @LogoutButton()
                        @ThemeToggle()
                    </div>
                </aside>

                <div class="flex-1 flex flex-col min-w-0 h-full bg-base-100">
                    <header class="md:hidden flex items-center justify-between h-16 px-4 border-b border-base-300 bg-base-200 shrink-0">
                        <button @click="mobileMenuOpen = !mobileMenuOpen" type="button" class="btn btn-square btn-ghost text-base-content">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="inline-block w-6 h-6 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                        </button>
                        <a href="/" class="flex items-center gap-2 px-6 h-16 shrink-0 hover:opacity-80 transition-opacity">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            <span class="text-xl font-bold">WLEDger</span>
                        </a>
                        @ThemeToggle()
                    </header>
                    
                    <main id="main-content" class="flex-1 overflow-y-auto p-4 md:p-8">
                        { children... }
                    </main>
                </div>
            </div>

            <div class="relative z-50 md:hidden" role="dialog" aria-modal="true" x-show="mobileMenuOpen" x-cloak>
                <div class="fixed inset-0 bg-black/30 backdrop-blur-sm" x-show="mobileMenuOpen" @click="mobileMenuOpen = false"></div>
                <div class="fixed inset-0 flex z-50 pointer-events-none">
                    <div class="relative flex w-full max-w-xs flex-1 flex-col bg-base-200 pt-5 pb-4 h-full shadow-xl pointer-events-auto" x-show="mobileMenuOpen">
                        <div class="absolute top-0 right-0 -mr-12 pt-2">
                            <button @click="mobileMenuOpen = false" class="ml-1 flex h-10 w-10 items-center justify-center rounded-full focus:outline-none focus:ring-2 focus:ring-inset focus:ring-white">
                                <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path></svg>
                            </button>
                        </div>
                        
                        <a href="/" class="flex items-center gap-2 px-6 h-16 shrink-0 hover:opacity-80 transition-opacity">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                            <span class="text-xl font-bold">WLEDger</span>
                        </a>

                        <nav class="mt-5 flex-1 px-2 space-y-1" @click="mobileMenuOpen = false">
                            @NavLinks()
                            <div class="pt-4 mt-4 border-t border-base-300 space-y-2">
                                @GlobalOffButton()
                                @LogoutButton()
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </body>
    </html>
}

// REUSABLE COMPONENTS

templ GlobalOffButton() {
    <button hx-post="/hardware/off" 
            hx-swap="none"
            class="btn btn-outline btn-error btn-sm w-full gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        Turn Off All LEDs
    </button>
}

templ LogoutButton() {
    <form action="/logout" method="POST" class="w-full">
        <button type="submit" class="btn btn-ghost justify-start w-full normal-case text-base font-normal text-error hover:bg-error/10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
            Log Out
        </button>
    </form>
}

templ NavLinks() {
    <a href="/" class="btn btn-ghost justify-start w-full normal-case text-base font-normal">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
        Dashboard
    </a>
    <a href="/parts" class="btn btn-ghost justify-start w-full normal-case text-base font-normal">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
        Inventory
    </a>
    <a href="/hardware" class="btn btn-ghost justify-start w-full normal-case text-base font-normal" hx-boost="false">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path></svg>
        Hardware
    </a>
    <a href="/settings" class="btn btn-ghost justify-start w-full normal-case text-base font-normal">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
        Settings
    </a>
}

templ ThemeToggle() {
    <label class="swap swap-rotate btn btn-ghost btn-circle">
        <input type="checkbox" class="theme-controller" value="light"/>
        <svg class="swap-on fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"></path></svg>
        <svg class="swap-off fill-current w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"></path></svg>
    </label>
}