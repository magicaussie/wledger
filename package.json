    "test:fresh-install": "node web/tests/task064_fresh_install.browser.test.js",
    "test:inventory-lifecycle": "WLEDGER_TASK064_INVENTORY_ONLY=1 WLEDGER_TASK065_RESTORE=1 node web/tests/task064_fresh_install.browser.test.js",
